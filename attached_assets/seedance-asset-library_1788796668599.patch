+import { db, appCredentialsTable } from "@workspace/db";
+import { eq } from "drizzle-orm";
+import { boundedProviderFetch, errorDetail } from "../aiProviderFetch";
+import { encryptJson, decryptJson } from "../secretCrypto";
+import { signArkRequest, type ArkSigningCredentials } from "./signer";
+
+/**
+ * BytePlus ModelArk Asset Library client.
+ *
+ * WHY THIS EXISTS. Seedance 2.x runs anti-deepfake filtering on every raw
+ * reference image in a generation request; a photorealistic character sheet
+ * trips it and the task fails with
+ * `InputImageSensitiveContentDetected.PrivacyInformation` ("the input image
+ * may contain a real person"), whether or not the character is real. The
+ * sanctioned fix is the private *virtual portrait* asset library: an image is
+ * reviewed ONCE at upload, and from then on the generation request carries
+ * `asset://<id>` instead of the picture, which the model already trusts.
+ *
+ * The library is scoped to the ModelArk account that created it, so the asset
+ * ids here only work with this account's own inference credentials — an asset
+ * minted under a reseller's account is unusable with ours, and vice versa.
+ *
+ * Two prerequisites live outside this code and cannot be worked around from
+ * here: the account needs Advanced Creation Rights activated, and the first
+ * asset group requires an authorization letter signed in the ModelArk console.
+ * Both surface as an API error with a readable message, which is passed
+ * straight through to the admin screen.
+ */
+
+/** Gateway host for the top-level OpenAPI (Assets) service. */
+const DEFAULT_ASSETS_HOST = "open.byteplusapi.com";
+const DEFAULT_ASSETS_REGION = "ap-southeast-1";
+const ASSETS_SERVICE = "ark";
+const ASSETS_API_VERSION = "2024-01-01";
+
+/** One Assets call should never hang; the polling loop owns the long wait. */
+const ASSETS_FETCH_TIMEOUT_MS = 30_000;
+
+/** app_credentials row holding the Asset Library access key pair. */
+const ARK_ASSETS_CREDENTIAL_PROVIDER = "ark_assets";
+
+/**
+ * Asset preprocessing is quoted at roughly 13 seconds per image but queues,
+ * so the wait is generous — this runs off the request path in every caller.
+ */
+export const ASSET_ACTIVATION_TIMEOUT_MS = 5 * 60 * 1000;
+const ASSET_POLL_INTERVAL_MS = 3_000;
+
+/** Asset lifecycle as reported by GetAsset. */
+export type ArkAssetStatus = "Processing" | "Active" | "Failed";
+
+export class ArkAssetsNotConfiguredError extends Error {
+  constructor(
+    message = "The ModelArk Asset Library is not configured: save an access key pair in the admin dashboard, or set ARK_ACCESS_KEY_ID and ARK_SECRET_ACCESS_KEY.",
+  ) {
+    super(message);
+    this.name = "ArkAssetsNotConfiguredError";
+  }
+}
+
+export class ArkAssetsError extends Error {
+  constructor(
+    message: string,
+    public readonly status?: number,
+    /** Volcengine error code, e.g. "AccessDenied" — useful for admin triage. */
+    public readonly code?: string,
+  ) {
+    super(message);
+    this.name = "ArkAssetsError";
+  }
+}
+
+interface StoredArkAssetsKey {
+  accessKeyId: string;
+  secretAccessKey: string;
+}
+
+/** Persist (encrypted at rest) the access key pair a superadmin entered. */
+export async function setStoredArkAssetsKey(key: StoredArkAssetsKey): Promise<void> {
+  const encryptedCredentials = encryptJson(key satisfies StoredArkAssetsKey);
+  await db
+    .insert(appCredentialsTable)
+    .values({ provider: ARK_ASSETS_CREDENTIAL_PROVIDER, encryptedCredentials })
+    .onConflictDoUpdate({
+      target: appCredentialsTable.provider,
+      set: { encryptedCredentials, updatedAt: new Date() },
+    });
+}
+
+/** Remove the stored pair; the env secrets (if any) become the fallback. */
+export async function clearStoredArkAssetsKey(): Promise<void> {
+  await db
+    .delete(appCredentialsTable)
+    .where(eq(appCredentialsTable.provider, ARK_ASSETS_CREDENTIAL_PROVIDER));
+}
+
+async function storedArkAssetsKey(): Promise<StoredArkAssetsKey | null> {
+  const row = (
+    await db
+      .select()
+      .from(appCredentialsTable)
+      .where(eq(appCredentialsTable.provider, ARK_ASSETS_CREDENTIAL_PROVIDER))
+      .limit(1)
+  )[0];
+  if (!row) return null;
+  try {
+    const creds = decryptJson<StoredArkAssetsKey>(row.encryptedCredentials);
+    if (!creds.accessKeyId || !creds.secretAccessKey) return null;
+    return creds;
+  } catch {
+    return null;
+  }
+}
+
+/** DB-entered key pair wins; env secrets are the fallback. Null when neither. */
+export async function resolveArkAssetsCredentials(): Promise<ArkSigningCredentials | null> {
+  const region = process.env.ARK_ASSETS_REGION?.trim() || DEFAULT_ASSETS_REGION;
+  const stored = await storedArkAssetsKey();
+  if (stored) {
+    return { ...stored, region, service: ASSETS_SERVICE };
+  }
+  const accessKeyId = process.env.ARK_ACCESS_KEY_ID?.trim();
+  const secretAccessKey = process.env.ARK_SECRET_ACCESS_KEY?.trim();
+  if (!accessKeyId || !secretAccessKey) return null;
+  return { accessKeyId, secretAccessKey, region, service: ASSETS_SERVICE };
+}
+
+export type ArkAssetsKeySource = "database" | "env" | null;
+
+export async function getArkAssetsKeySource(): Promise<ArkAssetsKeySource> {
+  if (await storedArkAssetsKey()) return "database";
+  if (process.env.ARK_ACCESS_KEY_ID && process.env.ARK_SECRET_ACCESS_KEY) return "env";
+  return null;
+}
+
+export async function isArkAssetsConfigured(): Promise<boolean> {
+  return (await resolveArkAssetsCredentials()) !== null;
+}
+
+/**
+ * Volcengine top-level OpenAPI envelope. Success puts the payload in
+ * `Result`; failure reports it in `ResponseMetadata.Error` — often with HTTP
+ * 200, so the body has to be inspected either way.
+ */
+interface ArkOpenApiResponse<T> {
+  ResponseMetadata?: {
+    RequestId?: string;
+    Error?: { Code?: string; Message?: string };
+  };
+  Result?: T;
+}
+
+/** Signed POST to one OpenAPI action, with the envelope unwrapped. */
+async function callAssetsApi<T>(
+  action: string,
+  payload: Record<string, unknown>,
+  credentials: ArkSigningCredentials,
+): Promise<T> {
+  const host = process.env.ARK_ASSETS_HOST?.trim() || DEFAULT_ASSETS_HOST;
+  const signed = signArkRequest({
+    host,
+    action,
+    version: ASSETS_API_VERSION,
+    body: JSON.stringify(payload),
+    credentials,
+  });
+  const res = await boundedProviderFetch(
+    signed.url,
+    { method: "POST", headers: signed.headers, body: signed.body, redirect: "manual" },
+    ASSETS_FETCH_TIMEOUT_MS,
+    () => new ArkAssetsError(`ModelArk ${action} timed out.`),
+  );
+  if (!res.ok) {
+    throw new ArkAssetsError(
+      `ModelArk ${action} failed (${res.status}): ${await errorDetail(res)}`,
+      res.status,
+    );
+  }
+  const body = (await res.json().catch(() => null)) as ArkOpenApiResponse<T> | null;
+  if (!body) {
+    throw new ArkAssetsError(`ModelArk ${action} returned an unreadable response.`, res.status);
+  }
+  const error = body.ResponseMetadata?.Error;
+  if (error?.Code || error?.Message) {
+    throw new ArkAssetsError(
+      `ModelArk ${action} failed: ${error.Message ?? error.Code}`,
+      res.status,
+      error.Code,
+    );
+  }
+  // Some actions answer with a bare object rather than the envelope; both
+  // shapes carry the same fields, so fall back to the whole body.
+  return (body.Result ?? (body as unknown)) as T;
+}
+
+export interface ArkAssetGroup {
+  Id: string;
+}
+
+export interface ArkAsset {
+  Id: string;
+  GroupId?: string;
+  Status?: ArkAssetStatus;
+  AssetType?: string;
+  Name?: string;
+  URL?: string;
+}
+
+/**
+ * Create an asset group — one per character, so every image of that person
+ * (base reference plus each costume) lands in the same group. Grouping is
+ * what lets the model treat several stills as one identity.
+ *
+ * `GroupType` is left at its default (AIGC = virtual portrait). This client
+ * deliberately does not expose the real-human group type: that path requires
+ * the filmed person to complete liveness verification on their own Volcengine
+ * account, which cannot be driven from a server.
+ */
+export async function createAssetGroup(
+  args: { name: string; description?: string; projectName?: string },
+  credentials: ArkSigningCredentials,
+): Promise<string> {
+  const result = await callAssetsApi<ArkAssetGroup>(
+    "CreateAssetGroup",
+    {
+      Name: args.name,
+      Description: args.description ?? "",
+      ProjectName: args.projectName ?? "default",
+    },
+    credentials,
+  );
+  if (!result?.Id) {
+    throw new ArkAssetsError("ModelArk CreateAssetGroup returned no group id.");
+  }
+  return result.Id;
+}
+
+/**
+ * Upload one image into a group. The URL must be reachable by ModelArk, so
+ * callers pass a short-lived signed storage URL rather than an app path.
+ * Asynchronous: the returned id is not usable until GetAsset reports Active.
+ */
+export async function createAsset(
+  args: { groupId: string; url: string; name?: string; projectName?: string },
+  credentials: ArkSigningCredentials,
+): Promise<string> {
+  const result = await callAssetsApi<ArkAsset>(
+    "CreateAsset",
+    {
+      GroupId: args.groupId,
+      URL: args.url,
+      AssetType: "Image",
+      ...(args.name ? { Name: args.name } : {}),
+      ProjectName: args.projectName ?? "default",
+    },
+    credentials,
+  );
+  if (!result?.Id) {
+    throw new ArkAssetsError("ModelArk CreateAsset returned no asset id.");
+  }
+  return result.Id;
+}
+
+export async function getAsset(
+  args: { id: string; projectName?: string },
+  credentials: ArkSigningCredentials,
+): Promise<ArkAsset> {
+  return callAssetsApi<ArkAsset>(
+    "GetAsset",
+    { Id: args.id, ProjectName: args.projectName ?? "default" },
+    credentials,
+  );
+}
+
+export async function deleteAsset(
+  args: { id: string; projectName?: string },
+  credentials: ArkSigningCredentials,
+): Promise<void> {
+  await callAssetsApi<unknown>(
+    "DeleteAsset",
+    { Id: args.id, ProjectName: args.projectName ?? "default" },
+    credentials,
+  );
+}
+
+/** Test seam so the polling loop doesn't really sleep in unit tests. */
+export interface WaitForAssetOptions {
+  timeoutMs?: number;
+  pollIntervalMs?: number;
+  sleep?: (ms: number) => Promise<void>;
+  now?: () => number;
+}
+
+/**
+ * Poll one asset to a terminal state.
+ *
+ * Returns the last-seen status rather than throwing on `Failed`: a rejected
+ * asset is a normal, reportable outcome (the image looked like a real person,
+ * or broke a content rule), and the caller records it against the character
+ * so an admin can see why. Only transport-level problems throw.
+ */
+export async function waitForAssetActive(
+  id: string,
+  credentials: ArkSigningCredentials,
+  options: WaitForAssetOptions = {},
+): Promise<{ status: ArkAssetStatus; asset: ArkAsset }> {
+  const timeoutMs = options.timeoutMs ?? ASSET_ACTIVATION_TIMEOUT_MS;
+  const pollIntervalMs = options.pollIntervalMs ?? ASSET_POLL_INTERVAL_MS;
+  const sleep = options.sleep ?? ((ms: number) => new Promise((r) => setTimeout(r, ms)));
+  const now = options.now ?? (() => Date.now());
+  const deadline = now() + timeoutMs;
+
+  let asset = await getAsset({ id }, credentials);
+  while ((asset.Status ?? "Processing") === "Processing" && now() < deadline) {
+    await sleep(pollIntervalMs);
+    asset = await getAsset({ id }, credentials);
+  }
+  const status = asset.Status ?? "Processing";
+  return { status, asset };
+}
+
+export { assetUri } from "./uri";
diff --git a/artifacts/api-server/src/lib/ark/signer.test.ts b/artifacts/api-server/src/lib/ark/signer.test.ts
new file mode 100644
index 0000000..39c46c1
--- /dev/null
+++ b/artifacts/api-server/src/lib/ark/signer.test.ts
@@ -0,0 +1,135 @@
+import { describe, it, expect } from "vitest";
+import { createHash, createHmac } from "crypto";
+import { signArkRequest, formatArkDate, type ArkSigningCredentials } from "./signer";
+
+/**
+ * The signature is the whole contract with the Assets API: get one byte of the
+ * canonical request wrong and every call fails with an error that reads like a
+ * bad credential. These tests recompute the expected signature independently
+ * (rather than pinning a magic string) so a change to the canonicalisation
+ * shows up as a failure here instead of in production.
+ */
+
+const credentials: ArkSigningCredentials = {
+  accessKeyId: "AKLTtest",
+  secretAccessKey: "c2VjcmV0",
+  region: "ap-southeast-1",
+  service: "ark",
+};
+
+const now = new Date("2026-09-07T10:45:30.123Z");
+
+function expectedSignature(body: string, xDate: string): string {
+  const shortDate = xDate.slice(0, 8);
+  const payloadHash = createHash("sha256").update(body, "utf8").digest("hex");
+  const canonicalHeaders =
+    `content-type:application/json\n` +
+    `host:open.byteplusapi.com\n` +
+    `x-content-sha256:${payloadHash}\n` +
+    `x-date:${xDate}\n`;
+  const canonicalRequest = [
+    "POST",
+    "/",
+    "Action=CreateAsset&Version=2024-01-01",
+    canonicalHeaders,
+    "content-type;host;x-content-sha256;x-date",
+    payloadHash,
+  ].join("\n");
+  const scope = `${shortDate}/ap-southeast-1/ark/request`;
+  const stringToSign = [
+    "HMAC-SHA256",
+    xDate,
+    scope,
+    createHash("sha256").update(canonicalRequest, "utf8").digest("hex"),
+  ].join("\n");
+  const hmac = (key: Buffer | string, data: string) =>
+    createHmac("sha256", key).update(data, "utf8").digest();
+  const kDate = hmac(credentials.secretAccessKey, shortDate);
+  const kRegion = hmac(kDate, "ap-southeast-1");
+  const kService = hmac(kRegion, "ark");
+  const kSigning = hmac(kService, "request");
+  return createHmac("sha256", kSigning).update(stringToSign, "utf8").digest("hex");
+}
+
+describe("formatArkDate", () => {
+  it("emits the compact UTC basic format the gateway expects", () => {
+    expect(formatArkDate(now)).toBe("20260907T104530Z");
+  });
+});
+
+describe("signArkRequest", () => {
+  it("puts the action and version in the query string, not the body", () => {
+    const signed = signArkRequest({
+      host: "open.byteplusapi.com",
+      action: "CreateAsset",
+      version: "2024-01-01",
+      body: JSON.stringify({ GroupId: "group-1" }),
+      credentials,
+      now,
+    });
+    expect(signed.url).toBe(
+      "https://open.byteplusapi.com/?Action=CreateAsset&Version=2024-01-01",
+    );
+    expect(signed.body).toBe('{"GroupId":"group-1"}');
+  });
+
+  it("signs exactly the headers it sends", () => {
+    const body = JSON.stringify({ GroupId: "group-1", URL: "https://example.test/a.png" });
+    const signed = signArkRequest({
+      host: "open.byteplusapi.com",
+      action: "CreateAsset",
+      version: "2024-01-01",
+      body,
+      credentials,
+      now,
+    });
+    const xDate = signed.headers["X-Date"]!;
+    expect(xDate).toBe("20260907T104530Z");
+    expect(signed.headers["X-Content-Sha256"]).toBe(
+      createHash("sha256").update(body, "utf8").digest("hex"),
+    );
+    expect(signed.headers.Authorization).toBe(
+      `HMAC-SHA256 Credential=AKLTtest/20260907/ap-southeast-1/ark/request, ` +
+        `SignedHeaders=content-type;host;x-content-sha256;x-date, ` +
+        `Signature=${expectedSignature(body, xDate)}`,
+    );
+  });
+
+  it("derives the signing key from the raw secret, with a 'request' terminator", () => {
+    // Guards the two deliberate divergences from AWS SigV4. If either ever
+    // regresses to the AWS spelling the signature changes, and this fails.
+    const signed = signArkRequest({
+      host: "open.byteplusapi.com",
+      action: "CreateAsset",
+      version: "2024-01-01",
+      body: "{}",
+      credentials,
+      now,
+    });
+    expect(signed.headers.Authorization).toContain("/ark/request,");
+    expect(signed.headers.Authorization).not.toContain("aws4_request");
+    expect(signed.headers.Authorization).toContain(
+      `Signature=${expectedSignature("{}", "20260907T104530Z")}`,
+    );
+  });
+
+  it("produces a different signature for a different body", () => {
+    const one = signArkRequest({
+      host: "open.byteplusapi.com",
+      action: "CreateAsset",
+      version: "2024-01-01",
+      body: '{"a":1}',
+      credentials,
+      now,
+    });
+    const two = signArkRequest({
+      host: "open.byteplusapi.com",
+      action: "CreateAsset",
+      version: "2024-01-01",
+      body: '{"a":2}',
+      credentials,
+      now,
+    });
+    expect(one.headers.Authorization).not.toBe(two.headers.Authorization);
+  });
+});
diff --git a/artifacts/api-server/src/lib/ark/signer.ts b/artifacts/api-server/src/lib/ark/signer.ts
new file mode 100644
index 0000000..1e566f3
--- /dev/null
+++ b/artifacts/api-server/src/lib/ark/signer.ts
@@ -0,0 +1,153 @@
+import { createHash, createHmac } from "crypto";
+
+/**
+ * Volcengine/BytePlus V4 request signing (HMAC-SHA256).
+ *
+ * The Seedance *inference* APIs authenticate with a plain bearer token
+ * (ARK_API_KEY) — that is what providers/seedream.ts and providers/ark.ts
+ * use. The Asset Library, however, is a top-level OpenAPI service: it is
+ * addressed by `Action`/`Version` query parameters and authenticates with an
+ * Access Key pair (AK/SK) that has to be signed per request. That signing is
+ * the only reason this file exists.
+ *
+ * The scheme is AWS SigV4-shaped with two deliberate differences, both of
+ * which are easy to get subtly wrong:
+ *   - the signing key chain starts from the RAW secret key, with no "AWS4"
+ *     prefix;
+ *   - the terminator is the literal "request", not "aws4_request".
+ *
+ * Reference: BytePlus "Signature mechanism" / byteplus-go-sdk-v2.
+ */
+
+export interface ArkSigningCredentials {
+  accessKeyId: string;
+  secretAccessKey: string;
+  /** e.g. "ap-southeast-1". */
+  region: string;
+  /** Top-level OpenAPI service name; always "ark" for the Asset Library. */
+  service: string;
+}
+
+export interface ArkSignedRequest {
+  url: string;
+  headers: Record<string, string>;
+  body: string;
+}
+
+const ALGORITHM = "HMAC-SHA256";
+const TERMINATOR = "request";
+
+function sha256Hex(input: string): string {
+  return createHash("sha256").update(input, "utf8").digest("hex");
+}
+
+function hmac(key: Buffer | string, data: string): Buffer {
+  return createHmac("sha256", key).update(data, "utf8").digest();
+}
+
+/**
+ * RFC 3986 percent-encoding. `encodeURIComponent` leaves `!'()*` alone, and
+ * the gateway encodes them — a query value containing any of those would
+ * otherwise produce a canonical request that does not match the server's and
+ * fail with a signature mismatch that looks like a credential problem.
+ */
+function encodeRfc3986(value: string): string {
+  return encodeURIComponent(value).replace(
+    /[!'()*]/g,
+    (c) => `%${c.charCodeAt(0).toString(16).toUpperCase()}`,
+  );
+}
+
+/** "20260907T104530Z" — the X-Date format the gateway expects. */
+export function formatArkDate(date: Date): string {
+  return `${date.toISOString().replace(/[:-]|\.\d{3}/g, "").slice(0, 15)}Z`;
+}
+
+/** Query string in canonical form: keys sorted, both halves percent-encoded. */
+function canonicalQuery(params: Record<string, string>): string {
+  return Object.keys(params)
+    .sort()
+    .map((key) => `${encodeRfc3986(key)}=${encodeRfc3986(params[key]!)}`)
+    .join("&");
+}
+
+/**
+ * Sign one top-level OpenAPI call and return everything fetch() needs.
+ *
+ * `now` is injectable so the signature is reproducible in tests; production
+ * callers leave it unset.
+ */
+export function signArkRequest(args: {
+  /** Gateway host, e.g. "open.byteplusapi.com" (no scheme). */
+  host: string;
+  /** OpenAPI action, e.g. "CreateAsset". */
+  action: string;
+  /** API version, e.g. "2024-01-01". */
+  version: string;
+  /** Request body — already serialized. Pass "" for a body-less call. */
+  body: string;
+  credentials: ArkSigningCredentials;
+  now?: Date;
+}): ArkSignedRequest {
+  const { host, action, version, body, credentials } = args;
+  const now = args.now ?? new Date();
+  const xDate = formatArkDate(now);
+  const shortDate = xDate.slice(0, 8);
+  const payloadHash = sha256Hex(body);
+
+  // Only headers that are both stable and echoed verbatim by fetch() may be
+  // signed. `content-length` and `user-agent` are neither, so they are left
+  // out on purpose.
+  const headers: Record<string, string> = {
+    "Content-Type": "application/json",
+    Host: host,
+    "X-Content-Sha256": payloadHash,
+    "X-Date": xDate,
+  };
+  const signedHeaderNames = Object.keys(headers)
+    .map((name) => name.toLowerCase())
+    .sort();
+  const canonicalHeaders = signedHeaderNames
+    .map((name) => {
+      const original = Object.keys(headers).find((h) => h.toLowerCase() === name)!;
+      return `${name}:${headers[original]!.trim()}\n`;
+    })
+    .join("");
+  const signedHeaders = signedHeaderNames.join(";");
+
+  const query = canonicalQuery({ Action: action, Version: version });
+  const canonicalRequest = [
+    "POST",
+    "/",
+    query,
+    canonicalHeaders,
+    signedHeaders,
+    payloadHash,
+  ].join("\n");
+
+  const credentialScope = `${shortDate}/${credentials.region}/${credentials.service}/${TERMINATOR}`;
+  const stringToSign = [
+    ALGORITHM,
+    xDate,
+    credentialScope,
+    sha256Hex(canonicalRequest),
+  ].join("\n");
+
+  // Raw secret key — no "AWS4" prefix. See the file header.
+  const kDate = hmac(credentials.secretAccessKey, shortDate);
+  const kRegion = hmac(kDate, credentials.region);
+  const kService = hmac(kRegion, credentials.service);
+  const kSigning = hmac(kService, TERMINATOR);
+  const signature = createHmac("sha256", kSigning).update(stringToSign, "utf8").digest("hex");
+
+  return {
+    url: `https://${host}/?${query}`,
+    headers: {
+      ...headers,
+      Authorization:
+        `${ALGORITHM} Credential=${credentials.accessKeyId}/${credentialScope}, ` +
+        `SignedHeaders=${signedHeaders}, Signature=${signature}`,
+    },
+    body,
+  };
+}
