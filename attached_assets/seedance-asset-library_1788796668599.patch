+    await db
+      .update(characterOutfitsTable)
+      .set({ arkAssetId: "asset-coat", arkAssetStatus: "Active" })
+      .where(eq(characterOutfitsTable.id, outfits[1]!.id));
+    const coat = (
+      await db
