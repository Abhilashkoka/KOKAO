++/**
++ * Seedance on BytePlus ModelArk, direct.
++ *
++ * This provider exists for one capability the resold routes cannot offer:
++ * passing Asset Library ids. Reference images sent inline are screened for
++ * real people on every request, and photorealistic character sheets are
++ * rejected as possible real humans; an asset that has cleared review once is
++ * trusted from then on. `input.assetRefs` carries those ids — see
++ * lib/ark/assets.ts for how they are minted.
++ *
++ * Asset ids are scoped to the ModelArk account that created them, so the key
++ * used here must belong to the same account as the Asset Library credentials.
++ */
++
++/** Seedance 2.5 — the current flagship; both engines default to it. */
++export const ARK_T2V_MODEL = "dreamina-seedance-2-5-260628";
++export const ARK_I2V_MODEL = "dreamina-seedance-2-5-260628";
++
++const DEFAULT_ARK_BASE_URL = "https://ark.ap-southeast.bytepluses.com/api/v3";
++
++/** Seedance accepts 4–15s; anything outside is a 400. */
++const MIN_DURATION_SEC = 4;
++const MAX_DURATION_SEC = 15;
++
++/** Task states that mean "still working". */
++const PENDING_STATUSES = new Set(["queued", "running", "pending", "processing"]);
++
++/** Gap between polls of a task that is still queued or running. */
++const POLL_INTERVAL_MS = 5_000;
++
++interface ArkTaskCreated {
++  id?: string;
++  error?: { code?: string; message?: string };
++}
++
++interface ArkTask {
++  id?: string;
++  status?: string;
++  error?: { code?: string; message?: string };
++  content?: { video_url?: string };
++}
++
++interface ArkContentEntry {
++  type: "text" | "image_url";
++  text?: string;
++  image_url?: { url: string };
++  role?: string;
++}
++
++function arkBaseUrl(): string {
++  return (process.env.ARK_BASE_URL?.trim() || DEFAULT_ARK_BASE_URL).replace(/\/+$/, "");
++}
++
++function clampDuration(durationSec: number): number {
++  const wanted = Math.round(durationSec);
++  if (!Number.isFinite(wanted)) return MIN_DURATION_SEC;
++  return Math.min(MAX_DURATION_SEC, Math.max(MIN_DURATION_SEC, wanted));
++}
++
++/**
++ * Seedance addresses reference material positionally from the prompt —
++ * `@Image1` is the first image_url entry, `@Image2` the second — so the
++ * prompt has to name them or the references are decorative. One asset means
++ * one identity clause; several (a character plus per-costume stills) are
++ * named as the same person so the model treats the group as one subject.
++ */
++export function withAssetReferences(prompt: string, imageCount: number): string {
++  if (imageCount <= 0) return prompt;
++  const refs = Array.from({ length: imageCount }, (_, i) => `@Image${i + 1}`);
++  const clause =
++    refs.length === 1
++      ? `The subject is the person shown in ${refs[0]}; keep their face, hair, and body identical.`
