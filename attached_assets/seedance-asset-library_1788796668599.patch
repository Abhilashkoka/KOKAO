+import { describe, it, expect, vi, afterEach } from "vitest";
+import { generateWithArkVideo, withAssetReferences } from "./ark";
+import { VideoGenNotConfiguredError, VideoGenProviderError } from "../types";
+import type { VideoGenInput } from "../types";
+
+/**
+ * The provider talks to ModelArk through global fetch (via
+ * boundedProviderFetch), so tests stub fetch and assert the exact request
+ * body. The assertions that matter are about reference material: an asset id
+ * must go out as `asset://<id>` and never as an inline image, because the
+ * inline path is exactly what the real-person filter rejects.
+ */
+
+const baseInput: VideoGenInput = {
+  prompt: "A barista pulling an espresso shot",
+  aspectRatio: "9:16",
+  durationSec: 6,
+  model: "dreamina-seedance-2-5-260628",
+};
+
+function jsonResponse(body: unknown, status = 200): Response {
+  return {
+    ok: status >= 200 && status < 300,
+    status,
+    json: async () => body,
+    text: async () => JSON.stringify(body),
+    arrayBuffer: async () => new ArrayBuffer(0),
+  } as unknown as Response;
+}
+
+function videoResponse(bytes: Uint8Array): Response {
+  return {
+    ok: true,
+    status: 200,
+    arrayBuffer: async () => bytes.buffer,
+  } as unknown as Response;
+}
+
+/** The parsed JSON body of the Nth fetch call. */
+function requestBody(fetchSpy: ReturnType<typeof vi.fn>, call = 0): Record<string, unknown> {
+  return JSON.parse(fetchSpy.mock.calls[call]![1].body as string);
+}
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+describe("withAssetReferences", () => {
+  it("names a single asset positionally", () => {
+    expect(withAssetReferences("She walks in", 1)).toContain("@Image1");
+  });
+
+  it("names every asset and says they are the same person", () => {
+    const prompt = withAssetReferences("She walks in", 3);
+    expect(prompt).toContain("@Image1, @Image2 and @Image3");
+    expect(prompt).toContain("the same person in each");
+  });
+
+  it("leaves the prompt alone when there is nothing to reference", () => {
+    expect(withAssetReferences("She walks in", 0)).toBe("She walks in");
+  });
+});
+
+describe("generateWithArkVideo", () => {
+  it("throws NotConfigured without a key (never reaches the network)", async () => {
+    const fetchSpy = vi.fn();
+    vi.stubGlobal("fetch", fetchSpy);
+    await expect(generateWithArkVideo(baseInput, null)).rejects.toBeInstanceOf(
+      VideoGenNotConfiguredError,
+    );
+    expect(fetchSpy).not.toHaveBeenCalled();
+  });
+
+  it("sends asset ids as asset:// references and never inlines the image", async () => {
+    const clip = new Uint8Array([1, 2, 3, 4]);
+    const fetchSpy = vi
+      .fn()
+      .mockResolvedValueOnce(jsonResponse({ id: "cgt-1" }))
+      .mockResolvedValueOnce(
+        jsonResponse({
+          id: "cgt-1",
+          status: "succeeded",
+          content: { video_url: "https://videos.example/clip.mp4" },
+        }),
+      )
+      .mockResolvedValueOnce(videoResponse(clip));
+    vi.stubGlobal("fetch", fetchSpy);
+
+    const result = await generateWithArkVideo(
