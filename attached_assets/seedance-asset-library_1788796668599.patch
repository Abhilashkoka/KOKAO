+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { ArkAssetsCard } from "./ark-assets-card";
+
+type View = {
+  keySource: "database" | "env" | null;
+  characters: Array<{
+    id: number;
+    tenantId: number;
+    name: string;
+    assetGroupId: string | null;
+    outfits: Array<{
+      id: number;
+      name: string;
+      assetId: string | null;
+      status: string | null;
+      error: string | null;
+      syncedAt: string | null;
+    }>;
+  }>;
+};
+
+const mockState: { view: View; isLoading: boolean } = {
+  isLoading: false,
+  view: { keySource: null, characters: [] },
+};
+
+const registerMutate = vi.fn();
+const setKeyMutate = vi.fn();
+
+vi.mock("@workspace/api-client-react", async () => {
+  const { createApiClientMock } = await import("../../test/apiClientMock");
+  return createApiClientMock({
+    useAdminGetArkAssets: () => ({
+      data: mockState.isLoading ? undefined : mockState.view,
+      isLoading: mockState.isLoading,
+    }),
+    useAdminSetArkAssetsKey: () => ({ mutate: setKeyMutate, isPending: false }),
+    useAdminClearArkAssetsKey: () => ({ mutate: vi.fn(), isPending: false }),
+    useAdminRegisterArkCharacterAssets: () => ({ mutate: registerMutate, isPending: false }),
+  });
+});
+
+function renderCard() {
+  const client = new QueryClient();
+  return render(
+    <QueryClientProvider client={client}>
+      <ArkAssetsCard />
+    </QueryClientProvider>,
+  );
+}
+
+function outfit(overrides: Partial<View["characters"][number]["outfits"][number]> = {}) {
+  return {
+    id: 1,
+    name: "Default",
+    assetId: null,
+    status: null,
+    error: null,
+    syncedAt: null,
+    ...overrides,
+  };
+}
+
+beforeEach(() => {
+  mockState.isLoading = false;
+  mockState.view = { keySource: null, characters: [] };
+  registerMutate.mockReset();
+  setKeyMutate.mockReset();
+});
+
+describe("ArkAssetsCard", () => {
+  it("says registration is skipped while no credentials are configured", () => {
+    renderCard();
+    expect(screen.getByTestId("text-ark-key-source").textContent).toMatch(
+      /not configured/i,
+    );
+  });
+
+  it("distinguishes a saved key from the env fallback", () => {
+    mockState.view = { keySource: "env", characters: [] };
+    renderCard();
+    expect(screen.getByTestId("text-ark-key-source").textContent).toContain(
+      "ARK_ACCESS_KEY_ID",
+    );
+    // Only a key stored here can be removed from here.
+    expect(screen.queryByTestId("button-clear-ark-key")).toBeNull();
+  });
+
+  it("shows each outfit's registration state and the reason it failed", () => {
+    mockState.view = {
+      keySource: "database",
+      characters: [
+        {
+          id: 7,
+          tenantId: 3,
+          name: "Nila",
+          assetGroupId: "group-20260907-abcde",
+          outfits: [
+            outfit({ id: 11, name: "Default", assetId: "asset-1", status: "Active" }),
+            outfit({
+              id: 12,
+              name: "Raincoat",
+              status: "Failed",
+              error: "ModelArk rejected the image. It may read as a real person.",
+            }),
+          ],
+        },
+      ],
+    };
+    renderCard();
+    expect(screen.getByTestId("badge-ark-asset-active-11")).toBeTruthy();
+    expect(screen.getByTestId("badge-ark-asset-failed-12")).toBeTruthy();
+    // The upstream reason is the whole point of the row — an admin cannot act
+    // on "Failed" alone.
+    expect(screen.getByTestId("row-ark-outfit-12").textContent).toMatch(/real person/i);
+  });
+
+  it("marks an unregistered outfit rather than leaving the row blank", () => {
+    mockState.view = {
+      keySource: "database",
+      characters: [
+        {
+          id: 7,
+          tenantId: 3,
+          name: "Nila",
+          assetGroupId: null,
+          outfits: [outfit({ id: 11 })],
+        },
+      ],
+    };
+    renderCard();
+    expect(screen.getByTestId("badge-ark-asset-none-11")).toBeTruthy();
+    expect(screen.getByTestId("row-ark-character-7").textContent).toContain(
+      "No asset group",
+    );
+  });
+
+  it("retries registration for the character whose button was pressed", async () => {
+    mockState.view = {
+      keySource: "database",
+      characters: [
+        {
+          id: 7,
+          tenantId: 3,
+          name: "Nila",
+          assetGroupId: "group-1",
+          outfits: [outfit({ id: 11, status: "Failed", error: "quota exceeded" })],
+        },
+      ],
+    };
+    renderCard();
+    await userEvent.click(screen.getByTestId("button-ark-register-7"));
+    expect(registerMutate).toHaveBeenCalledWith(
+      { characterId: 7 },
+      expect.anything(),
+    );
+  });
+
+  it("refuses to submit a half-filled key pair", async () => {
+    renderCard();
+    await userEvent.type(screen.getByTestId("input-ark-access-key-id"), "AKLTtest");
+    await userEvent.click(screen.getByTestId("button-save-ark-key"));
+    expect(setKeyMutate).not.toHaveBeenCalled();
+  });
+});
diff --git a/artifacts/socialforge/src/pages/admin/ark-assets-card.tsx b/artifacts/socialforge/src/pages/admin/ark-assets-card.tsx
new file mode 100644
index 0000000..f134fcb
--- /dev/null
+++ b/artifacts/socialforge/src/pages/admin/ark-assets-card.tsx
@@ -0,0 +1,299 @@
+import { useState } from "react";
+import {
+  useAdminGetArkAssets,
+  useAdminSetArkAssetsKey,
+  useAdminClearArkAssetsKey,
+  useAdminRegisterArkCharacterAssets,
+  getAdminGetArkAssetsQueryKey,
+} from "@workspace/api-client-react";
+import type {
+  ArkAssetCharacterView,
+  ArkAssetOutfitView,
+} from "@workspace/api-client-react";
+import { useQueryClient } from "@tanstack/react-query";
+import { Button } from "@/components/ui/button";
+import {
+  Card,
+  CardContent,
+  CardHeader,
+  CardTitle,
+  CardDescription,
+} from "@/components/ui/card";
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import { Badge } from "@/components/ui/badge";
+import { Skeleton } from "@/components/ui/skeleton";
+import { useToast } from "@/hooks/use-toast";
+import { RippleSpinner } from "@/components/ui/ripple-spinner";
+import { apiErrorMessage } from "@/lib/apiErrorMessage";
+import { ShieldCheck } from "lucide-react";
+
+/**
+ * ModelArk Asset Library administration.
+ *
+ * Seedance screens every inline reference image for real people, and a
+ * photorealistic character sheet is rejected as a possible real person even
+ * when it is entirely AI-generated. Registering the sheet upstream once turns
+ * it into an asset id the model trusts. Registration runs automatically when
+ * a character or costume is created, but it is asynchronous and can fail for
+ * reasons only an admin can fix — Advanced Creation Rights not activated,
+ * asset quota exhausted, or a sheet that genuinely reads as a real human —
+ * so this card exists to show the verdict and offer a retry.
+ */
+
+function statusBadge(outfit: ArkAssetOutfitView) {
+  if (outfit.status === "Active") {
+    return (
+      <Badge variant="secondary" data-testid={`badge-ark-asset-active-${outfit.id}`}>
+        Active
+      </Badge>
+    );
+  }
+  if (outfit.status === "Failed") {
+    return (
+      <Badge variant="destructive" data-testid={`badge-ark-asset-failed-${outfit.id}`}>
+        Failed
+      </Badge>
+    );
+  }
+  if (outfit.status === "Processing") {
+    return (
+      <Badge variant="outline" data-testid={`badge-ark-asset-processing-${outfit.id}`}>
+        Processing
+      </Badge>
+    );
+  }
+  return (
+    <Badge variant="outline" data-testid={`badge-ark-asset-none-${outfit.id}`}>
+      Not registered
+    </Badge>
+  );
+}
+
+function CharacterRow({
+  character,
+  onRegister,
+  registering,
+}: {
+  character: ArkAssetCharacterView;
+  onRegister: (characterId: number) => void;
+  registering: boolean;
+}) {
+  return (
+    <div
+      className="space-y-2 rounded-md border px-3 py-2 text-sm"
+      data-testid={`row-ark-character-${character.id}`}
+    >
+      <div className="flex flex-wrap items-center gap-2">
+        <span className="font-medium">{character.name}</span>
+        <span className="font-mono text-xs text-muted-foreground">
+          tenant {character.tenantId}
+        </span>
+        {character.assetGroupId ? (
+          <span className="font-mono text-xs text-muted-foreground">
+            {character.assetGroupId}
+          </span>
+        ) : (
+          <Badge variant="outline">No asset group</Badge>
+        )}
+        <Button
+          size="sm"
+          variant="outline"
+          className="ml-auto"
+          disabled={registering}
+          onClick={() => onRegister(character.id)}
+          data-testid={`button-ark-register-${character.id}`}
+        >
+          {registering ? <RippleSpinner className="h-4 w-4" /> : "Register"}
+        </Button>
+      </div>
+      <div className="space-y-1">
+        {character.outfits.map((outfit) => (
+          <div
+            key={outfit.id}
+            className="flex flex-wrap items-center gap-2 text-xs"
+            data-testid={`row-ark-outfit-${outfit.id}`}
+          >
+            <span className="text-muted-foreground">{outfit.name}</span>
+            {statusBadge(outfit)}
+            {outfit.assetId && (
+              <span className="font-mono text-muted-foreground">{outfit.assetId}</span>
+            )}
+            {outfit.error && (
+              <span className="w-full font-mono break-all text-destructive">
+                {outfit.error}
+              </span>
+            )}
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+export function ArkAssetsCard() {
+  const { data, isLoading } = useAdminGetArkAssets();
+  const setKey = useAdminSetArkAssetsKey();
+  const clearKey = useAdminClearArkAssetsKey();
+  const register = useAdminRegisterArkCharacterAssets();
+  const queryClient = useQueryClient();
+  const { toast } = useToast();
+
+  const [accessKeyId, setAccessKeyId] = useState("");
+  const [secretAccessKey, setSecretAccessKey] = useState("");
+  const [registeringId, setRegisteringId] = useState<number | null>(null);
+
+  const invalidate = () =>
+    queryClient.invalidateQueries({ queryKey: getAdminGetArkAssetsQueryKey() });
+
+  const handleSaveKey = () => {
+    if (!accessKeyId.trim() || !secretAccessKey.trim()) {
+      toast({
+        title: "Both keys are required",
+        description: "The Asset Library needs an access key ID and a secret access key.",
+        variant: "destructive",
+      });
+      return;
+    }
+    setKey.mutate(
+      { data: { accessKeyId: accessKeyId.trim(), secretAccessKey: secretAccessKey.trim() } },
+      {
+        onSuccess: () => {
+          toast({ title: "Asset Library key saved" });
+          setAccessKeyId("");
+          setSecretAccessKey("");
+          void invalidate();
+        },
+        onError: (error) =>
+          toast({
+            title: "Could not save the key",
+            description: apiErrorMessage(error, "Could not save the Asset Library key."),
+            variant: "destructive",
+          }),
+      },
+    );
+  };
+
+  const handleClearKey = () => {
+    clearKey.mutate(undefined, {
+      onSuccess: () => {
+        toast({ title: "Asset Library key removed" });
+        void invalidate();
+      },
+      onError: (error) =>
+        toast({
+          title: "Could not remove the key",
+          description: apiErrorMessage(error, "Could not remove the Asset Library key."),
+          variant: "destructive",
+        }),
+    });
+  };
+
+  const handleRegister = (characterId: number) => {
+    setRegisteringId(characterId);
+    register.mutate(
+      { characterId },
+      {
+        onSuccess: () => {
+          toast({ title: "Registration finished" });
+          void invalidate();
+        },
+        onError: (error) =>
+          toast({
+            title: "Registration failed",
+            description: apiErrorMessage(error, "Registration failed. Check the ModelArk account and try again."),
+            variant: "destructive",
+          }),
+        onSettled: () => setRegisteringId(null),
+      },
+    );
+  };
+
+  return (
+    <Card data-testid="card-ark-assets">
+      <CardHeader>
+        <CardTitle className="flex items-center gap-2">
+          <ShieldCheck className="h-5 w-5 text-muted-foreground" />
+          ModelArk Asset Library
+        </CardTitle>
+        <CardDescription>
+          Character sheets have to be registered with ByteDance before Seedance
+          will accept them as references — an unregistered sheet is rejected as
+          a possible real person. Registration runs automatically on character
+          and costume creation; retry here when it fails.
+        </CardDescription>
+      </CardHeader>
+      <CardContent className="space-y-4">
+        <div className="flex flex-wrap items-end gap-3">
+          <div className="space-y-1">
+            <Label htmlFor="ark-access-key-id">Access key ID</Label>
+            <Input
+              id="ark-access-key-id"
+              value={accessKeyId}
+              onChange={(e) => setAccessKeyId(e.target.value)}
+              placeholder="AKLT..."
+              data-testid="input-ark-access-key-id"
+            />
+          </div>
+          <div className="space-y-1">
+            <Label htmlFor="ark-secret-access-key">Secret access key</Label>
+            <Input
+              id="ark-secret-access-key"
+              type="password"
+              value={secretAccessKey}
+              onChange={(e) => setSecretAccessKey(e.target.value)}
+              placeholder="••••••••"
+              data-testid="input-ark-secret-access-key"
+            />
+          </div>
+          <Button
+            onClick={handleSaveKey}
+            disabled={setKey.isPending}
+            data-testid="button-save-ark-key"
+          >
+            {setKey.isPending ? <RippleSpinner className="h-4 w-4" /> : "Save"}
+          </Button>
+          {data?.keySource === "database" && (
+            <Button
+              variant="outline"
+              onClick={handleClearKey}
+              disabled={clearKey.isPending}
+              data-testid="button-clear-ark-key"
+            >
+              Remove saved key
+            </Button>
+          )}
+          <span
+            className="text-xs text-muted-foreground"
+            data-testid="text-ark-key-source"
+          >
+            {data?.keySource === "database"
+              ? "Using the key saved here."
+              : data?.keySource === "env"
+                ? "Using ARK_ACCESS_KEY_ID / ARK_SECRET_ACCESS_KEY."
+                : "Not configured — registration is skipped."}
+          </span>
+        </div>
+
+        {isLoading || !data ? (
+          <Skeleton className="h-24 w-full" />
+        ) : data.characters.length === 0 ? (
+          <p className="text-sm text-muted-foreground" data-testid="text-ark-no-characters">
+            No characters have been created yet.
+          </p>
+        ) : (
+          <div className="space-y-2">
+            {data.characters.map((character) => (
+              <CharacterRow
+                key={character.id}
+                character={character}
+                onRegister={handleRegister}
+                registering={registeringId === character.id}
+              />
+            ))}
+          </div>
+        )}
+      </CardContent>
+    </Card>
+  );
