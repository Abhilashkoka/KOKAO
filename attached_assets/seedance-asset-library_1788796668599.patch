+/**
+ * The reference form the Seedance video API accepts in place of an image URL.
+ *
+ * Deliberately its own module: the video provider needs this one pure
+ * function, and importing it from ./assets would drag the database and the
+ * credential store into the provider's module graph for no reason.
+ */
+export function assetUri(assetId: string): string {
+  return `asset://${assetId}`;
+}
diff --git a/artifacts/api-server/src/lib/characterAssets.test.ts b/artifacts/api-server/src/lib/characterAssets.test.ts
new file mode 100644
index 0000000..17a9243
--- /dev/null
+++ b/artifacts/api-server/src/lib/characterAssets.test.ts
@@ -0,0 +1,361 @@
+import { describe, it, expect, vi, beforeEach, afterAll } from "vitest";
+
+// The Asset Library is a network service; here it is captured so this suite
+// exercises the orchestration — group reuse, status persistence, which ids a
+// generation gets — against the real database.
+const arkState = vi.hoisted(() => ({
+  configured: true,
+  createdGroups: [] as string[],
+  createdAssets: [] as { groupId: string; url: string; name?: string }[],
+  deletedAssets: [] as string[],
+  nextStatus: "Active" as "Active" | "Processing" | "Failed",
+  createAssetError: null as Error | null,
+  groupSeq: 0,
+  assetSeq: 0,
+}));
+
+vi.mock("./ark/assets", () => ({
+  resolveArkAssetsCredentials: vi.fn(async () =>
+    arkState.configured
+      ? {
+          accessKeyId: "AKLTtest",
+          secretAccessKey: "secret",
+          region: "ap-southeast-1",
+          service: "ark",
+        }
+      : null,
+  ),
+  createAssetGroup: vi.fn(async (args: { name: string }) => {
+    const id = `group-${++arkState.groupSeq}`;
+    arkState.createdGroups.push(args.name);
+    return id;
+  }),
+  createAsset: vi.fn(async (args: { groupId: string; url: string; name?: string }) => {
+    if (arkState.createAssetError) throw arkState.createAssetError;
+    arkState.createdAssets.push(args);
+    return `asset-${++arkState.assetSeq}`;
+  }),
+  deleteAsset: vi.fn(async (args: { id: string }) => {
+    arkState.deletedAssets.push(args.id);
+  }),
+  waitForAssetActive: vi.fn(async (id: string) => ({
+    status: arkState.nextStatus,
+    asset: { Id: id, Status: arkState.nextStatus },
+  })),
+}));
+
+// Signing a storage URL needs GCS; the value only has to be a URL ModelArk
+// could fetch, so it is stubbed rather than minted.
+vi.mock("./objectStorage", () => ({
+  ObjectStorageService: class {
+    async getSignedDownloadURL(objectPath: string) {
+      return `https://storage.example/signed${objectPath}`;
+    }
+  },
+  ObjectNotFoundError: class extends Error {},
+}));
+
+import { db, charactersTable, characterOutfitsTable } from "@workspace/db";
+import { eq } from "drizzle-orm";
+import { createTenant, deleteTenant, type TestTenant } from "../test/dbHelpers";
+import {
+  registerOutfitAsset,
+  registerCharacterAssets,
+  assetRefsForOutfit,
+} from "./characterAssets";
+import type { Character, CharacterOutfit } from "@workspace/db";
+
+const createdTenants: TestTenant[] = [];
+
+async function seedCharacter(
+  tenantId: number,
+  outfits: { name: string; isDefault: boolean; path?: string }[],
+): Promise<{ character: Character; outfits: CharacterOutfit[] }> {
+  const character = (
+    await db
+      .insert(charactersTable)
+      .values({
+        tenantId,
+        name: "Nila",
+        description: "a calm barista in her twenties",
+        referenceImagePath: `/objects/${tenantId}/uploads/base.png`,
+      })
+      .returning()
+  )[0]!;
+  const rows: CharacterOutfit[] = [];
+  for (const outfit of outfits) {
+    rows.push(
+      (
+        await db
+          .insert(characterOutfitsTable)
+          .values({
+            tenantId,
+            characterId: character.id,
+            name: outfit.name,
+            description: `${outfit.name} outfit`,
+            referenceImagePath: outfit.path ?? `/objects/${tenantId}/uploads/${outfit.name}.png`,
+            isDefault: outfit.isDefault,
+          })
+          .returning()
+      )[0]!,
+    );
+  }
+  return { character, outfits: rows };
+}
+
+async function newTenant(): Promise<TestTenant> {
+  const tenant = await createTenant();
+  createdTenants.push(tenant);
+  return tenant;
+}
+
+beforeEach(() => {
+  arkState.configured = true;
+  arkState.createdGroups.length = 0;
+  arkState.createdAssets.length = 0;
+  arkState.deletedAssets.length = 0;
+  arkState.nextStatus = "Active";
+  arkState.createAssetError = null;
+  arkState.groupSeq = 0;
+  arkState.assetSeq = 0;
+});
+
+afterAll(async () => {
+  for (const tenant of createdTenants) {
+    await db
+      .delete(characterOutfitsTable)
+      .where(eq(characterOutfitsTable.tenantId, tenant.tenantId));
+    await db.delete(charactersTable).where(eq(charactersTable.tenantId, tenant.tenantId));
+    await deleteTenant(tenant.tenantId);
+  }
+});
+
+describe("registerOutfitAsset", () => {
+  it("creates the group once and records the active asset on the outfit", async () => {
+    const tenant = await newTenant();
+    const { character, outfits } = await seedCharacter(tenant.tenantId, [
+      { name: "Default", isDefault: true },
+      { name: "Raincoat", isDefault: false },
+    ]);
+
+    const first = await registerOutfitAsset({
+      tenantId: tenant.tenantId,
+      character,
+      outfit: outfits[0]!,
+    });
+    expect(first.status).toBe("Active");
+    expect(first.assetId).toBe("asset-1");
+
+    // Reload so the second call sees the group the first one persisted.
+    const reloaded = (
+      await db.select().from(charactersTable).where(eq(charactersTable.id, character.id))
+    )[0]!;
+    await registerOutfitAsset({
+      tenantId: tenant.tenantId,
+      character: reloaded,
+      outfit: outfits[1]!,
+    });
+
+    // One group for the character, both costumes filed under it — that is
+    // what makes the model treat them as one identity.
+    expect(arkState.createdGroups).toHaveLength(1);
+    expect(arkState.createdAssets.map((a) => a.groupId)).toEqual(["group-1", "group-1"]);
+
+    const saved = await db
+      .select()
+      .from(characterOutfitsTable)
+      .where(eq(characterOutfitsTable.characterId, character.id));
+    expect(saved.every((o) => o.arkAssetStatus === "Active")).toBe(true);
+    expect(saved.every((o) => o.arkAssetSyncedAt !== null)).toBe(true);
+  });
+
+  it("hands ModelArk a fetchable URL, not an app path", async () => {
+    const tenant = await newTenant();
+    const { character, outfits } = await seedCharacter(tenant.tenantId, [
+      { name: "Default", isDefault: true },
+    ]);
+    await registerOutfitAsset({ tenantId: tenant.tenantId, character, outfit: outfits[0]! });
+    expect(arkState.createdAssets[0]!.url).toMatch(/^https:\/\/storage\.example\/signed/);
+  });
+
+  it("records a rejection with a readable reason instead of throwing", async () => {
+    const tenant = await newTenant();
+    const { character, outfits } = await seedCharacter(tenant.tenantId, [
+      { name: "Default", isDefault: true },
+    ]);
+    arkState.nextStatus = "Failed";
+
+    const result = await registerOutfitAsset({
+      tenantId: tenant.tenantId,
+      character,
+      outfit: outfits[0]!,
+    });
+    expect(result.status).toBe("Failed");
+    expect(result.error).toMatch(/real person/i);
+
+    const saved = (
+      await db
+        .select()
+        .from(characterOutfitsTable)
+        .where(eq(characterOutfitsTable.id, outfits[0]!.id))
+    )[0]!;
+    expect(saved.arkAssetStatus).toBe("Failed");
+    expect(saved.arkAssetError).toMatch(/real person/i);
+  });
+
+  it("records an upstream error on the outfit rather than propagating it", async () => {
+    const tenant = await newTenant();
+    const { character, outfits } = await seedCharacter(tenant.tenantId, [
+      { name: "Default", isDefault: true },
+    ]);
+    arkState.createAssetError = new Error("Advanced Creation Rights are not activated");
+
+    const result = await registerOutfitAsset({
+      tenantId: tenant.tenantId,
+      character,
+      outfit: outfits[0]!,
+    });
+    expect(result.status).toBe("Failed");
+    const saved = (
+      await db
+        .select()
+        .from(characterOutfitsTable)
+        .where(eq(characterOutfitsTable.id, outfits[0]!.id))
+    )[0]!;
+    expect(saved.arkAssetError).toContain("Advanced Creation Rights");
+  });
+
+  it("skips silently when no Asset Library credentials are configured", async () => {
+    const tenant = await newTenant();
+    const { character, outfits } = await seedCharacter(tenant.tenantId, [
+      { name: "Default", isDefault: true },
+    ]);
+    arkState.configured = false;
+
+    const result = await registerOutfitAsset({
+      tenantId: tenant.tenantId,
+      character,
+      outfit: outfits[0]!,
+    });
+    // Skipped, not failed: an unconfigured account is a deployment state, not
+    // an error to show against the character.
+    expect(result.status).toBe("Skipped");
+    expect(arkState.createdAssets).toHaveLength(0);
+    const saved = (
+      await db
+        .select()
+        .from(characterOutfitsTable)
+        .where(eq(characterOutfitsTable.id, outfits[0]!.id))
+    )[0]!;
+    expect(saved.arkAssetStatus).toBeNull();
+  });
+});
+
+describe("registerCharacterAssets", () => {
+  it("leaves outfits that are already active alone", async () => {
+    const tenant = await newTenant();
+    const { character, outfits } = await seedCharacter(tenant.tenantId, [
+      { name: "Default", isDefault: true },
+      { name: "Raincoat", isDefault: false },
+    ]);
+    await db
+      .update(characterOutfitsTable)
+      .set({ arkAssetId: "asset-existing", arkAssetStatus: "Active" })
+      .where(eq(characterOutfitsTable.id, outfits[0]!.id));
+
+    const results = await registerCharacterAssets({
+      tenantId: tenant.tenantId,
+      characterId: character.id,
+    });
+    expect(results).toHaveLength(1);
+    expect(results[0]!.outfitId).toBe(outfits[1]!.id);
+    expect(arkState.createdAssets).toHaveLength(1);
+  });
+
+  it("can be told to skip outfits whose last attempt failed", async () => {
+    const tenant = await newTenant();
+    const { character, outfits } = await seedCharacter(tenant.tenantId, [
+      { name: "Default", isDefault: true },
+    ]);
+    await db
+      .update(characterOutfitsTable)
+      .set({ arkAssetStatus: "Failed" })
+      .where(eq(characterOutfitsTable.id, outfits[0]!.id));
+
+    const results = await registerCharacterAssets({
+      tenantId: tenant.tenantId,
+      characterId: character.id,
+      includeFailed: false,
+    });
+    expect(results).toHaveLength(0);
+  });
+});
+
+describe("assetRefsForOutfit", () => {
+  it("returns nothing until the outfit's own asset is active", async () => {
+    const tenant = await newTenant();
+    const { character, outfits } = await seedCharacter(tenant.tenantId, [
+      { name: "Default", isDefault: true },
+    ]);
+    await db
+      .update(characterOutfitsTable)
+      .set({ arkAssetId: "asset-1", arkAssetStatus: "Processing" })
+      .where(eq(characterOutfitsTable.id, outfits[0]!.id));
+    const outfit = (
+      await db
+        .select()
+        .from(characterOutfitsTable)
+        .where(eq(characterOutfitsTable.id, outfits[0]!.id))
+    )[0]!;
+
+    // A Processing asset is not usable yet; returning it would fail the job.
+    expect(await assetRefsForOutfit({ tenantId: tenant.tenantId, character, outfit })).toEqual([]);
+  });
+
