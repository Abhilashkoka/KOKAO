diff --git a/artifacts/api-server/src/lib/characterAssets.ts b/artifacts/api-server/src/lib/characterAssets.ts
new file mode 100644
index 0000000..12db63d
--- /dev/null
+++ b/artifacts/api-server/src/lib/characterAssets.ts
@@ -0,0 +1,301 @@
+import { db, charactersTable, characterOutfitsTable } from "@workspace/db";
+import type { Character, CharacterOutfit } from "@workspace/db";
+import { and, eq } from "drizzle-orm";
+import { logger } from "./logger";
+import { ObjectStorageService } from "./objectStorage";
+import {
+  createAsset,
+  createAssetGroup,
+  deleteAsset,
+  resolveArkAssetsCredentials,
+  waitForAssetActive,
+  type ArkAssetStatus,
+} from "./ark/assets";
+import type { ArkSigningCredentials } from "./ark/signer";
+
+/**
+ * Registering characters in the ModelArk Asset Library.
+ *
+ * A character sheet sent inline is screened for real people on every
+ * generation; a photorealistic one is rejected as a possible real person even
+ * when it is entirely AI-generated. Registering the image once turns it into
+ * an asset id the model already trusts, and every later scene references the
+ * id instead of the picture.
+ *
+ * Registration is deliberately best-effort and off the critical path: it is
+ * an optimisation for one provider, so a character must still be creatable
+ * (and usable, via the keyframe path) when ModelArk is unconfigured, slow, or
+ * rejects the image. Every failure is recorded on the outfit row so the admin
+ * screen can show what happened, and nothing here throws into a request.
+ */
+
+const objectStorageService = new ObjectStorageService();
+
+/**
+ * How long the signed image URL handed to ModelArk stays valid. Preprocessing
+ * is asynchronous and queues, so this outlives the poll window by a wide
+ * margin — an expired URL would fail the asset, not just delay it.
+ */
+const ASSET_SOURCE_URL_TTL_SEC = 3600;
+
+export interface OutfitAssetRegistration {
+  outfitId: number;
+  assetId: string | null;
+  status: ArkAssetStatus | "Skipped";
+  error: string | null;
+}
+
+/** Persist whatever the last registration attempt learned about one outfit. */
+async function recordOutfitAsset(
+  outfitId: number,
+  values: { assetId?: string | null; status: string | null; error: string | null },
+): Promise<void> {
+  await db
+    .update(characterOutfitsTable)
+    .set({
+      ...(values.assetId !== undefined ? { arkAssetId: values.assetId } : {}),
+      arkAssetStatus: values.status,
+      arkAssetError: values.error ? values.error.slice(0, 500) : null,
+      arkAssetSyncedAt: new Date(),
+    })
+    .where(eq(characterOutfitsTable.id, outfitId));
+}
+
+/**
+ * The character's asset group, created on first use.
+ *
+ * The character row is locked for the check-and-create so two outfits added
+ * at the same time cannot each create a group and strand one of them — a
+ * stranded group is invisible from the app but still counts against the
+ * account's asset quota.
+ */
+async function ensureAssetGroup(
+  character: Character,
+  credentials: ArkSigningCredentials,
+): Promise<string> {
+  const existing = await db.transaction(async (tx) => {
+    const locked = (
+      await tx
+        .select()
+        .from(charactersTable)
+        .where(eq(charactersTable.id, character.id))
+        .for("update")
+        .limit(1)
+    )[0];
+    return locked?.arkAssetGroupId ?? null;
+  });
+  if (existing) return existing;
+
+  const groupId = await createAssetGroup(
+    {
+      name: `kokao-character-${character.id}`,
+      description: character.description || character.name,
+    },
+    credentials,
+  );
+  // Re-check under the lock: another writer may have won the race while the
+  // API call was in flight. Keep the stored one and let ours be orphaned
+  // rather than overwriting an id that assets are already filed under.
+  return db.transaction(async (tx) => {
+    const locked = (
+      await tx
+        .select()
+        .from(charactersTable)
+        .where(eq(charactersTable.id, character.id))
+        .for("update")
+        .limit(1)
+    )[0];
+    if (locked?.arkAssetGroupId) return locked.arkAssetGroupId;
+    await tx
+      .update(charactersTable)
+      .set({ arkAssetGroupId: groupId })
+      .where(eq(charactersTable.id, character.id));
+    return groupId;
+  });
+}
+
+/**
+ * Register one outfit's reference image and wait for it to become usable.
+ *
+ * Returns the outcome rather than throwing: a `Failed` asset (the image read
+ * as a real person, or broke a content rule) is a reportable result, not an
+ * exception, and the caller has no different action to take for either.
+ */
+export async function registerOutfitAsset(params: {
+  tenantId: number;
+  character: Character;
+  outfit: CharacterOutfit;
+}): Promise<OutfitAssetRegistration> {
+  const { tenantId, character, outfit } = params;
+  const credentials = await resolveArkAssetsCredentials();
+  if (!credentials) {
+    return { outfitId: outfit.id, assetId: null, status: "Skipped", error: null };
+  }
+
+  try {
+    const groupId = await ensureAssetGroup(character, credentials);
+    const sourceUrl = await objectStorageService.getSignedDownloadURL(
+      outfit.referenceImagePath,
+      tenantId,
+      ASSET_SOURCE_URL_TTL_SEC,
+    );
+    const assetId = await createAsset(
+      { groupId, url: sourceUrl, name: `${character.name} — ${outfit.name}` },
+      credentials,
+    );
+    await recordOutfitAsset(outfit.id, { assetId, status: "Processing", error: null });
+
+    const { status, asset } = await waitForAssetActive(assetId, credentials);
+    const error =
+      status === "Active"
+        ? null
+        : status === "Failed"
+          ? "ModelArk rejected the image. It may read as a real person, or breach a content rule."
+          : "Still preprocessing at ModelArk; it may become active shortly.";
+    await recordOutfitAsset(outfit.id, { assetId: asset.Id ?? assetId, status, error });
+    return { outfitId: outfit.id, assetId: asset.Id ?? assetId, status, error };
+  } catch (err) {
+    const message = err instanceof Error ? err.message : String(err);
+    await recordOutfitAsset(outfit.id, { status: "Failed", error: message }).catch(() => {});
+    return { outfitId: outfit.id, assetId: null, status: "Failed", error: message };
+  }
+}
+
+/**
+ * Fire-and-forget registration for the request path.
+ *
+ * Creating a character already costs an image generation and a storage
+ * upload; making the user also wait out ModelArk's review queue would be a
+ * poor trade for a benefit they only see on their first video. The response
+ * returns immediately and the asset lands a minute or so later.
+ */
+export function registerOutfitAssetInBackground(params: {
+  tenantId: number;
+  character: Character;
+  outfit: CharacterOutfit;
+}): void {
+  void registerOutfitAsset(params)
+    .then((result) => {
+      if (result.status === "Active" || result.status === "Skipped") return;
+      logger.warn(
+        { characterId: params.character.id, outfitId: params.outfit.id, result },
+        "ModelArk asset registration did not reach Active",
+      );
+    })
+    .catch((err) => {
+      logger.error(
+        { err, characterId: params.character.id, outfitId: params.outfit.id },
+        "ModelArk asset registration threw",
+      );
+    });
+}
+
+/**
+ * Release the ModelArk assets behind outfits the tenant just deleted.
+ *
+ * Asset capacity is a purchased, shared quota, so a character deleted in the
+ * app must not keep occupying a slot upstream. Fire-and-forget and
+ * best-effort: the rows are already gone, and a leaked asset is a quota
+ * nuisance rather than a correctness problem.
+ */
+export function deleteOutfitAssetsInBackground(assetIds: readonly (string | null)[]): void {
+  const ids = assetIds.filter((id): id is string => Boolean(id));
+  if (ids.length === 0) return;
+  void (async () => {
+    const credentials = await resolveArkAssetsCredentials();
+    if (!credentials) return;
+    for (const id of ids) {
+      await deleteAsset({ id }, credentials).catch((err) =>
+        logger.warn({ err, assetId: id }, "Failed to delete ModelArk asset"),
+      );
+    }
+  })();
+}
+
+/** Register every outfit of one character that has no usable asset yet. */
+export async function registerCharacterAssets(params: {
+  tenantId: number;
+  characterId: number;
+  /** Re-register outfits whose last attempt failed (default true). */
+  includeFailed?: boolean;
+}): Promise<OutfitAssetRegistration[]> {
+  const character = (
+    await db
+      .select()
+      .from(charactersTable)
+      .where(
+        and(
+          eq(charactersTable.id, params.characterId),
+          eq(charactersTable.tenantId, params.tenantId),
+        ),
+      )
+      .limit(1)
+  )[0];
+  if (!character) return [];
+
+  const outfits = await db
+    .select()
+    .from(characterOutfitsTable)
+    .where(
+      and(
+        eq(characterOutfitsTable.characterId, character.id),
+        eq(characterOutfitsTable.tenantId, params.tenantId),
+      ),
+    );
+
+  const includeFailed = params.includeFailed ?? true;
+  const pending = outfits.filter((outfit) => {
+    if (outfit.arkAssetStatus === "Active") return false;
+    if (!includeFailed && outfit.arkAssetStatus === "Failed") return false;
+    return true;
+  });
+
+  const results: OutfitAssetRegistration[] = [];
+  // Sequential on purpose: CreateAsset is rate-limited per account, and the
+  // first call is also what creates the shared group.
+  for (const outfit of pending) {
+    results.push(await registerOutfitAsset({ tenantId: params.tenantId, character, outfit }));
+  }
+  return results;
+}
+
+/**
+ * The asset ids to send with a generation for one locked outfit — the outfit's
+ * own asset, plus the character's base reference when that is a different
+ * image. More stills of the same identity give the model more to hold on to.
+ */
+export async function assetRefsForOutfit(params: {
+  tenantId: number;
+  character: Character;
+  outfit: CharacterOutfit;
+}): Promise<string[]> {
+  const refs: string[] = [];
+  if (params.outfit.arkAssetStatus === "Active" && params.outfit.arkAssetId) {
+    refs.push(params.outfit.arkAssetId);
+  }
+  if (refs.length === 0) return refs;
+
+  const base = (
+    await db
+      .select()
+      .from(characterOutfitsTable)
+      .where(
+        and(
+          eq(characterOutfitsTable.characterId, params.character.id),
+          eq(characterOutfitsTable.tenantId, params.tenantId),
+          eq(characterOutfitsTable.isDefault, true),
+        ),
+      )
+      .limit(1)
+  )[0];
+  if (
+    base &&
+    base.id !== params.outfit.id &&
+    base.arkAssetStatus === "Active" &&
+    base.arkAssetId &&
+    base.referenceImagePath !== params.outfit.referenceImagePath
+  ) {
+    refs.push(base.arkAssetId);
+  }
+  return refs;
+}
