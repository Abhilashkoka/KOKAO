diff --git a/artifacts/api-server/src/scripts/backfillArkAssets.ts b/artifacts/api-server/src/scripts/backfillArkAssets.ts
new file mode 100644
index 0000000..48cd844
--- /dev/null
+++ b/artifacts/api-server/src/scripts/backfillArkAssets.ts
@@ -0,0 +1,107 @@
+import { db, charactersTable } from "@workspace/db";
+import { asc, eq } from "drizzle-orm";
+import { registerCharacterAssets } from "../lib/characterAssets";
+import { isArkAssetsConfigured } from "../lib/ark/assets";
+
+/**
+ * Backfill: register characters that already existed before the Asset Library
+ * path shipped.
+ *
+ * Characters created from now on register themselves at creation. Everything
+ * created earlier has no asset id, so on the ModelArk route those tenants
+ * would keep hitting the real-person rejection until someone registers them.
+ * This walks the table once and does that.
+ *
+ * Usage (after `pnpm run build`):
+ *   node dist/scripts/backfillArkAssets.mjs [--tenant <id>] [--dry-run] [--include-failed]
+ *
+ * Safe to re-run: outfits that already hold an Active asset are skipped, so a
+ * second pass only picks up what the first one missed.
+ */
+
+interface Options {
+  tenantId: number | null;
+  dryRun: boolean;
+  includeFailed: boolean;
+}
+
+function parseArgs(argv: string[]): Options {
+  const options: Options = { tenantId: null, dryRun: false, includeFailed: true };
+  for (let i = 0; i < argv.length; i++) {
+    const arg = argv[i];
+    if (arg === "--dry-run") options.dryRun = true;
+    else if (arg === "--skip-failed") options.includeFailed = false;
+    else if (arg === "--tenant") {
+      const value = Number(argv[++i]);
+      if (!Number.isInteger(value) || value <= 0) {
+        throw new Error("--tenant needs a positive integer id");
+      }
+      options.tenantId = value;
+    }
+  }
+  return options;
+}
+
+async function main(): Promise<void> {
+  const options = parseArgs(process.argv.slice(2));
+
+  if (!(await isArkAssetsConfigured())) {
+    console.error(
+      "The ModelArk Asset Library is not configured. Save an access key pair in the admin dashboard, or set ARK_ACCESS_KEY_ID and ARK_SECRET_ACCESS_KEY.",
+    );
+    process.exitCode = 1;
+    return;
+  }
+
+  const characters = await db
+    .select({ id: charactersTable.id, tenantId: charactersTable.tenantId, name: charactersTable.name })
+    .from(charactersTable)
+    .where(options.tenantId === null ? undefined : eq(charactersTable.tenantId, options.tenantId))
+    .orderBy(asc(charactersTable.id));
+
+  console.log(`Found ${characters.length} character(s) to consider.`);
+  if (options.dryRun) {
+    for (const character of characters) {
+      console.log(`  would register: #${character.id} ${character.name} (tenant ${character.tenantId})`);
+    }
+    return;
+  }
+
+  let active = 0;
+  let failed = 0;
+  let skipped = 0;
+  // Sequential: CreateAsset is rate-limited per account, and a burst here
+  // would compete with live character creation for the same quota.
+  for (const character of characters) {
+    const results = await registerCharacterAssets({
+      tenantId: character.tenantId,
+      characterId: character.id,
+      includeFailed: options.includeFailed,
+    });
+    if (results.length === 0) {
+      console.log(`#${character.id} ${character.name}: nothing to do`);
+      continue;
+    }
+    for (const result of results) {
+      if (result.status === "Active") active++;
+      else if (result.status === "Skipped") skipped++;
+      else failed++;
+      console.log(
+        `#${character.id} ${character.name} outfit ${result.outfitId}: ${result.status}` +
+          (result.error ? ` — ${result.error}` : ""),
+      );
+    }
+  }
+  console.log(`Done. active=${active} failed=${failed} skipped=${skipped}`);
+  if (failed > 0) process.exitCode = 1;
+}
+
+main()
+  .catch((err) => {
+    console.error(err);
+    process.exitCode = 1;
+  })
+  .finally(() => {
+    // The pg pool keeps the event loop alive; nothing else runs after this.
+    process.exit(process.exitCode ?? 0);
+  });
