+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+
+import type OpenAI from "openai";
+
+import { parseModelJsonObject } from "../modelJson";
+import { encodeBudgetMs, findFontFile, probeDurationSec, runFfmpeg } from "./slideshow";
+import { splitIntoSentences } from "./topicVideo/narration";
+import { ASPECT_DIMENSIONS, VideoGenProviderError, type VideoAspect } from "./types";
+import { SCREEN_DEMO_MAX_SECONDS } from "./videoTemplates";
+
+/**
+ * App Walkthrough ("screen demo") building blocks.
+ *
+ * The format is a hybrid character story whose body is the tenant's own
+ * screen recording instead of AI animation:
+ *
+ *   character intro (lip-synced) → recording under voiceover → character
+ *   closing (lip-synced) → animated brand end card
+ *
+ * One TTS track voices the whole script, so the character and the voiceover
+ * are always the same voice. Only the two character beats call a provider;
+ * everything in this module is local text shaping or ffmpeg.
+ */
+
+const execFileAsync = promisify(execFile);
+
+export const SCREEN_DEMO_MIN_SECONDS = 5;
+/** Intro/closing must stay ONE narration cue, and cues split above 90 chars. */
+export const SCREEN_DEMO_SPOKEN_LINE_MAX_CHARS = 85;
+/** Comfortable explainer pace (~145 wpm). */
+const WORDS_PER_SECOND = 2.4;
+/** Leave breathing room so the voiceover finishes before the footage does. */
+const DEMO_FILL_RATIO = 0.85;
+const FPS = 30;
+/** narration.splitIntoSentences merges fragments shorter than 10 chars. */
+const MIN_CUE_CHARS = 12;
+
+export class ScreenDemoInputError extends Error {}
+
+/* ------------------------------------------------------------------------- *
+ * Recording intake
+ * ------------------------------------------------------------------------- */
+
+export async function probeScreenRecording(recording: Buffer): Promise<{ durationSec: number }> {
+  const dir = await mkdtemp(join(tmpdir(), "kokao-screen-probe-"));
+  try {
+    await writeFile(join(dir, "rec"), recording);
+    const durationSec = await probeDurationSec("rec", dir);
+    if (durationSec === null || !Number.isFinite(durationSec)) {
+      throw new ScreenDemoInputError("We could not read that screen recording. Upload an MP4, MOV or WebM file.");
+    }
+    if (durationSec < SCREEN_DEMO_MIN_SECONDS) {
+      throw new ScreenDemoInputError(
+        `The screen recording must be at least ${SCREEN_DEMO_MIN_SECONDS} seconds long.`,
+      );
+    }
+    if (durationSec > SCREEN_DEMO_MAX_SECONDS) {
+      throw new ScreenDemoInputError("Screen recordings can be up to 10 minutes long.");
+    }
+    return { durationSec: Math.round(durationSec * 100) / 100 };
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+}
+
+/**
+ * The screen_demo beat bound written into the job's pattern at enqueue: the
+ * voiceover may run a little past the footage (the last frame holds), but a
+ * script far longer than the recording is refused rather than frozen on one
+ * frame for a minute.
+ */
+export function screenDemoBeatMaxSeconds(recordingDurationSec: number): number {
+  return Math.min(SCREEN_DEMO_MAX_SECONDS, Math.ceil(recordingDurationSec * 1.5 + 10));
+}
+
+/** Evenly spaced stills for the script writer (skips the very first/last frame). */
+export async function extractDemoFrames(recording: Buffer, count = 6): Promise<Buffer[]> {
+  const dir = await mkdtemp(join(tmpdir(), "kokao-screen-frames-"));
+  try {
+    await writeFile(join(dir, "rec"), recording);
+    const durationSec = (await probeDurationSec("rec", dir)) ?? 0;
+    if (durationSec <= 0) return [];
+    const frames: Buffer[] = [];
+    for (let i = 0; i < count; i++) {
+      const at = (durationSec * (i + 0.5)) / count;
+      const name = `f${i}.jpg`;
+      try {
+        await runFfmpeg(
+          ["-y", "-ss", at.toFixed(3), "-i", "rec", "-frames:v", "1", "-vf", "scale=768:-2", "-q:v", "4", name],
+          dir,
+          60_000,
+        );
+        frames.push(await readFile(join(dir, name)));
+      } catch {
+        // A frame that will not decode just means one fewer hint.
+      }
+    }
+    return frames;
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+}
+
+/* ------------------------------------------------------------------------- *
+ * Script
+ * ------------------------------------------------------------------------- */
+
+export interface ScreenDemoScript {
+  intro: string;
+  steps: string[];
+  closing: string;
+}
+
+export function demoWordBudget(recordingDurationSec: number): number {
+  return Math.max(12, Math.floor(recordingDurationSec * WORDS_PER_SECOND * DEMO_FILL_RATIO));
+}
+
+function wordCount(text: string): number {
+  return text.trim().split(/\s+/u).filter(Boolean).length;
+}
+
+/**
+ * Force a line to be exactly one narration cue: no interior sentence
+ * terminators (they would split the character's line across beats), at most
+ * SCREEN_DEMO_SPOKEN_LINE_MAX_CHARS, ending in one terminator.
+ */
+export function toSingleSpokenLine(text: string, maxChars = SCREEN_DEMO_SPOKEN_LINE_MAX_CHARS): string {
+  let line = text
+    .replace(/\s+/gu, " ")
+    .replace(/(\d)\.(\d)/gu, "$1 point $2")
+    .trim();
+  const terminal = /[!?]$/u.test(line) ? line.slice(-1) : ".";
+  line = line.replace(/[.!?。！？।]+$/u, "").replace(/[.!?。！？।]/gu, "").trim();
+  if (line.length > maxChars - 1) {
+    const cut = line.slice(0, maxChars - 1);
+    const lastSpace = cut.lastIndexOf(" ");
+    line = (lastSpace > maxChars * 0.5 ? cut.slice(0, lastSpace) : cut).replace(/[,;:\s-]+$/u, "");
+  }
+  return line ? `${line}${terminal}` : "";
+}
+
+function asSentence(text: string): string {
+  const trimmed = text.replace(/\s+/gu, " ").trim();
+  if (!trimmed) return "";
+  return /[.!?。！？।]$/u.test(trimmed) ? trimmed : `${trimmed}.`;
+}
+
+/**
+ * Make any model reply safe to voice: exactly one-cue intro/closing, ordered
+ * steps trimmed from the end until the voiceover fits the footage budget.
+ */
+export function repairScreenDemoScript(
+  raw: Partial<Record<keyof ScreenDemoScript, unknown>>,
+  args: { recordingDurationSec: number; brandName?: string | null },
+): ScreenDemoScript {
+  const intro = toSingleSpokenLine(typeof raw.intro === "string" ? raw.intro : "");
+  if (intro && intro.length < MIN_CUE_CHARS) {
+    throw new VideoGenProviderError("The walkthrough intro line is too short to voice on its own.");
+  }
+  let closing = toSingleSpokenLine(typeof raw.closing === "string" ? raw.closing : "");
+  const steps = (Array.isArray(raw.steps) ? raw.steps : [])
+    .filter((step): step is string => typeof step === "string")
+    .map(asSentence)
+    .filter(Boolean);
+  if (!intro) throw new VideoGenProviderError("The walkthrough script is missing its intro line.");
+  if (steps.length === 0) {
+    throw new VideoGenProviderError("The walkthrough script has no voiceover for the recording.");
+  }
+  if (!closing) {
+    closing = toSingleSpokenLine(
+      args.brandName?.trim() ? `Try ${args.brandName.trim()} today` : "Try it today",
+    );
+  }
+  // The narration splitter merges any fragment under 10 characters into its
+  // neighbour, which would move demo words into a character line. Fold short
+  // steps into the next one so every boundary survives voicing.
+  const sturdy: string[] = [];
+  let carry = "";
+  for (const step of steps) {
+    const joined = carry ? `${carry}, ${step.charAt(0).toLowerCase()}${step.slice(1)}` : step;
+    if (joined.length < MIN_CUE_CHARS) {
+      carry = joined.replace(/[.!?。！？।]+$/u, "");
+      continue;
+    }
+    sturdy.push(joined);
+    carry = "";
+  }
+  if (carry) {
+    if (sturdy.length > 0) {
+      sturdy[sturdy.length - 1] = `${sturdy[sturdy.length - 1]!.replace(/[.!?。！？।]+$/u, "")}, ${carry}.`;
+    } else {
+      sturdy.push(`${carry}.`);
+    }
+  }
+  if (closing.length < MIN_CUE_CHARS) {
+    closing = toSingleSpokenLine(
+      args.brandName?.trim() ? `Try ${args.brandName.trim()} today` : "Give it a try today",
+    );
+  }
+  const budget = Math.ceil(demoWordBudget(args.recordingDurationSec) * 1.15);
+  const kept: string[] = [];
+  let words = 0;
+  for (const step of sturdy) {
+    const count = wordCount(step);
+    if (kept.length > 0 && words + count > budget) break;
+    kept.push(step);
+    words += count;
+  }
+  return { intro, steps: kept, closing };
+}
+
+export function assembleScreenDemoScript(script: ScreenDemoScript): string {
+  return [script.intro, ...script.steps, script.closing].join(" ");
+}
+
+/**
+ * A user-written script is spoken verbatim, so it is checked rather than
+ * rewritten: the first narration cue is the character's intro, the last is
+ * the closing, and there must be something in between for the recording.
+ */
+export function userScreenDemoScriptIssues(script: string): string[] {
+  const issues: string[] = [];
+  const trimmed = script.trim();
+  const firstSentence = trimmed.match(/^[^.!?。！？।]+[.!?。！？।]*/u)?.[0]?.trim() ?? "";
+  if (firstSentence.length > 90) {
+    issues.push("Keep your first sentence under 90 characters — it is what your character says on camera.");
+  }
+  const lastSentence = trimmed.match(/[^.!?。！？।]+[.!?。！？।]*\s*$/u)?.[0]?.trim() ?? "";
+  if (lastSentence.length > 90) {
+    issues.push("Keep your last sentence under 90 characters — it is your character's closing line.");
+  }
+  // Same splitter the narration uses (tiny fragments merge into neighbours),
+  // so the count is the number of cues that will actually be voiced.
+  if (splitIntoSentences(trimmed).length < 3) {
+    issues.push(
+      "Your script needs at least three full sentences: an intro for your character, the walkthrough, and a closing line.",
+    );
+  }
+  return issues;
+}
+
+export function buildScreenDemoScriptPrompt(args: {
+  brief: string;
+  recordingDurationSec: number;
+  brandName?: string | null;
+  brandVoice?: string | null;
+  cta?: string | null;
+  hasFrames: boolean;
+}): { system: string; user: string } {
+  const budget = demoWordBudget(args.recordingDurationSec);
+  const system = [
+    "You write voiceover scripts for short app and software walkthrough videos.",
+    "The video has three parts: a presenter says ONE intro sentence on camera, then a screen recording plays while a voiceover narrates it, then the presenter says ONE closing sentence on camera.",
+    "Return JSON only: {\"intro\": string, \"steps\": string[], \"closing\": string}.",
+    `intro: one sentence, at most 14 words and ${SCREEN_DEMO_SPOKEN_LINE_MAX_CHARS} characters. Name the problem the app solves or the outcome it gives. No greetings like "Hi everyone".`,
+    `steps: the voiceover for the recording, in the order things happen on screen. Plain spoken sentences, one idea each, about ${budget} words in total — never more, because the recording is only ${Math.round(args.recordingDurationSec)} seconds long.`,
+    "Describe only what the viewer can actually see. Do not invent features, numbers, prices, or claims.",
+    `closing: one sentence, at most 14 words and ${SCREEN_DEMO_SPOKEN_LINE_MAX_CHARS} characters, that names the brand and the next step.`,
+    "Use no abbreviations with full stops (write Doctor, not Dr.), no emojis, no hashtags, no stage directions.",
+  ].join("\n");
+  const user = [
+    `What the app is and what to highlight: ${args.brief.trim() || "(not given — infer from the screens)"}`,
+    args.brandName?.trim() ? `Brand name: ${args.brandName.trim()}` : null,
+    args.cta?.trim() ? `Call to action for the closing: ${args.cta.trim()}` : null,
+    args.brandVoice?.trim() ? `Brand voice: ${args.brandVoice.trim()}` : null,
+    `Recording length: ${Math.round(args.recordingDurationSec)} seconds.`,
+    args.hasFrames
+      ? "The attached images are frames from the recording, in order. Narrate what they show."
+      : "No frames are available; keep the steps general to the brief and avoid specific UI details.",
+  ].filter(Boolean).join("\n");
+  return { system, user };
+}
+
+/**
+ * Write the walkthrough script. Tries the tenant's model with the frames
+ * attached; models without image input fall back to a text-only request so
+ * the job never fails just because the chosen model is not multimodal.
+ */
+export async function writeScreenDemoScript(args: {
+  client: OpenAI;
+  model: string;
+  requestParams?: Record<string, unknown>;
+  brief: string;
+  recordingDurationSec: number;
+  frames: Buffer[];
+  brandName?: string | null;
+  brandVoice?: string | null;
+  cta?: string | null;
+}): Promise<{ script: string; parts: ScreenDemoScript; usedFrames: boolean }> {
+  const ask = async (frames: Buffer[]) => {
+    const prompt = buildScreenDemoScriptPrompt({
+      brief: args.brief,
+      recordingDurationSec: args.recordingDurationSec,
+      brandName: args.brandName,
+      brandVoice: args.brandVoice,
+      cta: args.cta,
+      hasFrames: frames.length > 0,
+    });
+    const userContent: OpenAI.Chat.Completions.ChatCompletionContentPart[] = [
+      { type: "text", text: prompt.user },
+      ...frames.map((frame) => ({
+        type: "image_url" as const,
+        image_url: { url: `data:image/jpeg;base64,${frame.toString("base64")}`, detail: "low" as const },
+      })),
+    ];
+    const completion = await args.client.chat.completions.create({
+      model: args.model,
+      messages: [
+        { role: "system", content: prompt.system },
+        { role: "user", content: frames.length > 0 ? userContent : prompt.user },
+      ],
+      max_completion_tokens: 2048,
+      response_format: { type: "json_object" },
+      ...(args.requestParams ?? {}),
+    });
+    const raw = completion.choices[0]?.message?.content ?? "{}";
+    const parsed = (parseModelJsonObject(raw) ?? {}) as Partial<Record<keyof ScreenDemoScript, unknown>>;
+    return repairScreenDemoScript(parsed, {
+      recordingDurationSec: args.recordingDurationSec,
+      brandName: args.brandName,
+    });
+  };
+
+  let parts: ScreenDemoScript;
+  let usedFrames = args.frames.length > 0;
+  try {
+    parts = await ask(args.frames);
+  } catch (error) {
+    if (!usedFrames) throw error;
+    usedFrames = false;
+    parts = await ask([]);
+  }
+  return { script: assembleScreenDemoScript(parts), parts, usedFrames };
+}
+
+/* ------------------------------------------------------------------------- *
+ * Demo clip
+ * ------------------------------------------------------------------------- */
+
+function ffmpegColor(hex: string | null | undefined): string | null {
+  const match = /^#?([0-9a-fA-F]{6})$/u.exec(hex?.trim() ?? "");
+  return match ? `0x${match[1]!.toUpperCase()}` : null;
+}
+
+/**
+ * The screen_demo beat's footage, at the job's frame size.
+ *
+ * - Letterboxed, never cropped: a UI cropped to fill 9:16 loses its menus.
+ *   The margin is a soft blurred copy of the recording, or the brand colour.
+ * - Never trimmed (the product's duration policy): a recording longer than
+ *   its voiceover keeps playing after the words stop.
+ * - A recording shorter than its voiceover holds its last frame so the
+ *   narration is never cut.
+ * - Silent: the shared TTS track is the only voice in the video.
+ */
+export async function fitScreenDemoClip(args: {
+  recording: Buffer;
+  targetSec: number;
+  aspectRatio: VideoAspect;
+  background?: string | null;
+}): Promise<Buffer> {
+  const { width, height } = ASPECT_DIMENSIONS[args.aspectRatio];
+  const dir = await mkdtemp(join(tmpdir(), "kokao-screen-demo-"));
+  try {
+    await writeFile(join(dir, "rec"), args.recording);
+    const recordingSec = await probeDurationSec("rec", dir);
+    if (!recordingSec) throw new VideoGenProviderError("Cannot measure the screen recording.");
+    const holdSec = Math.max(0, args.targetSec - recordingSec);
+    const outSec = Math.max(recordingSec, args.targetSec);
+    // Inset the UI slightly so its edges never touch the frame.
+    const innerW = Math.floor((width * 0.94) / 2) * 2;
+    const innerH = Math.floor((height * 0.94) / 2) * 2;
+    const hold = holdSec > 0.01 ? `,tpad=stop_mode=clone:stop_duration=${holdSec.toFixed(3)}` : "";
+    const fg = `scale=${innerW}:${innerH}:force_original_aspect_ratio=decrease,setsar=1`;
+    const solid = ffmpegColor(args.background);
+    const graph = solid
+      ? `[0:v]fps=${FPS}${hold},${fg}[fg];color=c=${solid}:s=${width}x${height}:r=${FPS}[bg];` +
+        `[bg][fg]overlay=(W-w)/2:(H-h)/2:shortest=1,format=yuv420p[v]`
+      : `[0:v]fps=${FPS}${hold},split[a][b];` +
+        `[a]scale=${width}:${height}:force_original_aspect_ratio=increase,crop=${width}:${height},` +
+        `boxblur=24:2,eq=brightness=-0.08[bg];[b]${fg}[fg];` +
+        `[bg][fg]overlay=(W-w)/2:(H-h)/2,setsar=1,format=yuv420p[v]`;
+    await runFfmpeg(
+      [
+        "-y", "-i", "rec", "-filter_complex", graph, "-map", "[v]", "-an",
+        "-t", outSec.toFixed(3),
+        "-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p",
+        "demo.mp4",
+      ],
+      dir,
+      encodeBudgetMs(outSec),
+    );
+    return await readFile(join(dir, "demo.mp4"));
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+}
+
+/* ------------------------------------------------------------------------- *
+ * Brand end card
+ * ------------------------------------------------------------------------- */
+
+export type EndCardAnimation = "fade_up" | "logo_scale" | "slide_in";
+
+export interface EndCardInput {
+  width: number;
+  height: number;
+  durationSec: number;
+  animation: EndCardAnimation;
+  /** "#RRGGBB"; defaults to a soft neutral. */
+  background?: string | null;
+  logo?: Buffer | null;
+  brandName?: string | null;
+  tagline?: string | null;
+  cta?: string | null;
+}
+
+/** Relative luminance → pick readable text on the card background. */
+export function endCardTextColor(backgroundHex: string): string {
+  const match = /^#?([0-9a-fA-F]{6})$/u.exec(backgroundHex.trim());
+  if (!match) return "0x1F2937";
+  const value = Number.parseInt(match[1]!, 16);
+  const channel = (c: number) => {
+    const s = c / 255;
+    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
+  };
+  const luminance =
+    0.2126 * channel((value >> 16) & 0xff) +
+    0.7152 * channel((value >> 8) & 0xff) +
+    0.0722 * channel(value & 0xff);
+  return luminance > 0.45 ? "0x1F2937" : "0xFFFFFF";
+}
+
+/** Card lines in reading order, empty ones dropped. */
+export function endCardLines(input: Pick<EndCardInput, "brandName" | "tagline" | "cta">) {
+  return [
+    { key: "brand", text: input.brandName?.trim() ?? "", scale: 14 },
+    { key: "tagline", text: input.tagline?.trim() ?? "", scale: 26 },
+    { key: "cta", text: input.cta?.trim() ?? "", scale: 30 },
+  ].filter((line) => line.text.length > 0);
+}
+
+/** Render the animated card as its own silent clip (with a silent audio track). */
+export async function renderEndCard(input: EndCardInput): Promise<Buffer> {
+  const { width, height } = input;
+  const duration = Math.max(1.5, Math.min(8, input.durationSec));
+  const bgHex = input.background && /^#?[0-9a-fA-F]{6}$/u.test(input.background.trim())
+    ? input.background.trim()
+    : "#F4F1EC";
+  const bg = ffmpegColor(bgHex)!;
+  const ink = endCardTextColor(bgHex);
+  const minSide = Math.min(width, height);
+  const dir = await mkdtemp(join(tmpdir(), "kokao-end-card-"));
+  try {
+    const font = await findFontFile();
+    const lines = font ? endCardLines(input) : [];
+    const hasLogo = Boolean(input.logo && input.logo.length > 0);
+    if (hasLogo) await writeFile(join(dir, "logo"), input.logo!);
+
+    // Vertical layout: logo block, then text lines, centred as one group.
+    const logoH = hasLogo ? Math.round(minSide * (lines.length > 0 ? 0.22 : 0.3)) : 0;
+    const sizes = lines.map((line) => Math.round(minSide / line.scale));
+    const gap = Math.round(minSide * 0.035);
+    const blockH =
+      logoH + sizes.reduce((sum, size) => sum + Math.round(size * 1.25), 0) +
+      gap * Math.max(0, lines.length + (hasLogo ? 1 : 0) - 1);
+    let cursor = Math.round((height - blockH) / 2);
+    const logoY = cursor;
+    if (hasLogo) cursor += logoH + gap;
+
+    // Motion: everything settles within the first 0.7s, text trails the logo.
+    const IN = 0.7;
+    const ease = (start: number) => `min(1,max(0,(t-${start})/${IN}))`;
+    const rise = (start: number, px: number) => `${px}*(1-${ease(start)})*(1-${ease(start)})`;
+
+    const filters: string[] = [];
+    let last = "[0:v]";
+    if (hasLogo) {
+      const maxLogoW = Math.round(width * 0.6);
+      let logoChain = `[1:v]format=rgba,scale=w=${maxLogoW}:h=${logoH}:force_original_aspect_ratio=decrease`;
+      let x = "(W-w)/2";
+      let y = `${logoY}`;
+      if (input.animation === "logo_scale") {
+        // Grow from 60% with an ease-out; overlay recentres every frame.
+        logoChain += `,scale=w='iw*(0.6+0.4*${ease(0)})':h=-1:eval=frame`;
+        y = `${logoY}+(${logoH}-h)/2`;
+      } else if (input.animation === "slide_in") {
+        x = `(W-w)/2-(W/2+w)*(1-${ease(0)})*(1-${ease(0)})`;
+      } else {
+        y = `${logoY}+${rise(0, Math.round(minSide * 0.05))}`;
+      }
+      logoChain += `,fade=t=in:st=0:d=${IN}:alpha=1[logo]`;
+      filters.push(logoChain);
+      filters.push(`${last}[logo]overlay=x='${x}':y='${y}':eval=frame[v0]`);
+      last = "[v0]";
+    }
+    for (const [index, line] of lines.entries()) {
+      const file = `line${index}.txt`;
+      await writeFile(join(dir, file), line.text.replace(/\r?\n/gu, " "));
+      const size = sizes[index]!;
+      const start = (hasLogo ? 0.25 : 0) + index * 0.15;
+      const yBase = cursor;
+      cursor += Math.round(size * 1.25) + gap;
+      const y = input.animation === "slide_in" ? `${yBase}` : `${yBase}+${rise(start, Math.round(minSide * 0.03))}`;
+      const x = input.animation === "slide_in"
+        ? `(w-text_w)/2+(w/2+text_w)*(1-${ease(start)})*(1-${ease(start)})`
+        : "(w-text_w)/2";
+      const alpha = ease(start);
+      filters.push(
+        `${last}drawtext=fontfile=${font}:textfile=${file}:fontsize=${size}:fontcolor=${ink}:` +
+          `x='${x}':y='${y}':alpha='${alpha}'[t${index}]`,
+      );
+      last = `[t${index}]`;
+    }
+    filters.push(`${last}fade=t=in:st=0:d=0.25,format=yuv420p[v]`);
+
+    const args = [
+      "-y",
+      "-f", "lavfi", "-i", `color=c=${bg}:s=${width}x${height}:r=${FPS}:d=${duration.toFixed(3)}`,
+      ...(hasLogo ? ["-loop", "1", "-t", duration.toFixed(3), "-i", "logo"] : []),
+      "-f", "lavfi", "-t", duration.toFixed(3), "-i", "anullsrc=channel_layout=stereo:sample_rate=48000",
+      "-filter_complex", filters.join(";"),
+      "-map", "[v]", "-map", `${hasLogo ? 2 : 1}:a`,
+      "-t", duration.toFixed(3),
+      "-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p",
+      "-c:a", "aac", "-b:a", "128k",
+      "card.mp4",
+    ];
+    await runFfmpeg(args, dir, encodeBudgetMs(duration));
+    return await readFile(join(dir, "card.mp4"));
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+}
+
+async function probeStreams(file: string, cwd: string) {
+  const { stdout } = await execFileAsync(
+    "ffprobe",
+    ["-v", "error", "-show_streams", "-of", "json", file],
+    { cwd, timeout: 30_000 },
+  );
+  return (JSON.parse(stdout).streams ?? []) as Array<{
+    codec_type: string;
+    width?: number;
+    height?: number;
+  }>;
+}
+
+/** Append the end card after the finished video (re-encoded as one stream). */
+export async function appendEndCard(video: Buffer, card: Buffer): Promise<Buffer> {
+  const dir = await mkdtemp(join(tmpdir(), "kokao-end-card-join-"));
+  try {
+    await writeFile(join(dir, "main.mp4"), video);
+    await writeFile(join(dir, "card.mp4"), card);
+    const streams = await probeStreams("main.mp4", dir);
+    const picture = streams.find((stream) => stream.codec_type === "video");
+    if (!picture?.width || !picture.height) {
+      throw new VideoGenProviderError("Cannot measure the video before adding the end card.");
+    }
+    const mainHasAudio = streams.some((stream) => stream.codec_type === "audio");
+    const mainSec = (await probeDurationSec("main.mp4", dir)) ?? 0;
+    const total = mainSec + ((await probeDurationSec("card.mp4", dir)) ?? 0);
+    const norm = `fps=${FPS},scale=${picture.width}:${picture.height},setsar=1,format=yuv420p`;
+    const audio = "aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo";
+    const graph = [
+      `[0:v]${norm}[v0]`,
+      `[1:v]${norm}[v1]`,
+      mainHasAudio
+        ? `[0:a]${audio}[a0]`
+        : `anullsrc=channel_layout=stereo:sample_rate=48000,atrim=duration=${mainSec.toFixed(3)}[a0]`,
+      `[1:a]${audio}[a1]`,
+      `[v0][a0][v1][a1]concat=n=2:v=1:a=1[v][a]`,
+    ].join(";");
+    await runFfmpeg(
+      [
+        "-y", "-i", "main.mp4", "-i", "card.mp4", "-filter_complex", graph,
+        "-map", "[v]", "-map", "[a]",
+        "-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p",
+        "-c:a", "aac", "-b:a", "160k", "-movflags", "+faststart",
+        "out.mp4",
+      ],
+      dir,
+      encodeBudgetMs(total),
+    );
+    return await readFile(join(dir, "out.mp4"));
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+}
+
+/* ------------------------------------------------------------------------- *
+ * Job-runner entry point
+ * ------------------------------------------------------------------------- */
+
+/**
+ * The exact words the job will voice. A user script is spoken verbatim; an
+ * auto script is written once from frames of the recording and then reused
+ * (the caller persists `generated` so retries never rewrite the voiceover).
+ */
+export async function resolveScreenDemoScript(args: {
+  screenDemo: {
+    scriptMode: "auto" | "user";
+    script?: string | null;
+    generatedScript?: string | null;
+    recordingDurationSec: number;
+    endCard?: { cta?: string | null } | null;
+  };
+  brief: string;
+  brandName?: string | null;
+  brandVoice?: string | null;
+  loadRecording: () => Promise<Buffer>;
+  textClient: () => Promise<{ client: OpenAI; model: string; requestParams?: Record<string, unknown> }>;
+  onStage?: (stage: string) => void;
+}): Promise<{ script: string; generated: boolean }> {
+  if (args.screenDemo.scriptMode === "user") {
+    const script = args.screenDemo.script?.trim() ?? "";
+    const issues = userScreenDemoScriptIssues(script);
+    if (issues.length > 0) throw new ScreenDemoInputError(issues.join(" "));
+    return { script, generated: false };
+  }
+  if (args.screenDemo.generatedScript?.trim()) {
+    return { script: args.screenDemo.generatedScript.trim(), generated: false };
+  }
+  args.onStage?.("Watching your screen recording");
+  const frames = await extractDemoFrames(await args.loadRecording()).catch((): Buffer[] => []);
+  args.onStage?.("Writing the walkthrough script");
+  const text = await args.textClient();
+  const written = await writeScreenDemoScript({
+    client: text.client,
+    model: text.model,
+    requestParams: text.requestParams,
+    brief: args.brief,
+    recordingDurationSec: args.screenDemo.recordingDurationSec,
+    frames,
+    brandName: args.brandName,
+    brandVoice: args.brandVoice,
+    cta: args.screenDemo.endCard?.cta ?? null,
+  });
+  return { script: written.script, generated: true };
+}
