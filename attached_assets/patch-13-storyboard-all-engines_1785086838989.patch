+    expect(clipStoryboardSource(makeJob({ engine: "slideshow" }))).toBe("slide");
+    // Topic mode plans through its own narration-aware path.
+    expect(clipStoryboardSource(makeJob({ engine: "topic_to_video" }))).toBeNull();
+  });
+
