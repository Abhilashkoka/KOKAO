+    expect(clipShotCount(0)).toBe(1);
+    expect(clipShotCount(-4)).toBe(1);
+    expect(clipShotCount(2.7)).toBe(2);
+    expect(clipShotCount(5)).toBe(5);
+    expect(clipShotCount(99)).toBe(5);
+    expect(clipShotCount(Number.NaN)).toBe(1);
+  });
+
