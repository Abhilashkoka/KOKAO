+}
+
+function ProductRow({ kitId, product }: { kitId: number; product: BrandProduct }) {
+  const queryClient = useQueryClient();
+  const refresh = () => queryClient.invalidateQueries({ queryKey: getListBrandProductsQueryKey(kitId) });
