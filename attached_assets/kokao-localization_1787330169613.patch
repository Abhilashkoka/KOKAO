+    expect(Number(/FontSize=(\d+)/.exec(buildForceStyle(font, 100))![1])).toBeGreaterThanOrEqual(18);
+  });
+});
+
+/* ------------------------------------------------------------------ *
+ * Font resolution
+ * ------------------------------------------------------------------ */
+
+describe.skipIf(!FFMPEG)("resolveSubtitleFont", () => {
