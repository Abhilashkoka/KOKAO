+  label: "Tamil",
+  endonym: "தமிழ்",
+  script: "tamil",
+  bcp47: "ta-IN",
+  englishInSpeech: "high",
+  englishInText: "low",
+  loanwordScript: "target",
+  syllableRatio: 1.45,
+  avoid: [
