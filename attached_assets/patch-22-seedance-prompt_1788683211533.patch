+import type {
+  GuidedStoryCastSnapshot,
+  GuidedStoryScript,
+  GuidedStoryVisualChoices,
+} from "@workspace/db";
+
+/**
+ * Only the two fields this prompt reads. GuidedStoryPlatform is the platform
+ * ID string, not the resolved contract, and the snapshot carries the contract
+ * inline — so this is stated structurally rather than borrowing a named type
+ * that means something else.
+ */
+type PlatformFraming = { aspectRatio: string; safeArea: string };
+
+/**
+ * The guided-story scene visual prompt.
+ *
+ * This string used to be built inline inside guidedStoryStoryboard's scene
+ * map, which meant nothing could call it and nothing could test it. Every
+ * guided video that has ever rendered went through that template literal
+ * unexamined. It is extracted here UNCHANGED — same clauses, same order, same
+ * separators, same spacing — so the extraction itself can be proven by test
+ * rather than by reading.
+ *
+ * It is extracted now because a second prompt format is coming (Seedance 2.5
+ * has its own bracket syntax and takes dialogue in the prompt), and a format
+ * branch cannot be added safely to an expression that has no name and no
+ * coverage. Extract first, prove identical, then branch.
+ */
+
+type ScriptScene = GuidedStoryScript["scenes"][number];
+
+/**
+ * Which backdrop wording the scene gets. The choice is snapshot-level state —
+ * whether an override applies, whether the draft has the newer backdrops
+ * structure, whether this is a migrated legacy default — so the caller decides
+ * it and passes the answer in. Recomputing it here would mean handing this
+ * function the whole snapshot, which is what makes a function untestable.
+ */
+export type GuidedBackdropLabel = "scene override" | "default" | "shared";
+
+export interface GuidedSceneVisualInput {
+  scriptScene: Pick<ScriptScene, "visualDirection">;
+  /** Cast present in this scene, already resolved and ordered by roleIds. */
+  sceneCast: GuidedStoryCastSnapshot[];
+  /** The frozen approved backdrop, when the scene has one. */
+  backdrop: { imagePath: string; prompt: string } | null;
+  backdropLabel: GuidedBackdropLabel;
+  location: GuidedStoryVisualChoices["location"];
+  /** Non-null only when the logo is approved AND shown in this scene. */
+  logoPath: string | null;
+  platform: PlatformFraming;
+}
+
+/**
+ * One cast member's wardrobe and reference clause.
+ *
+ * "MISSING" is deliberate rather than an omission: a scene whose reference did
+ * not resolve still has to produce a string, and a visible MISSING in the
+ * prompt is what makes the failure legible in a logged prompt. The execution
+ * gates refuse the job before it reaches a provider anyway — this is for the
+ * human reading the log afterwards.
+ */
+function roleClause(member: GuidedStoryCastSnapshot): string {
+  return (
+    `${member.character.name} (${member.roleId}) wears ` +
+    `${member.outfit?.description ?? "the approved wardrobe"}; ` +
+    `identity reference ${member.character.referenceImagePath ?? "MISSING"}; ` +
+    `outfit reference ${member.outfit?.referenceImagePath ?? "MISSING"}.`
+  );
+}
+
+function locationClause(input: GuidedSceneVisualInput): string {
+  if (input.backdrop) {
+    return (
+      `Use the frozen approved ${input.backdropLabel} backdrop ${input.backdrop.imagePath}. ` +
+      `Backdrop direction: ${input.backdrop.prompt}. ` +
+      "Preserve this location unless an explicitly scene-only background correction is requested."
+    );
+  }
+  if (input.location.mode === "image") {
+    return `Use the shared location image ${input.location.imagePath} as environmental guidance.`;
+  }
+  if (input.location.mode === "text") {
+    return `Shared location direction: ${input.location.description}.`;
+  }
+  return "";
+}
+
+export function guidedSceneVisualPrompt(input: GuidedSceneVisualInput): string {
+  const roleDirection = input.sceneCast.map(roleClause).join(" ");
+  const locationDirection = locationClause(input);
+  const logoDirection = input.logoPath
+    ? `Place the approved logo ${input.logoPath} subtly in this scene.`
+    : "";
+  // The blank clauses stay as empty lines rather than being filtered out. That
+  // is what the inline version did, and a scene with no logo has always
+  // produced a trailing blank line before "Compose for". Tidying it here would
+  // change the bytes of every prompt this repo has ever sent.
+  return (
+    `${input.scriptScene.visualDirection}\n` +
+    `${roleDirection}\n` +
+    `${locationDirection}\n` +
+    `${logoDirection}\n` +
+    `Compose for ${input.platform.aspectRatio}. ${input.platform.safeArea}`
+  );
+}
