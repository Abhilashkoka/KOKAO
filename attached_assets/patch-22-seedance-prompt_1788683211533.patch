+++ b/artifacts/api-server/src/lib/videoGen/seedancePrompt.test.ts
@@ -0,0 +1,330 @@
+import { describe, expect, it } from "vitest";
+import type { GuidedStoryCastSnapshot, GuidedStoryScript } from "@workspace/db";
+import {
+  clipSeconds,
+  dialogueNumbering,
+  referenceSlots,
+  seedanceScenePrompt,
+  SEEDANCE_MAX_SEGMENT_SEC,
+  type SeedanceSceneInput,
+} from "./seedancePrompt";
+
+function member(
+  roleId: string,
+  name: string,
+  outfitDescription: string | null = "a grey sweatshirt",
+): GuidedStoryCastSnapshot {
+  return {
+    roleId,
+    source: "saved",
+    characterId: 1,
+    outfitId: 2,
+    brandKitId: null,
+    voiceId: "elevenlabs:premade:abc",
+    character: {
+      name,
+      description: `${name} the character`,
+      referenceImagePath: `/objects/1/uploads/${roleId}-ref.png`,
+    },
+    outfit: outfitDescription
+      ? {
+          name: "Default",
+          description: outfitDescription,
+          referenceImagePath: `/objects/1/uploads/${roleId}-outfit.png`,
+        }
+      : null,
+    voice: { id: "v1", label: "Voice", provider: "elevenlabs", providerVoiceId: "abc" },
+    isUserRole: false,
+    consentGranted: true,
+  };
+}
+
+function scene(
+  id: string,
+  startMs: number,
+  endMs: number,
+  lines: GuidedStoryScript["scenes"][number]["lines"],
+): GuidedStoryScript["scenes"][number] {
+  return {
+    id,
+    startMs,
+    endMs,
+    visualDirection: "Ava lifts the box and presents it to camera as she speaks.",
+    roleIds: ["role-1", "role-2"],
+    lines,
+  };
+}
+
+function line(
+  id: string,
+  ownerRoleId: string | null,
+  text: string,
+  startMs: number,
+  endMs: number,
+): GuidedStoryScript["scenes"][number]["lines"][number] {
+  return { id, ownerRoleId, kind: ownerRoleId ? "dialogue" : "narration", text, startMs, endMs };
+}
+
+const platform = { aspectRatio: "9:16", safeArea: "Keep faces inside the middle 80%." };
+
+function input(overrides: Partial<SeedanceSceneInput> = {}): SeedanceSceneInput {
+  const s = scene("s1", 0, 13000, [
+    line("l1", "role-1", "Welcome to IVF: romance, but with spreadsheets.", 1200, 4000),
+    line("l2", "role-2", "And a calendar that judges me.", 7500, 10000),
+  ]);
+  return {
+    scriptScene: s,
+    sceneCast: [member("role-1", "Ava"), member("role-2", "Ben")],
+    backdrop: { imagePath: "/objects/1/uploads/plate.png", prompt: "pale green bathroom tiles" },
+    location: { mode: "none" } as SeedanceSceneInput["location"],
+    platform,
+    locale: "en",
+    dialogueNumbers: new Map([["l1", 1], ["l2", 2]]),
+    segmentIndex: 0,
+    segmentCount: 2,
+    ...overrides,
+  };
+}
+
+describe("clipSeconds", () => {
+  it("rebases story time onto the clip", () => {
+    // A scene at 13-30s in the story is 0-17s to the model. Sending 13 would
+    // put the first line most of the way through a 17-second clip.
+    expect(clipSeconds(13000, 13000)).toBe(0);
+    expect(clipSeconds(19500, 13000)).toBe(7);
+    expect(clipSeconds(30000, 13000)).toBe(17);
+  });
+
+  it("rounds to whole seconds, which is all the timestamp format takes", () => {
+    expect(clipSeconds(1200, 0)).toBe(1);
+    expect(clipSeconds(1600, 0)).toBe(2);
+  });
+
+  it("never goes negative", () => {
+    // A line that starts fractionally before its scene (rounding at a coverage
+    // split boundary) must clamp, not emit "-1s".
+    expect(clipSeconds(900, 1000)).toBe(0);
+  });
+});
+
+describe("dialogueNumbering", () => {
+  const script = {
+    version: 1,
+    title: "t",
+    logline: "l",
+    runtimeSeconds: 30,
+    roles: [],
+    warnings: [],
+    scenes: [
+      scene("s1", 0, 13000, [
+        line("l1", "role-1", "one", 1200, 3000),
+        line("l2", "role-2", "two", 7500, 9000),
+      ]),
+      scene("s2", 13000, 30000, [
+        line("l3", "role-2", "three", 14000, 16000),
+        line("l4", "role-1", "four", 19500, 21000),
+      ]),
+    ],
+  } as GuidedStoryScript;
+
+  it("numbers continuously across segments, not per scene", () => {
+    // The number is a sequence reference. Restarting it in each scene would
+    // give two different lines the name "Dialogue 1".
+    expect([...dialogueNumbering(script).entries()]).toEqual([
+      ["l1", 1], ["l2", 2], ["l3", 3], ["l4", 4],
+    ]);
+  });
+
+  it("orders by time inside a scene, not by array position", () => {
+    const outOfOrder = {
+      ...script,
+      scenes: [scene("s1", 0, 13000, [
+        line("late", "role-1", "b", 9000, 10000),
+        line("early", "role-2", "a", 1000, 2000),
+      ])],
+    } as GuidedStoryScript;
+    expect(dialogueNumbering(outOfOrder).get("early")).toBe(1);
+    expect(dialogueNumbering(outOfOrder).get("late")).toBe(2);
+  });
+
+  it("numbers narration alongside dialogue", () => {
+    // Narration is spoken too. Skipping it would leave gaps in the sequence
+    // that read as lost lines.
+    const withNarration = {
+      ...script,
+      scenes: [scene("s1", 0, 8000, [
+        line("n1", null, "Somewhere in a city.", 0, 2000),
+        line("d1", "role-1", "Hello.", 3000, 4000),
+      ])],
+    } as GuidedStoryScript;
+    expect(dialogueNumbering(withNarration).get("n1")).toBe(1);
+    expect(dialogueNumbering(withNarration).get("d1")).toBe(2);
+  });
+});
+
+describe("referenceSlots", () => {
+  it("gives every role two slots — identity and wardrobe", () => {
