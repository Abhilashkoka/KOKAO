+import { describe, expect, it } from "vitest";
+import type { GuidedStoryCastSnapshot } from "@workspace/db";
+import {
+  guidedSceneVisualPrompt,
+  type GuidedBackdropLabel,
+  type GuidedSceneVisualInput,
+} from "./guidedScenePrompt";
+
+function member(
+  roleId: string,
+  name: string,
+  overrides: Partial<GuidedStoryCastSnapshot> = {},
+): GuidedStoryCastSnapshot {
+  return {
+    roleId,
+    source: "saved",
+    characterId: 1,
+    outfitId: 2,
+    brandKitId: null,
+    voiceId: "elevenlabs:premade:abc",
+    character: {
+      name,
+      description: `${name} the character`,
+      referenceImagePath: `/objects/1/uploads/${roleId}-ref.png`,
+    },
+    outfit: {
+      name: "Default",
+      description: "a grey sweatshirt",
+      referenceImagePath: `/objects/1/uploads/${roleId}-outfit.png`,
+    },
+    voice: { id: "v1", label: "Voice", provider: "elevenlabs", providerVoiceId: "abc" },
+    isUserRole: false,
+    consentGranted: true,
+    ...overrides,
+  };
+}
+
+/**
+ * The prompt exactly as guidedStoryStoryboard built it inline before the
+ * extraction, reproduced here character for character from the pre-extraction
+ * source. Nothing imports it — that is the point. If the extracted function
+ * ever drifts from this, every guided video changes, and this test is the only
+ * thing standing between that and a silent regression across the whole flow.
+ */
+function inlinePromptAsItWas(input: GuidedSceneVisualInput): string {
+  const sceneCast = input.sceneCast;
+  const sceneBackdrop = input.backdrop;
+  const visuals = { location: input.location, logo: { path: input.logoPath } };
+  const showLogo = input.logoPath !== null;
+  const snapshot = { platform: input.platform };
+  const label = input.backdropLabel;
+  const roleDirection = sceneCast.map((m) =>
+    `${m.character.name} (${m.roleId}) wears ${m.outfit?.description ?? "the approved wardrobe"}; identity reference ${m.character.referenceImagePath ?? "MISSING"}; outfit reference ${m.outfit?.referenceImagePath ?? "MISSING"}.`,
+  ).join(" ");
+  const locationDirection = sceneBackdrop
+    ? `Use the frozen approved ${label} backdrop ${sceneBackdrop.imagePath}. ` +
+      `Backdrop direction: ${sceneBackdrop.prompt}. Preserve this location unless an explicitly scene-only background correction is requested.`
+    : visuals.location.mode === "image"
+      ? `Use the shared location image ${visuals.location.imagePath} as environmental guidance.`
+      : visuals.location.mode === "text"
+        ? `Shared location direction: ${visuals.location.description}.`
+        : "";
+  const logoDirection = showLogo
+    ? `Place the approved logo ${visuals.logo.path} subtly in this scene.`
+    : "";
+  return `${input.scriptScene.visualDirection}\n${roleDirection}\n${locationDirection}\n${logoDirection}\nCompose for ${snapshot.platform.aspectRatio}. ${snapshot.platform.safeArea}`;
+}
+
+const platform = { aspectRatio: "9:16", safeArea: "Keep faces inside the middle 80%." };
+
+function cases(): Array<[string, GuidedSceneVisualInput]> {
+  const base = {
+    scriptScene: { visualDirection: "Two people talk across a kitchen counter." },
+    platform,
+  };
+  const none = { mode: "none" } as GuidedSceneVisualInput["location"];
+  const image = {
+    mode: "image",
+    imagePath: "/objects/1/uploads/loc.png",
+  } as GuidedSceneVisualInput["location"];
+  const text = {
+    mode: "text",
+    description: "a small tiled bathroom",
+  } as GuidedSceneVisualInput["location"];
+  const backdrop = { imagePath: "/objects/1/uploads/plate.png", prompt: "pale green tiles" };
+  const labels: GuidedBackdropLabel[] = ["scene override", "default", "shared"];
+
+  const out: Array<[string, GuidedSceneVisualInput]> = [];
+  for (const label of labels) {
+    out.push([`backdrop, label ${label}`, {
+      ...base, sceneCast: [member("role-1", "Ava")], backdrop, backdropLabel: label,
+      location: none, logoPath: null,
+    }]);
+  }
+  out.push(["no backdrop, location image", {
+    ...base, sceneCast: [member("role-1", "Ava")], backdrop: null, backdropLabel: "shared",
+    location: image, logoPath: null,
+  }]);
+  out.push(["no backdrop, location text", {
+    ...base, sceneCast: [member("role-1", "Ava")], backdrop: null, backdropLabel: "shared",
+    location: text, logoPath: null,
+  }]);
+  out.push(["no backdrop, no location — the empty clause", {
+    ...base, sceneCast: [member("role-1", "Ava")], backdrop: null, backdropLabel: "shared",
+    location: none, logoPath: null,
+  }]);
+  out.push(["logo shown", {
+    ...base, sceneCast: [member("role-1", "Ava")], backdrop, backdropLabel: "default",
+    location: none, logoPath: "/objects/1/uploads/logo.png",
+  }]);
+  out.push(["two-hander", {
+    ...base, sceneCast: [member("role-1", "Ava"), member("role-2", "Ben")],
+    backdrop, backdropLabel: "default", location: none, logoPath: null,
+  }]);
+  out.push(["empty cast", {
+    ...base, sceneCast: [], backdrop, backdropLabel: "default", location: none, logoPath: null,
+  }]);
+  out.push(["missing outfit", {
+    ...base, sceneCast: [member("role-1", "Ava", { outfit: null })],
+    backdrop, backdropLabel: "default", location: none, logoPath: null,
+  }]);
+  out.push(["missing references", {
+    ...base,
+    sceneCast: [member("role-1", "Ava", {
+      character: { name: "Ava", description: "d", referenceImagePath: null },
+      outfit: { name: "Default", description: "a coat", referenceImagePath: null },
+    })],
+    backdrop, backdropLabel: "default", location: none, logoPath: null,
+  }]);
+  return out;
+}
+
+describe("guidedSceneVisualPrompt", () => {
+  it.each(cases())("emits the pre-extraction string byte for byte: %s", (_name, input) => {
+    expect(guidedSceneVisualPrompt(input)).toBe(inlinePromptAsItWas(input));
+  });
+
+  it("keeps the empty clause as an empty line rather than tidying it away", () => {
+    // A scene with no logo and no location has always emitted two blank lines
+    // before "Compose for". It looks like a bug and is not one to fix here:
+    // every guided prompt ever sent had them, and removing them would change
+    // the bytes of a prompt that is already known to work.
+    const prompt = guidedSceneVisualPrompt({
+      scriptScene: { visualDirection: "A wide shot." },
+      sceneCast: [],
+      backdrop: null,
+      backdropLabel: "shared",
+      location: { mode: "none" } as GuidedSceneVisualInput["location"],
+      logoPath: null,
+      platform,
+    });
+    expect(prompt).toBe("A wide shot.\n\n\n\nCompose for 9:16. Keep faces inside the middle 80%.");
+  });
+
+  it("names a missing reference in the prompt instead of dropping the clause", () => {
+    // The execution gates refuse this job before any provider call. The word
+    // MISSING is for whoever reads the logged prompt afterwards.
+    const prompt = guidedSceneVisualPrompt({
+      scriptScene: { visualDirection: "A close shot." },
+      sceneCast: [member("role-1", "Ava", {
+        character: { name: "Ava", description: "d", referenceImagePath: null },
+      })],
+      backdrop: null,
+      backdropLabel: "shared",
+      location: { mode: "none" } as GuidedSceneVisualInput["location"],
+      logoPath: null,
+      platform,
+    });
+    expect(prompt).toContain("identity reference MISSING");
+  });
+});
