@@ -0,0 +1,298 @@
+import type {
+  GuidedStoryCastSnapshot,
+  GuidedStoryLocale,
+  GuidedStoryScript,
+  GuidedStoryVisualChoices,
+} from "@workspace/db";
+import { GUIDED_STORY_LANGUAGES } from "./guidedStory";
+
+/**
+ * Seedance 2.5 scene prompts.
+ *
+ * Seedance 2.5 does not take the same prompt shape as every other video model
+ * this repo talks to. It has a documented bracket notation where the bracket
+ * IS the meaning — a dialogue line written in the caption bracket is rendered
+ * as burned-in text across the picture rather than spoken — and it generates
+ * the audio with the video, so the spoken lines belong in the prompt. Every
+ * other provider gets a picture-only prompt and its audio dubbed on afterwards.
+ *
+ * Nothing here reaches a provider yet. This module is the assembly half of the
+ * KOKAO Seedance rulebook, landed and tested on its own so it can be reviewed
+ * against the documented syntax before anything is switched over to it. The
+ * wiring — deciding per job which format a scene is built in — is deliberately
+ * a separate change, because of the ordering problem noted at the bottom.
+ *
+ * The rules that shape what the SCRIPT WRITER invents (30-second ceiling, one
+ * action per beat, whole-second timing) are not here. Those belong in the
+ * governed prompt for the guided_story_script flow, because they have to reach
+ * the model that writes the script. Only assembly lives here, where it is
+ * deterministic.
+ */
+
+type ScriptScene = GuidedStoryScript["scenes"][number];
+type ScriptLine = ScriptScene["lines"][number];
+
+/**
+ * Seedance's own ceiling. A generation longer than this is refused outright,
+ * so a scene past it has to become several prompts before it is ever sent.
+ */
+export const SEEDANCE_MAX_SEGMENT_SEC = 30;
+
+/** The four brackets, and what each one means to the model. */
+export const SEEDANCE_BRACKETS = {
+  music: ["(", ")"],
+  sfx: ["<", ">"],
+  voice: ["{", "}"],
+  caption: ["【", "】"],
+} as const;
+
+/**
+ * The only negatives Seedance's guidance permits: captions, logos, watermarks,
+ * background music, overall look. Each names a rendering behaviour rather than
+ * a subject. A negative that names a subject — "no other people in frame" —
+ * describes someone and puts them just off screen, and the model obliges by
+ * putting them in it.
+ */
+export const SEEDANCE_DEFAULT_LOOK_EXCLUSION =
+  "No cartoon, illustration or 3D-render look.";
+
+function languageName(locale: GuidedStoryLocale): string {
+  return (
+    GUIDED_STORY_LANGUAGES.find((language) => language.locale === locale)?.languageName ??
+    "English"
+  );
+}
+
+/**
+ * Story milliseconds to clip seconds.
+ *
+ * A generation is its own clip and starts at zero. A scene sitting at
+ * 13000-30000ms in the story is 0-17s to Seedance, and sending the story
+ * offset instead is the single most likely way a split script returns with its
+ * dialogue landing in the wrong place. Whole seconds, because the documented
+ * timestamp format takes whole seconds and nothing finer.
+ */
+export function clipSeconds(ms: number, sceneStartMs: number): number {
+  return Math.max(0, Math.round((ms - sceneStartMs) / 1000));
+}
+
+/**
+ * Continuous dialogue numbering across the whole approved script.
+ *
+ * The number is a sequence reference, not a per-scene index: Dialogue 7 is
+ * Dialogue 7 in the prompt, in the dialogue list handed to the user, and in a
+ * review note, so a comment can name a line with no other coordinates. Keyed
+ * by line id because line ids are stable across the coverage split — a scene
+ * that becomes three shots keeps its line ids, so the numbering survives it.
+ *
+ * Narration is numbered alongside dialogue. It is spoken too, and a numbering
+ * that skipped it would leave gaps that look like lost lines.
+ */
+export function dialogueNumbering(script: GuidedStoryScript): Map<string, number> {
+  const numbers = new Map<string, number>();
+  for (const scene of script.scenes) {
+    for (const line of [...scene.lines].sort((a, b) => a.startMs - b.startMs)) {
+      numbers.set(line.id, numbers.size + 1);
+    }
+  }
+  return numbers;
+}
+
+export interface SeedanceReferenceSlot {
+  /** 1-based, and positional — slot 1 is whatever is uploaded first. */
+  slot: number;
+  kind: "identity" | "wardrobe" | "backdrop";
+  /** Storage path of the image that fills this slot. */
+  path: string | null;
+  /** The clause after "@Image n defines". */
+  defines: string;
+}
+
+/**
+ * The reference slots for a scene, in upload order.
+ *
+ * A KOKAO role is TWO images, not one: the canonical character reference, whose
+ * face-and-hair rectangle is protected, and the approved outfit image, where
+ * everything below that rectangle is repainted. Collapsing them into one slot
+ * loses exactly the distinction the outfit pipeline exists to maintain, so each
+ * gets its own slot and its own defines clause.
+ *
+ * Slots are positional, so this function is the only place that decides the
+ * order. The prompt and the upload manifest both come from here; if they came
+ * from two places they would eventually disagree, and a disagreement is a video
+ * where one character is wearing another's clothes.
+ */
+export function referenceSlots(
+  sceneCast: GuidedStoryCastSnapshot[],
+  backdrop: { imagePath: string; prompt: string } | null,
+): SeedanceReferenceSlot[] {
+  const slots: Omit<SeedanceReferenceSlot, "slot">[] = [];
+  for (const member of sceneCast) {
+    slots.push({
+      kind: "identity",
+      path: member.character.referenceImagePath,
+      defines: `${member.character.name}'s face and hair`,
+    });
+    slots.push({
+      kind: "wardrobe",
+      path: member.outfit?.referenceImagePath ?? null,
+      defines: `${member.character.name}'s clothing — ${
+        member.outfit?.description ?? "the approved wardrobe"
+      }`,
+    });
+  }
+  if (backdrop) {
+    slots.push({ kind: "backdrop", path: backdrop.imagePath, defines: backdrop.prompt });
+  }
+  return slots.map((slot, index) => ({ slot: index + 1, ...slot }));
+}
+
+export interface SeedanceSceneInput {
+  scriptScene: ScriptScene;
+  /** Cast present in this scene, resolved and ordered by the scene's roleIds. */
+  sceneCast: GuidedStoryCastSnapshot[];
+  backdrop: { imagePath: string; prompt: string } | null;
+  location: GuidedStoryVisualChoices["location"];
+  /** Only the framing this prompt reads; the snapshot carries it inline. */
+  platform: { aspectRatio: string; safeArea: string };
+  locale: GuidedStoryLocale;
+  /** From dialogueNumbering() over the whole script, not this scene alone. */
+  dialogueNumbers: Map<string, number>;
+  segmentIndex: number;
+  segmentCount: number;
+  /**
+   * The previous segment's closing image, verbatim. Every generation is a
+   * blank slate, so this sentence is the only continuity that crosses one.
+   */
+  carriedState?: string | null;
+  /** Emitted in 【 】. Empty means the exclusions ask for no captions. */
+  caption?: string | null;
+  /** Emitted in ( ). Empty means the exclusions ask for no background music. */
+  music?: string | null;
+  /** Emitted in < >. Room tone plus whatever the action makes. */
+  sfx?: string | null;
+  lookExclusion?: string;
+  /**
+   * Whether Seedance speaks the lines. False keeps the existing ElevenLabs
+   * narration and lip-sync path, and the prompt then carries no { } block at
+   * all — the two cannot both own the performance.
+   */
+  nativeAudio?: boolean;
+}
+
+function speaks(line: ScriptLine): boolean {
+  return line.text.trim().length > 0;
+}
+
+function speakerName(line: ScriptLine, sceneCast: GuidedStoryCastSnapshot[]): string {
+  if (!line.ownerRoleId) return "Narrator";
+  return (
+    sceneCast.find((member) => member.roleId === line.ownerRoleId)?.character.name ??
+    line.ownerRoleId
+  );
+}
+
+export function seedanceScenePrompt(input: SeedanceSceneInput): string {
+  const scene = input.scriptScene;
+  const durationSec = Math.round((scene.endMs - scene.startMs) / 1000);
+  const language = languageName(input.locale);
+  const slots = referenceSlots(input.sceneCast, input.backdrop);
+  const lines = [...scene.lines].sort((a, b) => a.startMs - b.startMs).filter(speaks);
+  const blocks: string[] = [];
+
+  blocks.push(
+    ["[GOAL]",
+     `One continuous ${durationSec}-second shot.`,
+     `Segment ${input.segmentIndex + 1} of ${input.segmentCount}. All times below are local to this ${durationSec}-second clip.`,
+    ].join("\n"),
+  );
+
+  if (input.carriedState) {
+    blocks.push(
+      ["[CONTINUITY]",
+       `This clip opens on exactly the image the previous clip ended on: ${input.carriedState}`,
+       "Same people, same wardrobe, same hair, same place, same time of day, same lighting direction, same spatial axis, same grade.",
+      ].join("\n"),
+    );
+  }
+
+  const references = slots.map((slot) => `@Image ${slot.slot} defines ${slot.defines}.`);
+  // Named positively. "Exactly one Ava" is a count; "no duplicate Avas" would
+  // be a negative naming a subject, which is the failure mode this avoids.
+  for (const member of input.sceneCast) {
+    references.push(
+      `The references show one ${member.character.name}. The video contains exactly one ${member.character.name}.`,
+    );
+  }
+  if (input.sceneCast.length) {
+    const names = input.sceneCast.map((member) => member.character.name);
+    references.push(
+      `${names.length === 1 ? "One person is" : `${names.length} people are`} in this shot: ` +
+        `${names.join(", ")}. The frame holds that cast from the first frame to the last.`,
+    );
+  }
+  if (!input.backdrop && input.location.mode === "text") {
+    references.push(`Location: ${input.location.description}.`);
+  }
+  blocks.push(["[REFERENCES]", ...references].join("\n"));
+
+  blocks.push(
+    ["[ACTION]", `0-${durationSec}s: ${scene.visualDirection}`].join("\n"),
+  );
+
+  if (input.nativeAudio !== false && lines.length) {
+    const spoken = lines.map((line) => {
+      const number = input.dialogueNumbers.get(line.id);
+      const at = clipSeconds(line.startMs, scene.startMs);
+      const who = speakerName(line, input.sceneCast);
+      // The spoken text, never the romanisation. A Latin transliteration is
+      // what an English-reading model will try to pronounce, which is how a
+      // Telugu line comes back sounding like English nonsense.
+      return `Dialogue ${number ?? "?"} — ${at}s — ${who} says in ${language}: {${line.text}}`;
+    });
+    blocks.push(
+      ["[DIALOGUE]",
+       `Spoken language: ${language}. Every line is spoken in ${language}, exactly as written, and nothing else is spoken.`,
+       ...spoken,
+      ].join("\n"),
+    );
+  }
+
+  const sound: string[] = [];
+  if (input.sfx) sound.push(`<${input.sfx}>`);
+  if (input.music) sound.push(`(${input.music})`);
+  if (input.caption) sound.push(`【${input.caption}】`);
+  if (sound.length) blocks.push(["[AUDIO AND ON-SCREEN]", ...sound].join("\n"));
+
+  const exclusions = ["No logos. No watermarks."];
+  if (!input.caption) exclusions.unshift("No captions, subtitles or on-screen text.");
+  if (!input.music) exclusions.push("No background music.");
+  exclusions.push(input.lookExclusion ?? SEEDANCE_DEFAULT_LOOK_EXCLUSION);
+  blocks.push(["[EXCLUSIONS]", ...exclusions].join("\n"));
+
+  blocks.push(
+    ["[HOLD]",
+     "One continuous take. No cut, no scene change, no new location inside this clip.",
+     "Identity, wardrobe, location, props, lighting direction and grade stay as described above for the whole clip.",
+     `Compose for ${input.platform.aspectRatio}. ${input.platform.safeArea}`,
+    ].join("\n"),
+  );
+
+  return blocks.join("\n\n");
+}
+
+/**
+ * ORDERING PROBLEM, recorded here so the next change does not trip over it.
+ *
+ * guidedStoryStoryboard bakes scene.visual into the storyboard, and the video
+ * model is not resolved until the job runs. So the format cannot simply be
+ * branched inside the storyboard builder — at that point nothing knows whether
+ * Seedance will render it.
+ *
+ * Worse, scene.inputFingerprint covers the script, cast, platform, visuals and
+ * locale, but NOT scene.visual. Two scenes built in different prompt formats
+ * therefore hash identically, and a preview rendered under one format would be
+ * silently reused for the other. Whichever way the wiring goes, the format has
+ * to enter that fingerprint, or a format switch will hand users stale frames
+ * with no indication anything changed.
+ */
