+++ b/artifacts/api-server/src/lib/videoGen/providers/ark.test.ts
@@ -0,0 +1,202 @@
+import { describe, it, expect, vi, afterEach } from "vitest";
+import { generateWithArkVideo, withAssetReferences } from "./ark";
+import { VideoGenNotConfiguredError, VideoGenProviderError } from "../types";
+import type { VideoGenInput } from "../types";
+
+/**
+ * The provider talks to ModelArk through global fetch (via
+ * boundedProviderFetch), so tests stub fetch and assert the exact request
+ * body. The assertions that matter are about reference material: an asset id
+ * must go out as `asset://<id>` and never as an inline image, because the
+ * inline path is exactly what the real-person filter rejects.
+ */
+
+const baseInput: VideoGenInput = {
+  prompt: "A barista pulling an espresso shot",
+  aspectRatio: "9:16",
+  durationSec: 6,
+  model: "dreamina-seedance-2-5-260628",
+};
+
+function jsonResponse(body: unknown, status = 200): Response {
+  return {
+    ok: status >= 200 && status < 300,
+    status,
+    json: async () => body,
+    text: async () => JSON.stringify(body),
+    arrayBuffer: async () => new ArrayBuffer(0),
+  } as unknown as Response;
+}
+
+function videoResponse(bytes: Uint8Array): Response {
+  return {
+    ok: true,
+    status: 200,
+    arrayBuffer: async () => bytes.buffer,
+  } as unknown as Response;
+}
+
+/** The parsed JSON body of the Nth fetch call. */
+function requestBody(fetchSpy: ReturnType<typeof vi.fn>, call = 0): Record<string, unknown> {
+  return JSON.parse(fetchSpy.mock.calls[call]![1].body as string);
+}
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+describe("withAssetReferences", () => {
+  it("names a single asset positionally", () => {
+    expect(withAssetReferences("She walks in", 1)).toContain("@Image1");
+  });
+
+  it("names every asset and says they are the same person", () => {
+    const prompt = withAssetReferences("She walks in", 3);
+    expect(prompt).toContain("@Image1, @Image2 and @Image3");
+    expect(prompt).toContain("the same person in each");
+  });
+
+  it("leaves the prompt alone when there is nothing to reference", () => {
+    expect(withAssetReferences("She walks in", 0)).toBe("She walks in");
+  });
+});
+
+describe("generateWithArkVideo", () => {
+  it("throws NotConfigured without a key (never reaches the network)", async () => {
+    const fetchSpy = vi.fn();
+    vi.stubGlobal("fetch", fetchSpy);
+    await expect(generateWithArkVideo(baseInput, null)).rejects.toBeInstanceOf(
+      VideoGenNotConfiguredError,
+    );
+    expect(fetchSpy).not.toHaveBeenCalled();
+  });
+
+  it("sends asset ids as asset:// references and never inlines the image", async () => {
+    const clip = new Uint8Array([1, 2, 3, 4]);
+    const fetchSpy = vi
+      .fn()
+      .mockResolvedValueOnce(jsonResponse({ id: "cgt-1" }))
+      .mockResolvedValueOnce(
+        jsonResponse({
+          id: "cgt-1",
+          status: "succeeded",
+          content: { video_url: "https://videos.example/clip.mp4" },
+        }),
+      )
+      .mockResolvedValueOnce(videoResponse(clip));
+    vi.stubGlobal("fetch", fetchSpy);
+
+    const result = await generateWithArkVideo(
+      {
+        ...baseInput,
+        assetRefs: ["asset-1", "asset-2"],
+        // Present on purpose: the asset path must win over it.
+        image: { buffer: Buffer.from([9, 9]), mimeType: "image/png" },
+      },
+      "ark-key",
+    );
+
+    const body = requestBody(fetchSpy);
+    const content = body.content as Array<Record<string, unknown>>;
+    expect(content).toHaveLength(3);
+    expect(content[1]).toMatchObject({
+      type: "image_url",
+      image_url: { url: "asset://asset-1" },
+      role: "reference_image",
+    });
+    expect(content[2]).toMatchObject({ image_url: { url: "asset://asset-2" } });
+    expect(JSON.stringify(body)).not.toContain("data:image/png;base64");
+    // The omni-reference task type is what makes the model treat the assets
+    // as the subject rather than as loose style hints.
+    expect(body.omni_reference_task_type).toBe("reference");
+    expect((content[0]!.text as string)).toContain("@Image1");
+    expect(result).toEqual({
+      buffer: Buffer.from(clip),
+      provider: "ark",
+      model: "dreamina-seedance-2-5-260628",
+    });
+  });
+
+  it("falls back to an inline first frame when there are no asset ids", async () => {
+    const fetchSpy = vi
+      .fn()
+      .mockResolvedValueOnce(jsonResponse({ id: "cgt-2" }))
+      .mockResolvedValueOnce(
+        jsonResponse({
+          id: "cgt-2",
+          status: "succeeded",
+          content: { video_url: "https://videos.example/clip.mp4" },
+        }),
+      )
+      .mockResolvedValueOnce(videoResponse(new Uint8Array([7])));
+    vi.stubGlobal("fetch", fetchSpy);
+
+    await generateWithArkVideo(
+      { ...baseInput, image: { buffer: Buffer.from([9, 9]), mimeType: "image/png" } },
+      "ark-key",
+    );
+
+    const content = requestBody(fetchSpy).content as Array<Record<string, unknown>>;
+    expect(content[1]).toMatchObject({ role: "first_frame" });
+    expect(String((content[1]!.image_url as { url: string }).url)).toContain(
+      "data:image/png;base64,",
+    );
+    // No `@ImageN` clause: an inline first frame IS the opening frame, so
+    // naming it in the prompt would only confuse the model.
+    expect(content[0]!.text).not.toContain("@Image1");
+  });
+
+  it("clamps the duration into the range Seedance accepts", async () => {
+    const fetchSpy = vi
+      .fn()
+      .mockResolvedValueOnce(jsonResponse({ id: "cgt-3" }))
+      .mockResolvedValueOnce(
+        jsonResponse({
+          id: "cgt-3",
+          status: "succeeded",
+          content: { video_url: "https://videos.example/clip.mp4" },
+        }),
+      )
+      .mockResolvedValueOnce(videoResponse(new Uint8Array([7])));
+    vi.stubGlobal("fetch", fetchSpy);
+
+    await generateWithArkVideo({ ...baseInput, durationSec: 45 }, "ark-key");
+    expect(requestBody(fetchSpy).duration).toBe(15);
+  });
+
+  it("explains the real-person rejection instead of passing it through raw", async () => {
+    const fetchSpy = vi.fn().mockResolvedValue(
+      jsonResponse(
+        {
+          error: {
+            code: "InputImageSensitiveContentDetected.PrivacyInformation",
+            message: "The input image content[1] may contain a real person.",
+          },
+        },
+        400,
+      ),
+    );
+    vi.stubGlobal("fetch", fetchSpy);
+
+    await expect(generateWithArkVideo(baseInput, "ark-key")).rejects.toThrow(
+      /Asset Library/,
+    );
+    // A rejected input is permanent, so the retry helper must not burn
+    // attempts on it: one call, not three.
+    expect(fetchSpy).toHaveBeenCalledTimes(1);
+  });
+
+  it("surfaces a failed task rather than returning an empty clip", async () => {
+    const fetchSpy = vi
+      .fn()
+      .mockResolvedValueOnce(jsonResponse({ id: "cgt-4" }))
+      .mockResolvedValueOnce(
+        jsonResponse({ id: "cgt-4", status: "failed", error: { message: "quota exceeded" } }),
+      );
+    vi.stubGlobal("fetch", fetchSpy);
+
+    await expect(generateWithArkVideo(baseInput, "ark-key")).rejects.toBeInstanceOf(
+      VideoGenProviderError,
+    );
+  });
+});
