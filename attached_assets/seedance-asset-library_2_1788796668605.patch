@@ -0,0 +1,299 @@
+import { describe, it, expect, vi, beforeEach, afterAll } from "vitest";
+
+// ByteDance owns the liveness check itself; these tests own the round trip —
+// what we persist, what we refuse, and what a tampered callback can do.
+const arkState = vi.hoisted(() => ({
+  configured: true,
+  sessionError: null as Error | null,
+  groupError: null as Error | null,
+  callbackUrls: [] as string[],
+  groupLookups: [] as string[],
+}));
+
+vi.mock("./ark/assets", () => ({
+  ARK_VERIFY_SUCCESS_CODE: "10000",
+  ARK_BYTED_TOKEN_TTL_MS: 30 * 60 * 1000,
+  ArkAssetsNotConfiguredError: class ArkAssetsNotConfiguredError extends Error {},
+  resolveArkAssetsCredentials: vi.fn(async () =>
+    arkState.configured
+      ? {
+          accessKeyId: "AKLTtest",
+          secretAccessKey: "secret",
+          region: "ap-southeast-1",
+          service: "ark",
+        }
+      : null,
+  ),
+  createVisualValidateSession: vi.fn(async (args: { callbackUrl: string }) => {
+    if (arkState.sessionError) throw arkState.sessionError;
+    arkState.callbackUrls.push(args.callbackUrl);
+    return { BytedToken: "byted-1", H5Link: "https://byteplus.example/verify?pl=x&lng=en" };
+  }),
+  getVisualValidateResult: vi.fn(async (args: { bytedToken: string }) => {
+    if (arkState.groupError) throw arkState.groupError;
+    arkState.groupLookups.push(args.bytedToken);
+    return "group-liveness-1";
+  }),
+}));
+
+import { db, arkIdentitiesTable } from "@workspace/db";
+import { eq } from "drizzle-orm";
+import { createTenant, deleteTenant, type TestTenant } from "../test/dbHelpers";
+import {
+  startIdentityVerification,
+  completeIdentityVerification,
+  signIdentityState,
+  verifyIdentityState,
+  verifiedGroupId,
+} from "./arkIdentity";
+import { getVisualValidateResult } from "./ark/assets";
+
+const CALLBACK_BASE = "https://kokao.example/api/characters/identities/callback";
+const createdTenants: TestTenant[] = [];
+
+async function newTenant(): Promise<TestTenant> {
+  const tenant = await createTenant();
+  createdTenants.push(tenant);
+  return tenant;
+}
+
+/** The state segment the callback URL ends with. */
+function stateFrom(callbackUrl: string): string {
+  return callbackUrl.slice(CALLBACK_BASE.length + 1);
+}
+
+beforeEach(() => {
+  arkState.configured = true;
+  arkState.sessionError = null;
+  arkState.groupError = null;
+  arkState.callbackUrls.length = 0;
+  arkState.groupLookups.length = 0;
+  vi.mocked(getVisualValidateResult).mockClear();
+  process.env.SESSION_SECRET ||= "test-secret-for-local-suite";
+});
+
+afterAll(async () => {
+  for (const tenant of createdTenants) {
+    await db
+      .delete(arkIdentitiesTable)
+      .where(eq(arkIdentitiesTable.tenantId, tenant.tenantId));
+    await deleteTenant(tenant.tenantId);
+  }
+});
+
+describe("identity state token", () => {
+  it("round-trips the tenant and identity it was issued for", () => {
+    const state = signIdentityState(7, 42);
+    expect(verifyIdentityState(state)).toEqual({ tenantId: 7, identityId: 42 });
+  });
+
+  it("rejects a tampered token", () => {
+    const state = signIdentityState(7, 42);
+    const tampered = Buffer.from(
+      Buffer.from(state, "base64url").toString("utf8").replace("7.", "8."),
+      "utf8",
+    ).toString("base64url");
+    expect(verifyIdentityState(tampered)).toBeNull();
+  });
+});
+
+describe("startIdentityVerification", () => {
+  it("creates a pending row and puts the signed state in the callback PATH", async () => {
+    const tenant = await newTenant();
+    const started = await startIdentityVerification({
+      tenantId: tenant.tenantId,
+      label: "Abhilash",
+      callbackBaseUrl: CALLBACK_BASE,
+    });
+
+    expect(started.identity.status).toBe("pending");
+    expect(started.identity.assetGroupId).toBeNull();
+    expect(started.h5Link).toContain("https://byteplus.example/verify");
+
+    // Path, not query: ByteDance appends its own parameters with a literal
+    // "?", so a callback URL carrying a query string would arrive broken.
+    const callbackUrl = arkState.callbackUrls[0]!;
+    expect(callbackUrl.startsWith(`${CALLBACK_BASE}/`)).toBe(true);
+    expect(callbackUrl).not.toContain("?");
+    expect(verifyIdentityState(stateFrom(callbackUrl))).toEqual({
+      tenantId: tenant.tenantId,
+      identityId: started.identity.id,
+    });
+  });
+
+  it("marks the row failed when no link could be issued", async () => {
+    const tenant = await newTenant();
+    arkState.sessionError = new Error("Advanced Creation Rights are not activated");
+
+    await expect(
+      startIdentityVerification({
+        tenantId: tenant.tenantId,
+        label: "Abhilash",
+        callbackBaseUrl: CALLBACK_BASE,
+      }),
+    ).rejects.toThrow(/Advanced Creation Rights/);
+
+    // A session with no link can never be completed; leaving it "pending"
+    // would show the tenant a verification that will never resolve.
+    const rows = await db
+      .select()
+      .from(arkIdentitiesTable)
+      .where(eq(arkIdentitiesTable.tenantId, tenant.tenantId));
+    expect(rows[0]!.status).toBe("failed");
+    expect(rows[0]!.error).toContain("Advanced Creation Rights");
+  });
+
+  it("refuses to start when the Asset Library is not configured", async () => {
+    const tenant = await newTenant();
+    arkState.configured = false;
+    await expect(
+      startIdentityVerification({
+        tenantId: tenant.tenantId,
+        label: "Abhilash",
+        callbackBaseUrl: CALLBACK_BASE,
+      }),
+    ).rejects.toThrow();
+  });
+});
+
+describe("completeIdentityVerification", () => {
+  async function start(tenantId: number) {
+    const started = await startIdentityVerification({
+      tenantId,
+      label: "Abhilash",
+      callbackBaseUrl: CALLBACK_BASE,
+    });
+    return { identityId: started.identity.id, state: stateFrom(arkState.callbackUrls[0]!) };
+  }
+
+  it("stores the group ByteDance issued and marks the person verified", async () => {
+    const tenant = await newTenant();
+    const { identityId, state } = await start(tenant.tenantId);
+
+    const outcome = await completeIdentityVerification({
+      state,
+      bytedToken: "byted-1",
+      resultCode: "10000",
+    });
+    expect(outcome).toEqual({ ok: true, identityId, reason: null });
+
+    const row = (
+      await db.select().from(arkIdentitiesTable).where(eq(arkIdentitiesTable.id, identityId))
+    )[0]!;
+    expect(row.status).toBe("verified");
+    expect(row.assetGroupId).toBe("group-liveness-1");
+    expect(row.verifiedAt).not.toBeNull();
+  });
+
+  it("does not look up a group when ByteDance said no", async () => {
+    const tenant = await newTenant();
+    const { identityId, state } = await start(tenant.tenantId);
+
+    const outcome = await completeIdentityVerification({
+      state,
+      bytedToken: "byted-1",
+      resultCode: "60001",
+    });
+    expect(outcome.ok).toBe(false);
+    expect(outcome.reason).toBe("verification_failed");
+    // Only resultCode 10000 means verified; anything else must not be turned
+    // into a group by asking anyway.
+    expect(getVisualValidateResult).not.toHaveBeenCalled();
+
+    const row = (
+      await db.select().from(arkIdentitiesTable).where(eq(arkIdentitiesTable.id, identityId))
+    )[0]!;
+    expect(row.status).toBe("failed");
+    expect(row.assetGroupId).toBeNull();
+    expect(row.resultCode).toBe("60001");
+  });
+
+  it("rejects a callback whose state does not verify", async () => {
+    const tenant = await newTenant();
+    await start(tenant.tenantId);
+
+    const outcome = await completeIdentityVerification({
+      state: "not-a-real-state",
+      bytedToken: "byted-1",
+      resultCode: "10000",
+    });
+    expect(outcome).toEqual({ ok: false, identityId: null, reason: "invalid_state" });
+    expect(getVisualValidateResult).not.toHaveBeenCalled();
+  });
+
+  it("rejects a state signed for a different tenant's identity", async () => {
+    const tenantA = await newTenant();
+    const tenantB = await newTenant();
+    const { identityId } = await start(tenantA.tenantId);
+
+    // Correctly signed, but naming the other tenant — the row lookup is scoped
+    // by tenant, so this must not resolve.
+    const outcome = await completeIdentityVerification({
+      state: signIdentityState(tenantB.tenantId, identityId),
+      bytedToken: "byted-1",
+      resultCode: "10000",
+    });
+    expect(outcome.reason).toBe("unknown_identity");
+    expect(getVisualValidateResult).not.toHaveBeenCalled();
+  });
+
+  it("is idempotent — a re-opened callback link changes nothing", async () => {
+    const tenant = await newTenant();
+    const { identityId, state } = await start(tenant.tenantId);
+
+    await completeIdentityVerification({ state, bytedToken: "byted-1", resultCode: "10000" });
+    const outcome = await completeIdentityVerification({
+      state,
+      bytedToken: "stale-token",
+      resultCode: "10000",
+    });
+
+    expect(outcome).toEqual({ ok: true, identityId, reason: null });
+    // The second call must not re-query with a stale token and overwrite a
+    // good group id.
+    expect(arkState.groupLookups).toEqual(["byted-1"]);
+  });
+
+  it("records a group-lookup failure without claiming the person is verified", async () => {
+    const tenant = await newTenant();
+    const { identityId, state } = await start(tenant.tenantId);
+    arkState.groupError = new Error("BytedToken expired");
+
+    const outcome = await completeIdentityVerification({
+      state,
+      bytedToken: "byted-1",
+      resultCode: "10000",
+    });
+    expect(outcome.ok).toBe(false);
+    expect(outcome.reason).toBe("group_lookup_failed");
+
+    const row = (
+      await db.select().from(arkIdentitiesTable).where(eq(arkIdentitiesTable.id, identityId))
+    )[0]!;
+    expect(row.status).toBe("failed");
+    expect(row.error).toContain("BytedToken expired");
+  });
+});
+
+describe("verifiedGroupId", () => {
+  it("only yields a group for someone actually verified", () => {
+    const base = {
+      id: 1,
+      tenantId: 1,
+      label: "Abhilash",
+      resultCode: null,
+      error: null,
+      verifiedAt: null,
+      createdAt: new Date(),
+      updatedAt: new Date(),
+    };
+    expect(verifiedGroupId(undefined)).toBeNull();
+    expect(verifiedGroupId({ ...base, status: "pending", assetGroupId: null })).toBeNull();
+    // A group id on a non-verified row is not usable — the row only reaches
+    // "verified" once ByteDance confirmed the person.
+    expect(verifiedGroupId({ ...base, status: "failed", assetGroupId: "group-1" })).toBeNull();
+    expect(verifiedGroupId({ ...base, status: "verified", assetGroupId: "group-1" })).toBe(
+      "group-1",
+    );
+  });
+});
