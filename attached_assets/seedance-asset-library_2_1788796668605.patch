+++ b/artifacts/api-server/src/lib/arkIdentity.ts
@@ -0,0 +1,212 @@
+import { db, arkIdentitiesTable } from "@workspace/db";
+import type { ArkIdentity } from "@workspace/db";
+import { and, asc, eq } from "drizzle-orm";
+import { signOAuthState, verifySignedOAuthState } from "./oauthState";
+import {
+  createVisualValidateSession,
+  getVisualValidateResult,
+  resolveArkAssetsCredentials,
+  ARK_VERIFY_SUCCESS_CODE,
+  ARK_BYTED_TOKEN_TTL_MS,
+  ArkAssetsNotConfiguredError,
+} from "./ark/assets";
+
+/**
+ * Real-person verification, from our side.
+ *
+ * ByteDance owns the actual check; this module owns the round trip. A row is
+ * created the moment a session starts so the callback has somewhere to land,
+ * and the tenant binding travels in an HMAC-signed state token rather than a
+ * session cookie — the person may finish the check on their phone, in a
+ * browser that has never seen this app.
+ *
+ * The state rides in the callback's PATH, not its query string. ByteDance
+ * appends its parameters with a literal `?`, so a callback URL that already
+ * had a query string would come back malformed.
+ */
+
+/** How long a started verification stays claimable. Matches BytedToken's life. */
+const VERIFICATION_STATE_TTL_MS = ARK_BYTED_TOKEN_TTL_MS;
+
+export class ArkIdentityError extends Error {}
+
+export interface StartedVerification {
+  identity: ArkIdentity;
+  /** The ByteDance-hosted page the person must open to verify. */
+  h5Link: string;
+}
+
+/** The signed token that binds a callback to the tenant and row that started it. */
+export function signIdentityState(tenantId: number, identityId: number): string {
+  return signOAuthState(tenantId, String(identityId));
+}
+
+export function verifyIdentityState(
+  state: string,
+): { tenantId: number; identityId: number } | null {
+  const verified = verifySignedOAuthState(state, VERIFICATION_STATE_TTL_MS);
+  if (!verified) return null;
+  const identityId = Number(verified.data);
+  if (!Number.isInteger(identityId) || identityId <= 0) return null;
+  return { tenantId: verified.tenantId, identityId };
+}
+
+/**
+ * Begin verifying one person.
+ *
+ * `callbackBaseUrl` is this deployment's public origin plus the callback path;
+ * the signed state is appended as a final path segment. Returns the link for
+ * the person to open — nothing is verified until they finish.
+ */
+export async function startIdentityVerification(params: {
+  tenantId: number;
+  label: string;
+  callbackBaseUrl: string;
+}): Promise<StartedVerification> {
+  const credentials = await resolveArkAssetsCredentials();
+  if (!credentials) throw new ArkAssetsNotConfiguredError();
+
+  const identity = (
+    await db
+      .insert(arkIdentitiesTable)
+      .values({ tenantId: params.tenantId, label: params.label, status: "pending" })
+      .returning()
+  )[0]!;
+
+  try {
+    const state = signIdentityState(params.tenantId, identity.id);
+    const { H5Link } = await createVisualValidateSession(
+      { callbackUrl: `${params.callbackBaseUrl.replace(/\/+$/, "")}/${state}` },
+      credentials,
+    );
+    return { identity, h5Link: H5Link };
+  } catch (err) {
+    // A session that never produced a link is noise in the tenant's list, and
+    // it can never be completed — mark it rather than leaving it pending.
+    await db
+      .update(arkIdentitiesTable)
+      .set({
+        status: "failed",
+        error: err instanceof Error ? err.message.slice(0, 500) : "Could not start verification.",
+      })
+      .where(eq(arkIdentitiesTable.id, identity.id))
+      .catch(() => {});
+    throw err;
+  }
+}
+
+export interface VerificationOutcome {
+  ok: boolean;
+  identityId: number | null;
+  reason: string | null;
+}
+
+/**
+ * Finish the round trip: validate the state, read ByteDance's verdict, and on
+ * success resolve the asset group they created for this person.
+ *
+ * Returns an outcome rather than throwing — this runs in a browser redirect,
+ * where the only sensible response is a redirect back into the app either way.
+ */
+export async function completeIdentityVerification(params: {
+  state: string;
+  bytedToken: string | undefined;
+  resultCode: string | undefined;
+}): Promise<VerificationOutcome> {
+  const verified = verifyIdentityState(params.state);
+  if (!verified) return { ok: false, identityId: null, reason: "invalid_state" };
+
+  const identity = (
+    await db
+      .select()
+      .from(arkIdentitiesTable)
+      .where(
+        and(
+          eq(arkIdentitiesTable.id, verified.identityId),
+          eq(arkIdentitiesTable.tenantId, verified.tenantId),
+        ),
+      )
+      .limit(1)
+  )[0];
+  if (!identity) return { ok: false, identityId: null, reason: "unknown_identity" };
+  // Already done: a re-opened callback link must not start a second lookup or
+  // overwrite a good group id with a stale one.
+  if (identity.status === "verified" && identity.assetGroupId) {
+    return { ok: true, identityId: identity.id, reason: null };
+  }
+
+  const fail = async (reason: string, message: string): Promise<VerificationOutcome> => {
+    await db
+      .update(arkIdentitiesTable)
+      .set({ status: "failed", resultCode: params.resultCode ?? null, error: message })
+      .where(eq(arkIdentitiesTable.id, identity.id))
+      .catch(() => {});
+    return { ok: false, identityId: identity.id, reason };
+  };
+
+  if (params.resultCode !== ARK_VERIFY_SUCCESS_CODE) {
+    return fail(
+      "verification_failed",
+      `ByteDance did not confirm the identity (resultCode ${params.resultCode ?? "missing"}). The person can try again with a fresh link.`,
+    );
+  }
+  if (!params.bytedToken) {
+    return fail("missing_token", "The verification callback carried no token.");
+  }
+
+  const credentials = await resolveArkAssetsCredentials();
+  if (!credentials) return fail("not_configured", "The Asset Library is not configured.");
+
+  try {
+    const groupId = await getVisualValidateResult(
+      { bytedToken: params.bytedToken },
+      credentials,
+    );
+    await db
+      .update(arkIdentitiesTable)
+      .set({
+        assetGroupId: groupId,
+        status: "verified",
+        resultCode: params.resultCode ?? null,
+        error: null,
+        verifiedAt: new Date(),
+      })
+      .where(eq(arkIdentitiesTable.id, identity.id));
+    return { ok: true, identityId: identity.id, reason: null };
+  } catch (err) {
+    return fail(
+      "group_lookup_failed",
+      err instanceof Error ? err.message.slice(0, 500) : "Could not resolve the asset group.",
+    );
+  }
+}
+
+export async function listIdentities(tenantId: number): Promise<ArkIdentity[]> {
+  return db
+    .select()
+    .from(arkIdentitiesTable)
+    .where(eq(arkIdentitiesTable.tenantId, tenantId))
+    .orderBy(asc(arkIdentitiesTable.id));
+}
+
+export async function getIdentity(
+  tenantId: number,
+  identityId: number,
+): Promise<ArkIdentity | undefined> {
+  return (
+    await db
+      .select()
+      .from(arkIdentitiesTable)
+      .where(
+        and(eq(arkIdentitiesTable.id, identityId), eq(arkIdentitiesTable.tenantId, tenantId)),
+      )
+      .limit(1)
+  )[0];
+}
+
+/** The group a verified person's images belong in, or null when not usable yet. */
+export function verifiedGroupId(identity: ArkIdentity | undefined): string | null {
+  if (!identity) return null;
+  if (identity.status !== "verified") return null;
+  return identity.assetGroupId ?? null;
+}
