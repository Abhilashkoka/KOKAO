+++ b/artifacts/api-server/src/lib/videoGen/providers/ark.ts
@@ -0,0 +1,250 @@
+import {
+  videoGenFetch,
+  errorDetail,
+  VideoGenNotConfiguredError,
+  VideoGenProviderError,
+  VIDEO_GEN_TOTAL_DEADLINE_MS,
+  type VideoGenInput,
+  type VideoGenResult,
+} from "../types";
+import { withRetries, isTransientStatus } from "../retry";
+import { assetUri } from "../../ark/uri";
+
+/**
+ * Seedance on BytePlus ModelArk, direct.
+ *
+ * This provider exists for one capability the resold routes cannot offer:
+ * passing Asset Library ids. Reference images sent inline are screened for
+ * real people on every request, and photorealistic character sheets are
+ * rejected as possible real humans; an asset that has cleared review once is
+ * trusted from then on. `input.assetRefs` carries those ids — see
+ * lib/ark/assets.ts for how they are minted.
+ *
+ * Asset ids are scoped to the ModelArk account that created them, so the key
+ * used here must belong to the same account as the Asset Library credentials.
+ */
+
+/** Seedance 2.5 — the current flagship; both engines default to it. */
+export const ARK_T2V_MODEL = "dreamina-seedance-2-5-260628";
+export const ARK_I2V_MODEL = "dreamina-seedance-2-5-260628";
+
+const DEFAULT_ARK_BASE_URL = "https://ark.ap-southeast.bytepluses.com/api/v3";
+
+/** Seedance accepts 4–15s; anything outside is a 400. */
+const MIN_DURATION_SEC = 4;
+const MAX_DURATION_SEC = 15;
+
+/** Task states that mean "still working". */
+const PENDING_STATUSES = new Set(["queued", "running", "pending", "processing"]);
+
+/** Gap between polls of a task that is still queued or running. */
+const POLL_INTERVAL_MS = 5_000;
+
+interface ArkTaskCreated {
+  id?: string;
+  error?: { code?: string; message?: string };
+}
+
+interface ArkTask {
+  id?: string;
+  status?: string;
+  error?: { code?: string; message?: string };
+  content?: { video_url?: string };
+}
+
+interface ArkContentEntry {
+  type: "text" | "image_url";
+  text?: string;
+  image_url?: { url: string };
+  role?: string;
+}
+
+function arkBaseUrl(): string {
+  return (process.env.ARK_BASE_URL?.trim() || DEFAULT_ARK_BASE_URL).replace(/\/+$/, "");
+}
+
+function clampDuration(durationSec: number): number {
+  const wanted = Math.round(durationSec);
+  if (!Number.isFinite(wanted)) return MIN_DURATION_SEC;
+  return Math.min(MAX_DURATION_SEC, Math.max(MIN_DURATION_SEC, wanted));
+}
+
+/**
+ * How the prompt names the Nth image in `content` (1-based).
+ *
+ * Seedance addresses reference material positionally, and BytePlus documents
+ * two spellings for it: the video-generation API reference uses `@Image1` in
+ * its own request body, while the real-human asset guide says to write
+ * "image 1" and explicitly warns against putting the asset id in the prompt.
+ * Both appear in official API samples, so this is the one place to switch if
+ * a live call disagrees with the choice made here.
+ */
+export function assetReferenceLabel(index: number): string {
+  return `@Image${index}`;
+}
+
+/**
+ * Name each reference in the prompt — without this the references are
+ * decorative. One asset means one identity clause; several (a character plus
+ * per-costume stills, or a verified person's stills) are named as the same
+ * person so the model treats the group as one subject.
+ */
+export function withAssetReferences(prompt: string, imageCount: number): string {
+  if (imageCount <= 0) return prompt;
+  const refs = Array.from({ length: imageCount }, (_, i) => assetReferenceLabel(i + 1));
+  const clause =
+    refs.length === 1
+      ? `The subject is the person shown in ${refs[0]}; keep their face, hair, and body identical.`
+      : `The subject is the person shown in ${refs.slice(0, -1).join(", ")} and ${refs.at(-1)} ` +
+        "(the same person in each); keep their face, hair, and body identical.";
+  return `${prompt.trim()}\n\n${clause}`;
+}
+
+/**
+ * Rewrite the model's real-person rejection into an instruction the operator
+ * can act on. Left as a permanent (non-transient) failure on purpose: every
+ * model on the account rejects the same input, so walking the model chain
+ * would only burn time and money.
+ */
+function describeArkFailure(detail: string): string {
+  if (/InputImageSensitiveContentDetected|may contain a real person/i.test(detail)) {
+    return (
+      "Seedance rejected the reference image as a possible real person. " +
+      "Register the character in the ModelArk Asset Library and generate from " +
+      "its asset id instead of sending the image inline."
+    );
+  }
+  return detail;
+}
+
+/**
+ * Submit a Seedance generation task, poll it, and download the clip.
+ *
+ * Reference material is passed as `asset://<id>` when the caller supplies
+ * asset ids, and only falls back to an inline data URI when it has none —
+ * the inline path is what trips the real-person filter.
+ */
+export async function generateWithArkVideo(
+  input: VideoGenInput,
+  apiKey: string | null,
+): Promise<VideoGenResult> {
+  if (!apiKey) {
+    throw new VideoGenNotConfiguredError(
+      "ByteDance ModelArk is not configured: save an API key in the admin dashboard or set the ARK_API_KEY secret.",
+    );
+  }
+  const tasksUrl = `${arkBaseUrl()}/contents/generations/tasks`;
+  const headers = {
+    Authorization: `Bearer ${apiKey}`,
+    "Content-Type": "application/json",
+  };
+
+  const assetRefs = input.assetRefs ?? [];
+  const images: ArkContentEntry[] = assetRefs.map((id) => ({
+    type: "image_url",
+    image_url: { url: assetUri(id) },
+    role: "reference_image",
+  }));
+  if (images.length === 0 && input.image) {
+    images.push({
+      type: "image_url",
+      image_url: {
+        url: `data:${input.image.mimeType};base64,${input.image.buffer.toString("base64")}`,
+      },
+      role: "first_frame",
+    });
+  }
+
+  // Only asset-backed references are named in the prompt. An inline
+  // first_frame is the literal opening frame and needs no `@ImageN` clause.
+  const prompt =
+    assetRefs.length > 0 ? withAssetReferences(input.prompt, images.length) : input.prompt.trim();
+
+  const body = {
+    model: input.model,
+    content: [{ type: "text", text: prompt } satisfies ArkContentEntry, ...images],
+    ratio: input.aspectRatio,
+    duration: clampDuration(input.durationSec),
+    watermark: false,
+    ...(assetRefs.length > 0 ? { omni_reference_task_type: "reference" } : {}),
+  };
+
+  const created = await withRetries(
+    async (): Promise<ArkTaskCreated> => {
+      const res = await videoGenFetch(tasksUrl, {
+        method: "POST",
+        headers,
+        body: JSON.stringify(body),
+      });
+      if (!res.ok) {
+        const detail = await errorDetail(res);
+        throw new VideoGenProviderError(
+          `ModelArk video request failed (${res.status}): ${describeArkFailure(detail)}`,
+          res.status,
+        );
+      }
+      return (await res.json()) as ArkTaskCreated;
+    },
+    { attempts: 3 },
+  );
+  if (!created.id) {
+    throw new VideoGenProviderError("ModelArk returned no video task id.");
+  }
+
+  const pollUrl = `${tasksUrl}/${created.id}`;
+  const deadline = Date.now() + VIDEO_GEN_TOTAL_DEADLINE_MS;
+  let task: ArkTask = { id: created.id, status: "queued" };
+  let consecutivePollFailures = 0;
+  // Poll first, sleep between rounds. Ark's create returns only an id (no
+  // status), so sleeping first would add a fixed 5s to every clip — including
+  // the ones that are already done.
+  let firstPoll = true;
+  while (PENDING_STATUSES.has(task.status ?? "queued") && Date.now() < deadline) {
+    if (!firstPoll) await new Promise((r) => setTimeout(r, POLL_INTERVAL_MS));
+    firstPoll = false;
+    try {
+      const poll = await videoGenFetch(pollUrl, { method: "GET", headers });
+      if (!poll.ok) {
+        throw new VideoGenProviderError(
+          `ModelArk video polling failed (${poll.status}): ${await errorDetail(poll)}`,
+          poll.status,
+        );
+      }
+      task = (await poll.json()) as ArkTask;
+      consecutivePollFailures = 0;
+    } catch (error) {
+      const transient =
+        !(error instanceof VideoGenProviderError) || isTransientStatus(error.status);
+      consecutivePollFailures += 1;
+      if (!transient || consecutivePollFailures >= 3) throw error;
+    }
+  }
+
+  if (task.status !== "succeeded") {
+    const detail = task.error?.message ?? task.error?.code ?? task.status ?? "unknown status";
+    throw new VideoGenProviderError(
+      `ModelArk video task did not complete: ${describeArkFailure(detail)}`,
+    );
+  }
+  const url = task.content?.video_url;
+  if (!url) {
