+            outfit({
+              id: 12,
+              name: "Raincoat",
+              status: "Failed",
+              error: "ModelArk rejected the image. It may read as a real person.",
+            }),
+          ],
+        },
+      ],
+    };
+    renderCard();
+    expect(screen.getByTestId("badge-ark-asset-active-11")).toBeTruthy();
+    expect(screen.getByTestId("badge-ark-asset-failed-12")).toBeTruthy();
+    // The upstream reason is the whole point of the row — an admin cannot act
+    // on "Failed" alone.
+    expect(screen.getByTestId("row-ark-outfit-12").textContent).toMatch(/real person/i);
+  });
+
+  it("marks an unregistered outfit rather than leaving the row blank", () => {
+    mockState.view = {
+      keySource: "database",
+      identities: [],
+      characters: [
+        {
+          id: 7,
+          tenantId: 3,
+          name: "Nila",
+          assetGroupId: null,
+          identityId: null,
+          referenceSource: "generated",
+          outfits: [outfit({ id: 11 })],
+        },
+      ],
+    };
+    renderCard();
+    expect(screen.getByTestId("badge-ark-asset-none-11")).toBeTruthy();
+    expect(screen.getByTestId("row-ark-character-7").textContent).toContain(
+      "No asset group",
+    );
+  });
+
+  it("retries registration for the character whose button was pressed", async () => {
+    mockState.view = {
+      keySource: "database",
+      identities: [],
+      characters: [
+        {
+          id: 7,
+          tenantId: 3,
+          name: "Nila",
+          assetGroupId: "group-1",
+          identityId: null,
+          referenceSource: "generated",
+          outfits: [outfit({ id: 11, status: "Failed", error: "quota exceeded" })],
+        },
+      ],
+    };
+    renderCard();
+    await userEvent.click(screen.getByTestId("button-ark-register-7"));
+    expect(registerMutate).toHaveBeenCalledWith(
+      { characterId: 7 },
+      expect.anything(),
+    );
+  });
+
+  it("lists verified people and shows who is still mid-verification", () => {
+    mockState.view = {
+      keySource: "database",
+      identities: [
+        {
+          id: 1,
+          tenantId: 3,
+          label: "Abhilash",
+          status: "verified",
+          assetGroupId: "group-liveness-1",
+          error: null,
+          verifiedAt: new Date().toISOString(),
+        },
+        {
+          id: 2,
+          tenantId: 3,
+          label: "Priya",
+          status: "pending",
+          assetGroupId: null,
+          error: null,
+          verifiedAt: null,
+        },
+      ],
+      characters: [],
+    };
+    renderCard();
+    expect(screen.getByTestId("badge-ark-identity-verified-1")).toBeTruthy();
+    // "Awaiting the person" rather than a retry: the liveness check is theirs
+    // to complete, and there is nothing an admin can press.
+    expect(screen.getByTestId("row-ark-identity-2").textContent).toMatch(/awaiting the person/i);
+  });
+
+  it("flags an uploaded photo that has no verified person behind it", () => {
+    mockState.view = {
+      keySource: "database",
+      identities: [],
+      characters: [
+        {
+          id: 8,
+          tenantId: 3,
+          name: "Me",
+          assetGroupId: null,
+          identityId: null,
+          referenceSource: "uploaded",
+          outfits: [outfit({ id: 21 })],
+        },
+      ],
+    };
+    renderCard();
+    // This one will never register, by design — the badge says why, so nobody
+    // goes hunting for a ModelArk problem that does not exist.
+    expect(screen.getByTestId("badge-ark-unverified-upload-8")).toBeTruthy();
+  });
+
+  it("marks a character that is a verified real person", () => {
+    mockState.view = {
+      keySource: "database",
+      identities: [],
+      characters: [
+        {
+          id: 9,
+          tenantId: 3,
+          name: "Me",
+          assetGroupId: null,
+          identityId: 1,
+          referenceSource: "uploaded",
+          outfits: [outfit({ id: 22, assetId: "asset-9", status: "Active" })],
+        },
+      ],
+    };
+    renderCard();
+    expect(screen.getByTestId("badge-ark-real-person-9")).toBeTruthy();
+    // Their images live in the identity's group, so "No asset group" would be
+    // misleading here.
+    expect(screen.getByTestId("row-ark-character-9").textContent).not.toContain(
+      "No asset group",
+    );
+  });
+
+  it("refuses to submit a half-filled key pair", async () => {
+    renderCard();
+    await userEvent.type(screen.getByTestId("input-ark-access-key-id"), "AKLTtest");
+    await userEvent.click(screen.getByTestId("button-save-ark-key"));
+    expect(setKeyMutate).not.toHaveBeenCalled();
+  });
+});
