diff --git a/lib/db/src/schema/arkIdentities.ts b/lib/db/src/schema/arkIdentities.ts
new file mode 100644
index 0000000..3cbbc72
--- /dev/null
+++ b/lib/db/src/schema/arkIdentities.ts
@@ -0,0 +1,48 @@
+import { pgTable, text, serial, integer, timestamp } from "drizzle-orm/pg-core";
+
+/**
+ * Verified real people, for putting a genuine face in a generated video.
+ *
+ * Seedance refuses raw photographs of real people. The one sanctioned route is
+ * ByteDance's real-human asset library: the person completes a liveness check
+ * on a ByteDance-hosted page, and ByteDance creates an asset group that is
+ * bound to them. Portrait rights are secured at the source — which is why a
+ * consent checkbox in our own UI cannot stand in for this.
+ *
+ * One row per verified person, holding the group ByteDance issued. Their
+ * images (a base sheet, each later look) all go into that one group, and every
+ * upload is face-matched against the reference captured during the check, so
+ * one person's group can never quietly accumulate someone else's face.
+ *
+ * Deliberately NOT storing the BytedToken: it lives 30 minutes, is only needed
+ * between the redirect and the group lookup, and arrives on the callback
+ * itself. Nothing here is a credential.
+ */
+
+export const arkIdentitiesTable = pgTable("ark_identities", {
+  id: serial("id").primaryKey(),
+  tenantId: integer("tenant_id").notNull(),
+  /** How the workspace refers to this person (e.g. "Abhilash"). Display only. */
+  label: text("label").notNull().default(""),
+  /**
+   * The LivenessFace asset group ByteDance created for this person. Null until
+   * verification completes — a row exists from the moment the session starts
+   * so the callback has something to attach its result to.
+   */
+  assetGroupId: text("asset_group_id"),
+  /** "pending" | "verified" | "failed" */
+  status: text("status").notNull().default("pending"),
+  /** ByteDance's resultCode from the callback; "10000" means success. */
+  resultCode: text("result_code"),
+  /** Why verification failed, in words, for the person who has to fix it. */
+  error: text("error"),
+  /** When the person actually passed the liveness check. */
+  verifiedAt: timestamp("verified_at", { withTimezone: true }),
+  createdAt: timestamp("created_at", { withTimezone: true }).notNull().defaultNow(),
+  updatedAt: timestamp("updated_at", { withTimezone: true })
+    .notNull()
+    .defaultNow()
+    .$onUpdate(() => new Date()),
+});
+
+export type ArkIdentity = typeof arkIdentitiesTable.$inferSelect;
