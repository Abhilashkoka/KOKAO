     sceneMap: params.scenes.map((scene, i) => ({
       clipIndex: i,
       durationSec: scene.durationSec,
+      ...(synced[i] ? { lipSynced: true } : {}),
     })),
     provider: provider || "replicate",
     model: model || "image-to-video",
