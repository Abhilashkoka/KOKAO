@@ -0,0 +1,42 @@
+import { describe, it, expect } from "vitest";
+import { videoJobUnits } from "./units";
+import { CHARACTER_SCENES_PER_PARAGRAPH } from "./topicVideo/characterScenes";
+
+describe("character lip-sync pricing", () => {
+  it("doubles a character video that speaks", () => {
+    const narrated = videoJobUnits("topic_to_video", {
+      visualsSource: "character",
+      paragraphCount: 2,
+    } as never);
+    const spoken = videoJobUnits("topic_to_video", {
+      visualsSource: "character",
+      paragraphCount: 2,
+      characterLipSync: true,
+    } as never);
+    // Every scene gains a sync call on top of its image-to-video call.
+    expect(spoken).toBe(narrated * 2);
+  });
+
+  it("leaves other engines untouched by the flag", () => {
+    for (const visualsSource of ["ai", "ai_video", "stock"] as const) {
+      const base = videoJobUnits("topic_to_video", { visualsSource, paragraphCount: 2 } as never);
+      const flagged = videoJobUnits("topic_to_video", {
+        visualsSource,
+        paragraphCount: 2,
+        characterLipSync: true,
+      } as never);
+      expect(flagged).toBe(base);
+    }
+  });
+
+  it("still counts scenes added during review", () => {
+    expect(
+      videoJobUnits("topic_to_video", {
+        visualsSource: "character",
+        paragraphCount: 1,
+        characterLipSync: true,
+        addedScenes: 3,
+      } as never),
+    ).toBe(CHARACTER_SCENES_PER_PARAGRAPH * 2 + 3);
+  });
+});
