+    const model = models[i]!;
+    try {
+      const result = await def.generate(
+        {
+          prompt: params.prompt,
+          aspectRatio: params.aspectRatio,
+          durationSec: params.durationSec,
+          model,
+          image: params.mode === "image" ? params.image : undefined,
