+import { useEffect, useMemo, useState } from "react";
+import {
+  useUpdateContent,
+  usePublishContentToFacebook,
+  usePublishContentToInstagram,
+  usePublishContentToLinkedin,
+  usePublishContentToTwitter,
+  usePublishContentToThreads,
+  useCreateSchedule,
+  useGetFacebookCredentials,
+  useGetInstagramCredentials,
+  useGetLinkedinStatus,
+  useGetTwitterStatus,
+  useGetThreadsStatus,
+  getListContentQueryKey,
+  getListSchedulesQueryKey,
+} from "@workspace/api-client-react";
+import { useQueryClient } from "@tanstack/react-query";
+import {
+  Sheet,
+  SheetContent,
+  SheetDescription,
+  SheetHeader,
+  SheetTitle,
+} from "@/components/ui/sheet";
+import { Button } from "@/components/ui/button";
+import { Textarea } from "@/components/ui/textarea";
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import { Checkbox } from "@/components/ui/checkbox";
+import { RippleSpinner } from "@/components/ui/ripple-spinner";
+import { useToast } from "@/hooks/use-toast";
+import {
+  Send,
+  CalendarClock,
+  AlertCircle,
+  Info,
+  Facebook,
+  Instagram,
+  Linkedin,
+  Twitter,
+  AtSign,
+} from "lucide-react";
+import {
+  isOverTweetLimit,
+  splitIntoTweets,
+  isOverLinkedinLimit,
+  splitForLinkedin,
+  THREADS_MAX_LENGTH,
+  chunkOnWhitespace,
+} from "@workspace/social-limits";
+import { track } from "@/lib/analytics";
+
+/**
+ * The composer: one sheet that takes a content item from draft to published
+ * (or scheduled) on every selected platform, without leaving the page the
+ * user is on. Connection status, per-platform validation (via the shared
+ * social-limits helpers, so warnings always match what publish will do), and
+ * the now/schedule choice all live inline. The last platform selection is
+ * remembered per browser.
+ */
+
+export interface ComposerItem {
+  id: number;
+  title: string;
+  caption: string;
+  imagePath: string | null;
+  videoPath?: string | null;
+  videoThumbnailPath?: string | null;
+}
+
+type PlatformKey = "instagram" | "facebook" | "linkedin" | "twitter" | "threads";
+
+const PLATFORMS: { key: PlatformKey; label: string; icon: typeof Facebook }[] = [
+  { key: "instagram", label: "Instagram", icon: Instagram },
+  { key: "facebook", label: "Facebook", icon: Facebook },
+  { key: "linkedin", label: "LinkedIn", icon: Linkedin },
+  { key: "twitter", label: "X (Twitter)", icon: Twitter },
+  { key: "threads", label: "Threads", icon: AtSign },
+];
+
+const STORAGE_KEY = "kokao.composer.platforms";
+
+function loadRememberedPlatforms(): PlatformKey[] {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    const parsed = raw ? (JSON.parse(raw) as string[]) : [];
+    return PLATFORMS.map((p) => p.key).filter((k) => parsed.includes(k));
+  } catch {
+    return [];
+  }
+}
+
+function rememberPlatforms(keys: PlatformKey[]): void {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(keys));
+  } catch {
+    // Remembering defaults is best-effort.
+  }
+}
+
+/** Default schedule slot: one hour from now, on the next quarter hour. */
+function defaultScheduleAt(): { date: string; time: string } {
+  const at = new Date(Date.now() + 60 * 60 * 1000);
+  at.setMinutes(Math.ceil(at.getMinutes() / 15) * 15, 0, 0);
+  const pad = (n: number) => String(n).padStart(2, "0");
+  return {
+    date: `${at.getFullYear()}-${pad(at.getMonth() + 1)}-${pad(at.getDate())}`,
+    time: `${pad(at.getHours())}:${pad(at.getMinutes())}`,
+  };
+}
+
+export function ComposerSheet({
+  open,
+  onOpenChange,
+  item,
+}: {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  item: ComposerItem | null;
+}) {
+  const { toast } = useToast();
+  const queryClient = useQueryClient();
+
+  const updateContent = useUpdateContent();
+  const createSchedule = useCreateSchedule();
+  const publishFacebook = usePublishContentToFacebook();
+  const publishInstagram = usePublishContentToInstagram();
+  const publishLinkedin = usePublishContentToLinkedin();
+  const publishTwitter = usePublishContentToTwitter();
+  const publishThreads = usePublishContentToThreads();
+
+  const { data: fbStatus } = useGetFacebookCredentials();
+  const { data: igStatus } = useGetInstagramCredentials();
+  const { data: liStatus } = useGetLinkedinStatus();
+  const { data: twStatus } = useGetTwitterStatus();
+  const { data: thStatus } = useGetThreadsStatus();
+
+  const [caption, setCaption] = useState("");
+  const [selected, setSelected] = useState<PlatformKey[]>([]);
+  const [mode, setMode] = useState<"now" | "schedule">("now");
+  const [scheduleDate, setScheduleDate] = useState("");
+  const [scheduleTime, setScheduleTime] = useState("");
+  const [busy, setBusy] = useState(false);
+
+  // Same readiness rules the Studio and Library pages already apply.
+  const fbLive = !!fbStatus && fbStatus.appConfigured && fbStatus.verifyStatus === "verified";
+  const live: Record<PlatformKey, boolean> = {
+    facebook: fbLive,
+    // Instagram publishing rides on the Facebook Page token, so it needs both.
+    instagram:
+      fbLive && !!igStatus && igStatus.appConfigured && igStatus.verifyStatus === "verified",
+    linkedin: !!liStatus && liStatus.configured && liStatus.connected && !liStatus.expired,
+    twitter: !!twStatus && twStatus.configured && twStatus.connected && !twStatus.expired,
+    threads: !!thStatus && thStatus.configured && thStatus.connected && !thStatus.expired,
+  };
+
+  useEffect(() => {
+    if (!open || !item) return;
+    setCaption(item.caption);
+    const remembered = loadRememberedPlatforms().filter((k) => live[k]);
+    setSelected(remembered);
+    setMode("now");
+    const slot = defaultScheduleAt();
+    setScheduleDate(slot.date);
+    setScheduleTime(slot.time);
+    // Intentionally only when the sheet (re)opens for an item.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [open, item?.id]);
+
+  const toggle = (key: PlatformKey) =>
+    setSelected((prev) =>
+      prev.includes(key) ? prev.filter((k) => k !== key) : [...prev, key],
+    );
+
+  // Pre-publish checklist: blockers stop the action, infos just explain what
+  // will happen (threads/overflow behavior mirrors the server exactly).
+  const checklist = useMemo(() => {
+    const blockers: string[] = [];
+    const infos: string[] = [];
+    if (!item) return { blockers, infos };
+    const hasImage = !!item.imagePath;
+    if (selected.includes("instagram") && !hasImage) {
+      blockers.push(
+        item.videoPath
+          ? "Instagram video publishing isn't wired up yet — this item has no image to post."
+          : "Instagram needs an image. Generate or attach one first.",
+      );
+    }
+    if (selected.includes("twitter") && isOverTweetLimit(caption)) {
+      infos.push(
+        `X: over the character limit — will post as a thread of ${splitIntoTweets(caption).length} tweets.`,
+      );
+    }
+    if (selected.includes("linkedin") && isOverLinkedinLimit(caption)) {
+      infos.push(
+        `LinkedIn: long caption — the overflow continues in ${splitForLinkedin(caption).comments.length} comment(s).`,
+      );
+    }
+    if (selected.includes("threads") && caption.length > THREADS_MAX_LENGTH) {
+      infos.push(
+        `Threads: over the limit — will post as a chain of ${chunkOnWhitespace(caption, THREADS_MAX_LENGTH).length} posts.`,
+      );
+    }
+    return { blockers, infos };
+  }, [item, selected, caption]);
+
+  const scheduledAtDate = useMemo(() => {
+    if (!scheduleDate || !scheduleTime) return null;
+    const at = new Date(`${scheduleDate}T${scheduleTime}:00`);
+    return Number.isNaN(at.getTime()) ? null : at;
+  }, [scheduleDate, scheduleTime]);
+
+  const canSubmit =
+    !!item &&
+    !busy &&
+    selected.length > 0 &&
+    checklist.blockers.length === 0 &&
+    caption.trim().length > 0 &&
+    (mode === "now" || (scheduledAtDate !== null && scheduledAtDate > new Date()));
+
+  const publishMutations: Record<
+    PlatformKey,
+    { mutateAsync: (vars: { id: number }) => Promise<unknown> }
+  > = {
+    facebook: publishFacebook,
+    instagram: publishInstagram,
+    linkedin: publishLinkedin,
+    twitter: publishTwitter,
+    threads: publishThreads,
+  };
+
+  const onSubmit = async () => {
+    if (!item || !canSubmit) return;
+    setBusy(true);
+    rememberPlatforms(selected);
+    try {
+      // Persist caption edits first so every platform posts the same text.
+      if (caption !== item.caption) {
+        await updateContent.mutateAsync({ id: item.id, data: { caption } });
+      }
+
+      if (mode === "schedule") {
+        const failed: string[] = [];
+        for (const key of selected) {
+          try {
+            await createSchedule.mutateAsync({
+              data: {
+                contentItemId: item.id,
+                platform: key,
+                scheduledAt: scheduledAtDate!.toISOString(),
+              },
+            });
+            track("post_scheduled", { platform: key });
+          } catch {
+            failed.push(key);
+          }
+        }
+        queryClient.invalidateQueries({ queryKey: getListSchedulesQueryKey() });
+        queryClient.invalidateQueries({ queryKey: getListContentQueryKey() });
+        if (failed.length === 0) {
+          toast({
+            title: "Scheduled!",
+            description: `Queued for ${selected.length} platform${selected.length === 1 ? "" : "s"} at ${scheduledAtDate!.toLocaleString()}.`,
+          });
+          onOpenChange(false);
+        } else {
+          toast({
+            title: "Partly scheduled",
+            description: `Could not schedule: ${failed.join(", ")}. The rest are queued.`,
+            variant: "destructive",
+          });
+        }
+        return;
+      }
+
+      // Publish now: sequential so one platform's failure never hides
+      // another's success; each platform reports its own outcome.
+      const succeeded: string[] = [];
+      const failed: { key: string; message: string }[] = [];
+      for (const key of selected) {
+        try {
+          await publishMutations[key].mutateAsync({ id: item.id });
+          succeeded.push(key);
+          track("post_published", { platform: key });
+        } catch (error: any) {
+          failed.push({ key, message: error?.message || "publish failed" });
+        }
+      }
+      queryClient.invalidateQueries({ queryKey: getListContentQueryKey() });
+      if (failed.length === 0) {
+        toast({
+          title: succeeded.length === 1 ? "Published!" : `Published to ${succeeded.length} platforms`,
+          description:
+            succeeded.includes("instagram")
+              ? "Instagram finishes processing in the background — the library card updates when it's live."
+              : undefined,
+        });
+        onOpenChange(false);
+      } else {
+        toast({
+          title:
+            succeeded.length > 0
+              ? `Published to ${succeeded.join(", ")} — ${failed.length} failed`
+              : "Publish failed",
+          description: failed.map((f) => `${f.key}: ${f.message}`).join(" · "),
+          variant: "destructive",
+        });
+      }
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <Sheet open={open} onOpenChange={(next) => !busy && onOpenChange(next)}>
+      <SheetContent className="w-full sm:max-w-lg overflow-y-auto flex flex-col gap-5">
+        <SheetHeader>
+          <SheetTitle className="flex items-center gap-2">
+            <Send className="h-4 w-4 text-primary" /> Publish
+          </SheetTitle>
+          <SheetDescription>
+            {item?.title ? `“${item.title}”` : "Pick platforms, post now or schedule."}
+          </SheetDescription>
+        </SheetHeader>
+
+        {item && (
+          <>
+            {(item.imagePath || item.videoPath) && (
+              <div className="rounded-lg overflow-hidden border border-border bg-muted max-h-52 flex items-center justify-center">
+                {item.videoPath ? (
+                  <video
+                    src={`/api/storage${item.videoPath}`}
+                    poster={
+                      item.videoThumbnailPath
+                        ? `/api/storage${item.videoThumbnailPath}`
+                        : undefined
+                    }
+                    controls
+                    playsInline
+                    preload="metadata"
+                    className="max-h-52 w-full object-contain bg-black"
+                  />
+                ) : (
+                  <img
+                    src={`/api/storage${item.imagePath}`}
+                    alt={item.title}
+                    className="max-h-52 object-contain"
+                  />
+                )}
+              </div>
+            )}
+
+            <div className="space-y-1.5">
+              <Label htmlFor="composer-caption">Caption</Label>
+              <Textarea
+                id="composer-caption"
+                data-testid="composer-caption"
+                value={caption}
+                onChange={(e) => setCaption(e.target.value)}
+                rows={5}
+              />
+            </div>
+
+            <div className="space-y-2">
+              <Label>Platforms</Label>
+              <div className="grid grid-cols-2 gap-2">
+                {PLATFORMS.map(({ key, label, icon: Icon }) => (
+                  <label
+                    key={key}
+                    className={`flex items-center gap-2.5 rounded-lg border px-3 py-2 text-sm transition-colors ${
+                      !live[key]
+                        ? "border-border/50 text-muted-foreground/60 cursor-not-allowed"
+                        : selected.includes(key)
+                          ? "border-primary bg-primary/5 cursor-pointer"
+                          : "border-border cursor-pointer hover:border-primary/40"
+                    }`}
+                  >
+                    <Checkbox
+                      checked={selected.includes(key)}
+                      disabled={!live[key] || busy}
+                      onCheckedChange={() => toggle(key)}
+                      data-testid={`composer-platform-${key}`}
+                    />
+                    <Icon className="h-4 w-4" />
+                    <span className="flex-1">{label}</span>
+                    {!live[key] && <span className="text-xs">not connected</span>}
+                  </label>
+                ))}
+              </div>
+            </div>
+
+            {(checklist.blockers.length > 0 || checklist.infos.length > 0) && (
+              <div className="space-y-1.5" data-testid="composer-checklist">
+                {checklist.blockers.map((text) => (
+                  <p key={text} className="flex items-start gap-2 text-sm text-destructive">
+                    <AlertCircle className="h-4 w-4 mt-0.5 shrink-0" /> {text}
+                  </p>
+                ))}
+                {checklist.infos.map((text) => (
+                  <p key={text} className="flex items-start gap-2 text-sm text-muted-foreground">
+                    <Info className="h-4 w-4 mt-0.5 shrink-0" /> {text}
+                  </p>
+                ))}
+              </div>
+            )}
+
+            <div className="space-y-2">
+              <div className="grid grid-cols-2 gap-2">
+                <Button
+                  type="button"
+                  variant={mode === "now" ? "default" : "outline"}
+                  onClick={() => setMode("now")}
+                  disabled={busy}
+                  data-testid="composer-mode-now"
+                >
+                  <Send className="h-4 w-4 mr-1.5" /> Post now
+                </Button>
+                <Button
+                  type="button"
+                  variant={mode === "schedule" ? "default" : "outline"}
+                  onClick={() => setMode("schedule")}
+                  disabled={busy}
+                  data-testid="composer-mode-schedule"
+                >
+                  <CalendarClock className="h-4 w-4 mr-1.5" /> Schedule
+                </Button>
+              </div>
+              {mode === "schedule" && (
+                <div className="grid grid-cols-2 gap-2">
+                  <Input
+                    type="date"
+                    value={scheduleDate}
+                    onChange={(e) => setScheduleDate(e.target.value)}
+                    disabled={busy}
+                    aria-label="Schedule date"
+                  />
+                  <Input
+                    type="time"
+                    value={scheduleTime}
+                    onChange={(e) => setScheduleTime(e.target.value)}
+                    disabled={busy}
+                    aria-label="Schedule time"
+                  />
+                </div>
+              )}
+            </div>
+
+            <Button
+              className="mt-auto"
+              size="lg"
+              disabled={!canSubmit}
+              onClick={() => void onSubmit()}
+              data-testid="composer-submit"
+            >
+              {busy ? (
+                <RippleSpinner className="mr-2 h-4 w-4" />
+              ) : mode === "now" ? (
+                <Send className="h-4 w-4 mr-2" />
+              ) : (
+                <CalendarClock className="h-4 w-4 mr-2" />
+              )}
+              {busy
+                ? "Working…"
+                : mode === "now"
+                  ? `Publish to ${selected.length || "…"} platform${selected.length === 1 ? "" : "s"}`
+                  : "Schedule"}
+            </Button>
+          </>
+        )}
+      </SheetContent>
+    </Sheet>
+  );
+}
