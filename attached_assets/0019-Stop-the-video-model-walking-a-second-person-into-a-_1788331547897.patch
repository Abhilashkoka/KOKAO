     expect(SPEAKING_HOLD).toMatch(/head movement/i);
     expect(SPEAKING_HOLD).toMatch(/blinking/i);
   });
+
+  it("states the frame holds one subject, without naming a second person", () => {
+    // Measured on a real render: a second body walked into a single-speaker
+    // shot around 5s and the sync model lost the face. The scene prose had
+    // told the model the speaker was looking at someone "just off-frame" and
+    // then forbidden that someone — and a diffusion model reads a named
+    // negative as an invitation. So this says what the frame DOES hold rather
+    // than who must stay out of it.
+    expect(SPEAKING_HOLD).toMatch(/same single subject from the first frame to the last/i);
+    expect(SPEAKING_HOLD).toMatch(/nothing new enters it/i);
+    expect(SPEAKING_HOLD).not.toMatch(/second person|other person|no one else/i);
+  });
 });
