index 8fc0d744..30d69fd0 100644
--- a/artifacts/api-server/src/lib/videoGen/lipSyncExclusivity.ts
+++ b/artifacts/api-server/src/lib/videoGen/lipSyncExclusivity.ts
@@ -32,6 +32,30 @@ export function characterPassOwnsLipSync(args: {
   );
 }
 
+/**
+ * How much of the optional pass actually landed.
+ *
+ * The pass fails soft per scene: a scene the provider refuses ships as
+ * unsynced base footage rather than costing the user an already-rendered
+ * video. That is the right trade, but it must never be silent — otherwise
+ * someone watches the result, sees one character's mouth not moving, and has
+ * no way to know why.
+ *
+ * A skipped scene must also never carry a provider event, because the event IS
+ * the billing receipt: a skipped scene holding one would mean charging for a
+ * sync that never happened.
+ */
+export function summariseStudioLipSyncScenes(
+  scenes: ReadonlyArray<{ state: string; event?: unknown }> | undefined,
+): { synced: number; skipped: number; billable: number } {
+  const list = scenes ?? [];
+  return {
+    synced: list.filter((scene) => scene.state === "complete").length,
+    skipped: list.filter((scene) => scene.state === "skipped").length,
+    billable: list.filter((scene) => scene.event != null).length,
+  };
+}
+
 /** User-facing refusal for the redundant second pass. */
 export const STUDIO_PASS_REDUNDANT_MESSAGE =
   "This video already lip-syncs every character scene to its own line, shot by shot. " +
