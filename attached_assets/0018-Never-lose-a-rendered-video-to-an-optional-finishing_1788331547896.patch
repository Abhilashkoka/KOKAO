+          // A partly-synced video must say so. Without this the user watches a
+          // finished video, sees one character's mouth not moving, and has no
+          // way to tell that the provider refused that one scene.
+          skippedSceneCount: summariseStudioLipSyncScenes(
+            job.options.studioLipSync.checkpoint?.scenes,
+          ).skipped,
           state: job.options.studioLipSync.checkpoint?.state ?? "prepared",
