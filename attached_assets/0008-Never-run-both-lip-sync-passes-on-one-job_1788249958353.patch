         (body.engine === "dialogue_lip_sync"
@@ -7871,8 +7897,7 @@ async function generateVideoHandler(
     // upload-driven engine above.
     characterLipSync:
       body.engine === "topic_to_video" && visualsSource === "character"
-        ? (await resolveCharacterLipSync()) &&
