+import { describe, expect, it } from "vitest";
+import type { GuidedStoryProductChoices, GuidedStoryScript } from "@workspace/db";
+import { seedanceScenePrompt } from "./seedancePrompt";
+import {
+  guidedSceneVisualPrompt,
+  productClause,
+  productNote,
+  sanitizeBackdropDirection,
+} from "./guidedScenePrompt";
