+      "Required shared location direction: A sunlit boutique dressing room with a tall mirror. " +
+      "మాయ తన కొత్త నెక్లెస్‌ను చూసి ఆనందిస్తుంది. Scene 1: Maya enters.",
+    );
+    expect(direction).toBe("A sunlit boutique dressing room with a tall mirror.");
+  });
+
+  it("closes the frame to other hands and keeps worn products on", () => {
+    const prompt = guidedSceneVisualPrompt({ ...base, products: [{ ...necklace, worn: true }] });
+    expect(prompt).toContain("No other hands, arms or people enter the frame.");
+    expect(prompt).toMatch(/"Ardia Necklace" is already being worn.*Never show it being put on, fastened, clasped/s);
+    expect(prompt).toContain('The worn "Ardia Necklace" is part of the look');
+  });
+});
+
+describe("native-audio (Seedance) prompt", () => {
+  const scene = {
+    id: "s2", startMs: 0, endMs: 6000, visualDirection: "Maya touches the pendant and smiles.",
+    roleIds: ["maya"], productIds: ["p7"], worn: ["p7"],
+    lines: [{ id: "l1", ownerRoleId: "maya", kind: "dialogue", text: "It feels like mine.", startMs: 500, endMs: 3000 }],
+  } as any;
+  const input = {
+    scriptScene: scene,
+    sceneCast: [maya],
+    backdrop: { imagePath: "/objects/1/uploads/room", prompt: 'Create the primary shared location for the Guided Story "Ardia". A boutique dressing room.' },
+    location: { mode: "none" as const, imagePath: null, description: null },
+    platform: { aspectRatio: "9:16", safeArea: "" },
+    locale: "en" as const,
+    dialogueNumbers: new Map([["l1", 1]]),
+    segmentIndex: 1,
+    segmentCount: 3,
+    referenceMode: "atlas-character-assets" as const,
+  };
+
+  it("carries the product, its labels and the worn state", () => {
+    const prompt = seedanceScenePrompt({
+      ...input,
+      products: [{ ...necklace, worn: true }],
+      productReferenceLabels: ["@Image4"],
+      productSheetLabels: ["@Image5"],
+      productHero: { shot: { type: "in_use", camera: "push_in", lighting: "window_light", angle: null } },
+    });
+    expect(prompt).toContain("[PRODUCT]");
+    expect(prompt).toContain('The product "Ardia Necklace" is the subject');
+    expect(prompt).toContain("exactly as in @Image4");
+    expect(prompt).toContain("@Image5 is a multi-view design sheet");
+    expect(prompt).toContain("already being worn");
+    expect(prompt).toContain("No logos or text except the printing that is really on the product.");
+    expect(prompt).not.toContain("No logos. No watermarks.");
+    expect(prompt).not.toContain("Create the primary shared location");
+    expect(prompt).toContain("No other hands, arms or people enter the frame.");
+    expect(prompt).toContain("Worn products stay on the wearer");
+  });
+
+  it("is unchanged for scenes without products", () => {
+    const prompt = seedanceScenePrompt({ ...input, scriptScene: { ...scene, productIds: undefined, worn: undefined } });
+    expect(prompt).not.toContain("[PRODUCT]");
+    expect(prompt).toContain("No logos. No watermarks.");
+  });
+});
+
+describe("wearables in the script", () => {
+  function script(): GuidedStoryScript {
+    const line = (id: string, startMs: number) => ({ id, ownerRoleId: "maya", kind: "dialogue" as const, text: "Hello there friend.", startMs, endMs: startMs + 2000 });
+    return {
+      version: 1, title: "t", logline: "l", runtimeSeconds: 15, warnings: [],
+      roles: [{ id: "maya", name: "Maya", description: "buyer" }],
+      scenes: [
+        { id: "s1", startMs: 0, endMs: 5000, visualDirection: "Maya holds the necklace.", roleIds: ["maya"], productIds: ["p7"], lines: [line("l1", 0)] },
+        { id: "s2", startMs: 5000, endMs: 10000, visualDirection: "Maya wearing it.", roleIds: ["maya"], productIds: ["p7"], worn: ["p7"], lines: [line("l2", 5000)] },
+        { id: "s3", startMs: 10000, endMs: 15000, visualDirection: "Maya walks out.", roleIds: ["maya"], lines: [line("l3", 10000)] },
+      ],
+    } as GuidedStoryScript;
+  }
+
+  it("keeps a worn product on the wearer in every later scene", () => {
+    const carried = carryWornForward(script());
+    expect(carried.scenes[0]!.worn).toBeUndefined();
+    expect(carried.scenes[2]).toMatchObject({ productIds: ["p7"], worn: ["p7"] });
+    expect(carryWornForward(carried)).toBe(carried);
+  });
+
+  it("drops worn ids that are not shown or have no wearer", () => {
+    const raw = script();
+    raw.scenes[0] = { ...raw.scenes[0]!, worn: ["p9"] };
+    const cleaned = sanitizeGuidedScriptProducts(raw, choices);
+    expect(cleaned.scenes[0]!.worn).toBeUndefined();
+    expect(cleaned.scenes[2]!.worn).toEqual(["p7"]);
+  });
+
+  it("parses worn from the writer and keeps it inside productIds", () => {
+    const parsed = validateAndRepairGuidedScript({
+      title: "t", logline: "l", roles: [{ id: "maya", name: "Maya", description: "buyer" }],
+      scenes: [{
+        id: "s1", startMs: 0, endMs: 6000, visualDirection: "Maya wearing the necklace.", roleIds: ["maya"],
