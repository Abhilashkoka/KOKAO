diff --git a/artifacts/api-server/src/lib/brandKit/productSheet.test.ts b/artifacts/api-server/src/lib/brandKit/productSheet.test.ts
new file mode 100644
index 0000000..8f7105e
--- /dev/null
+++ b/artifacts/api-server/src/lib/brandKit/productSheet.test.ts
@@ -0,0 +1,126 @@
+import { readFileSync, existsSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import sharp from "sharp";
+import { describe, expect, it } from "vitest";
+import {
+  cropPanel,
+  detectSheetPanels,
+  normalizeSheetView,
+  parseSheetReply,
+  planSheetSplit,
+  productSheetVisionPrompt,
+} from "./productSheet";
+
+const fixture = fileURLToPath(new URL("./__fixtures__/necklace-sheet.jpg", import.meta.url));
+
+async function gridSheet(): Promise<Buffer> {
+  // 3 columns, the right two split into rows, thin bright dividers on grey.
+  const width = 900;
+  const height = 600;
+  const noise = Buffer.alloc(width * height * 3);
+  for (let i = 0; i < noise.length; i += 3) {
+    const v = 90 + ((i * 2654435761) >>> 0) % 70;
+    noise[i] = v; noise[i + 1] = v; noise[i + 2] = v;
+  }
+  const line = (w: number, h: number) => ({ create: { width: w, height: h, channels: 3 as const, background: { r: 235, g: 235, b: 235 } } });
+  return sharp(noise, { raw: { width, height, channels: 3 } })
+    .composite([
+      { input: await sharp(line(2, height)).png().toBuffer(), left: 400, top: 0 },
+      { input: await sharp(line(2, height)).png().toBuffer(), left: 650, top: 0 },
+      { input: await sharp(line(498, 2)).png().toBuffer(), left: 402, top: 300 },
+    ])
+    .png()
+    .toBuffer();
+}
+
+describe("collage detection", () => {
+  it("splits a sheet on its divider lines in reading order", async () => {
+    const { panels } = await detectSheetPanels(await gridSheet());
+    expect(panels).toHaveLength(5);
+    expect(panels[0]).toMatchObject({ left: 0, top: 0, height: 600 });
+    expect(panels[0]!.width).toBeGreaterThan(390);
+    expect(panels.slice(1).every((panel) => panel.width < 260 && panel.height < 300)).toBe(true);
+  });
+
+  it("keeps a plain product photo whole", async () => {
+    const photo = await sharp({ create: { width: 800, height: 800, channels: 3, background: { r: 255, g: 255, b: 255 } } })
+      .composite([{ input: await sharp({ create: { width: 200, height: 400, channels: 3, background: { r: 40, g: 80, b: 160 } } }).png().toBuffer(), left: 300, top: 200 }])
+      .png()
+      .toBuffer();
+    const { panels } = await detectSheetPanels(photo);
+    expect(panels).toEqual([{ left: 0, top: 0, width: 800, height: 800 }]);
+  });
+
+  it.runIf(existsSync(fixture))("finds the five views of a real necklace sheet", async () => {
+    const bytes = readFileSync(fixture);
+    const { panels } = await detectSheetPanels(bytes);
+    expect(panels).toHaveLength(5);
+    const crop = await sharp(await cropPanel(bytes, panels[0]!)).metadata();
+    expect(crop.width).toBe(panels[0]!.width);
+  });
+});
+
+describe("one vision reply", () => {
+  const layout = {
+    width: 900, height: 600,
+    panels: [
+      { left: 0, top: 0, width: 400, height: 600 },
+      { left: 404, top: 0, width: 244, height: 298 },
+      { left: 654, top: 0, width: 246, height: 298 },
+      { left: 404, top: 304, width: 244, height: 296 },
+      { left: 654, top: 304, width: 246, height: 296 },
+    ],
+  };
+
+  it("asks for description, collage flag and view labels together", () => {
+    const prompt = productSheetVisionPrompt("Describe it.", layout);
+    expect(prompt).toContain("COLLAGE");
+    expect(prompt).toContain("1: x=0 y=0 w=400 h=600");
+    expect(prompt).toContain('"main"');
+  });
+
+  it("maps loose view names", () => {
+    expect(normalizeSheetView("Angled view")).toBe("side");
+    expect(normalizeSheetView("pendant close-up")).toBe("detail");
+    expect(normalizeSheetView("worn on model")).toBe("in_use");
+    expect(normalizeSheetView("Back")).toBe("back");
+    expect(normalizeSheetView("selfie stick")).toBeNull();
+  });
+
+  it("plans one single-view main photo plus labelled angles", () => {
+    const reply = parseSheetReply(JSON.stringify({
+      description: "Gold layered necklace with a round pendant and fine chain.",
+      collage: true,
+      views: [
+        { panel: 1, view: "front" },
+        { panel: 2, view: "angled" },
+        { panel: 3, view: "side" },
+        { panel: 4, view: "front" },
+        { panel: 5, view: "pendant close-up" },
+      ],
+      main: 0,
+    }), layout);
+    expect(reply.collage).toBe(true);
+    const plan = planSheetSplit(reply)!;
+    expect(plan.main.box).toEqual(layout.panels[0]);
+    expect(plan.angles.map((angle) => angle.view).sort()).toEqual(["detail", "side"]);
+  });
+
+  it("never picks a close-up as the main photo and accepts fractional boxes", () => {
+    const reply = parseSheetReply(JSON.stringify({
+      description: "A ceramic mug with a blue glaze and a curved handle.",
+      collage: true,
+      views: [{ box: [0, 0, 0.5, 1], view: "detail" }, { box: [0.5, 0, 0.5, 1], view: "front" }],
+      main: 0,
+    }), { width: 1000, height: 500, panels: [{ left: 0, top: 0, width: 1000, height: 500 }] });
+    const plan = planSheetSplit(reply)!;
+    expect(plan.main.box).toEqual({ left: 500, top: 0, width: 500, height: 500 });
+    expect(plan.angles).toEqual([{ box: { left: 0, top: 0, width: 500, height: 500 }, view: "detail" }]);
+  });
+
+  it("treats a normal photo as single", () => {
+    const reply = parseSheetReply('{"description":"A single amber glass dropper bottle.","collage":false,"views":[]}', layout);
+    expect(reply.description).toContain("amber");
+    expect(planSheetSplit(reply)).toBeNull();
+  });
+});
diff --git a/artifacts/api-server/src/lib/brandKit/productSheet.ts b/artifacts/api-server/src/lib/brandKit/productSheet.ts
new file mode 100644
index 0000000..4a986a7
--- /dev/null
+++ b/artifacts/api-server/src/lib/brandKit/productSheet.ts
@@ -0,0 +1,302 @@
+import sharp from "sharp";
+import type { BrandProductAngleView } from "@workspace/db";
+
+/**
+ * Multi-view product collages ("reference sheets").
+ *
+ * Sellers often upload one image holding several views of the product
+ * (front, angled, side, close-up…). Animating that sheet makes the video
+ * model film a collage, and labelling it as "the product photo" confuses
+ * every reference-to-video model. This module:
+ *   1. finds the panels locally (free) by looking for divider lines or
+ *      narrow uniform gutters, splitting guillotine-style;
+ *   2. builds ONE vision prompt that describes the product AND labels each
+ *      panel's view, so a collage costs the same as a single photo;
+ *   3. turns the answer into a plan: one single-view main photo, up to four
+ *      labelled angles, and the sheet kept as a design reference only.
+ */
+
+export interface SheetBox {
+  left: number;
+  top: number;
+  width: number;
+  height: number;
+}
+
+export const SHEET_VIEWS: readonly BrandProductAngleView[] = [
+  "front", "back", "side", "top", "label", "detail", "in_use", "packaging",
+];
+
+const MIN_PANEL_FRACTION = 0.15;
+const MAX_PANELS = 9;
+const SAMPLE_COUNT = 240;
+
+interface Lum {
+  width: number;
+  height: number;
+  at(x: number, y: number): number;
+}
+
+async function luminance(bytes: Buffer): Promise<Lum> {
+  const { data, info } = await sharp(bytes, { failOn: "none" })
+    .rotate()
+    .removeAlpha()
+    .greyscale()
+    .raw()
+    .toBuffer({ resolveWithObject: true });
+  const width = info.width;
+  const channels = info.channels;
+  return { width, height: info.height, at: (x, y) => data[(y * width + x) * channels]! };
+}
+
+function mean(values: number[]): number {
+  return values.reduce((sum, value) => sum + value, 0) / Math.max(1, values.length);
+}
+function std(values: number[]): number {
+  const m = mean(values);
+  return Math.sqrt(mean(values.map((value) => (value - m) ** 2)));
+}
+
+/**
+ * Cut positions across one axis of a region. `vertical` = cuts are columns.
+ * Returns [start, end] pixel runs (inclusive) of each divider.
+ */
+function findCuts(lum: Lum, region: SheetBox, vertical: boolean): Array<[number, number]> {
+  const span = vertical ? region.width : region.height;
+  const across = vertical ? region.height : region.width;
+  const origin = vertical ? region.left : region.top;
+  const crossOrigin = vertical ? region.top : region.left;
+  const minPanel = Math.max(24, Math.floor(span * MIN_PANEL_FRACTION));
+  const step = Math.max(1, Math.floor(across / SAMPLE_COUNT));
+  const pixel = (pos: number, cross: number) => (vertical ? lum.at(pos, cross) : lum.at(cross, pos));
+  const samples: number[] = [];
+  for (let c = crossOrigin + 2; c < crossOrigin + across - 2; c += step) samples.push(c);
+  if (samples.length < 8) return [];
+
+  type Kind = "line" | "flat" | null;
+  const kinds: Kind[] = [];
+  const stds: number[] = [];
+  for (let offset = 0; offset < span; offset += 1) {
+    const pos = origin + offset;
+    const column = samples.map((c) => pixel(pos, c));
+    const s = std(column);
+    stds.push(s);
+    if (offset < 3 || offset >= span - 3) {
+      kinds.push(null);
+      continue;
+    }
+    let bright = 0;
+    let dark = 0;
+    for (const c of samples) {
+      const d = pixel(pos, c) - (pixel(pos - 3, c) + pixel(pos + 3, c)) / 2;
+      if (d > 20) bright += 1;
+      else if (d < -20) dark += 1;
+    }
+    const lineScore = Math.max(bright, dark) / samples.length;
+    kinds.push(lineScore >= 0.85 && s < 24 ? "line" : s < 5 ? "flat" : null);
+  }
+
+  const cuts: Array<[number, number]> = [];
+  let offset = 0;
+  while (offset < span) {
+    const kind = kinds[offset];
+    if (!kind) {
+      offset += 1;
+      continue;
+    }
+    let end = offset;
+    while (end + 1 < span && kinds[end + 1] === kind) end += 1;
+    // A line divider may be followed by its own anti-aliased edge.
+    if (kind === "line") while (end + 1 < span && end - offset < 6 && kinds[end + 1] !== null) end += 1;
+    const width = end - offset + 1;
+    const before = offset;
+    const after = span - 1 - end;
+    let ok = before >= minPanel && after >= minPanel;
+    if (ok && kind === "flat") {
+      // A gutter is narrow and has real content on both sides; a white
+      // studio background next to a product is wide and touches an edge.
+      const outside = [stds[offset - 2] ?? 0, stds[end + 2] ?? 0];
+      ok = width >= 3 && width <= Math.max(8, span * 0.06) && outside.every((value) => value > 12);
+    }
+    if (ok) cuts.push([origin + offset, origin + end]);
+    offset = end + 1;
+  }
+  return cuts;
+}
+
+function splitBy(region: SheetBox, cuts: Array<[number, number]>, vertical: boolean): SheetBox[] {
+  const parts: SheetBox[] = [];
+  let start = vertical ? region.left : region.top;
+  const limit = vertical ? region.left + region.width : region.top + region.height;
+  for (const [cutStart, cutEnd] of [...cuts, [limit, limit] as [number, number]]) {
+    const a = start + (start === (vertical ? region.left : region.top) ? 0 : 2);
+    const b = cutStart - (cutStart === limit ? 0 : 2);
+    if (b - a > 8) {
+      parts.push(vertical
+        ? { left: a, top: region.top, width: b - a, height: region.height }
+        : { left: region.left, top: a, width: region.width, height: b - a });
+    }
+    start = cutEnd + 1;
+  }
+  return parts;
+}
+
+function splitRegion(lum: Lum, region: SheetBox, depth: number): SheetBox[] {
+  if (depth > 3) return [region];
+  for (const vertical of [true, false]) {
+    const cuts = findCuts(lum, region, vertical);
+    if (cuts.length) {
+      return splitBy(region, cuts, vertical).flatMap((part) => splitRegion(lum, part, depth + 1));
+    }
+  }
+  return [region];
+}
+
+/**
+ * Panels of a collage, largest first is NOT applied — order is reading
+ * order (left→right, top→bottom), which is how the vision prompt numbers
+ * them. A plain photo returns one panel covering the whole image.
+ */
+export async function detectSheetPanels(bytes: Buffer): Promise<{ width: number; height: number; panels: SheetBox[] }> {
+  const lum = await luminance(bytes);
+  const whole: SheetBox = { left: 0, top: 0, width: lum.width, height: lum.height };
+  if (lum.width < 160 || lum.height < 160) return { width: lum.width, height: lum.height, panels: [whole] };
+  const panels = splitRegion(lum, whole, 0);
+  if (panels.length < 2 || panels.length > MAX_PANELS) return { width: lum.width, height: lum.height, panels: [whole] };
+  panels.sort((a, b) => (Math.abs(a.top - b.top) < 12 ? a.left - b.left : a.top - b.top));
+  return { width: lum.width, height: lum.height, panels };
+}
+
+export async function cropPanel(bytes: Buffer, box: SheetBox): Promise<Buffer> {
+  return sharp(bytes, { failOn: "none" }).rotate().extract(box).png().toBuffer();
+}
+
+/** Vision instruction: describe the product and label the panels in one reply. */
+export function productSheetVisionPrompt(
+  base: string,
+  layout: { width: number; height: number; panels: SheetBox[] },
+): string {
+  const panelList = layout.panels
+    .map((box, index) => `${index + 1}: x=${box.left} y=${box.top} w=${box.width} h=${box.height}`)
+    .join("; ");
+  return [
+    base,
+    "",
+    "Also decide whether this image is a COLLAGE / reference sheet: several separate views of the same product placed in one image (grid, side-by-side panels, an inset close-up).",
+    `The image is ${layout.width}x${layout.height} px. A layout detector found these panels (pixel boxes): ${panelList}.`,
+    `Label every view with one of: ${SHEET_VIEWS.join(", ")}. Use "side" for angled or three-quarter views, "detail" for close-ups of a part (pendant, clasp, stitching, texture), "in_use" for the product worn or held by a person, "label" for a readable label or tag.`,
+    "If the detected panels match the real layout, refer to them by number. If they do not (for example only one panel was found but the image is a collage), give each view as a box in fractions of the image instead.",
+    "Pick as \"main\" the clearest single view of the WHOLE product, preferably the front, never a close-up of a part.",
+    'Reply with strict JSON only: {"description": "<60-90 words, describe the product itself, not the collage layout>", "collage": true|false, "views": [{"panel": <number>} or {"box": [x, y, w, h]}, plus "view": "<view>"], "main": <index into views>}',
+    'For a normal single photo reply {"description": "...", "collage": false, "views": [], "main": 0}.',
+  ].join("\n");
+}
+
+export interface SheetView {
+  box: SheetBox;
+  view: BrandProductAngleView;
+}
+
+export interface ParsedSheetReply {
+  description: string | null;
+  collage: boolean;
+  views: SheetView[];
+  main: number;
+}
+
+function clampBox(box: SheetBox, width: number, height: number): SheetBox | null {
+  const left = Math.max(0, Math.min(width - 1, Math.round(box.left)));
+  const top = Math.max(0, Math.min(height - 1, Math.round(box.top)));
+  const right = Math.max(left + 1, Math.min(width, Math.round(box.left + box.width)));
+  const bottom = Math.max(top + 1, Math.min(height, Math.round(box.top + box.height)));
+  const out = { left, top, width: right - left, height: bottom - top };
+  return out.width >= 48 && out.height >= 48 ? out : null;
+}
+
+export function normalizeSheetView(raw: unknown): BrandProductAngleView | null {
+  if (typeof raw !== "string") return null;
+  const value = raw.toLowerCase().trim().replace(/[\s-]+/g, "_");
+  if ((SHEET_VIEWS as readonly string[]).includes(value)) return value as BrandProductAngleView;
+  if (/angle|three_quarter|3_4|profile/.test(value)) return "side";
+  if (/close|macro|zoom|pendant|clasp|texture|stitch/.test(value)) return "detail";
+  if (/worn|model|hand|use|wearing|lifestyle/.test(value)) return "in_use";
+  if (/tag|text|logo/.test(value)) return "label";
+  if (/box|pack/.test(value)) return "packaging";
+  if (/flat|main|hero/.test(value)) return "front";
+  if (/rear/.test(value)) return "back";
+  if (/above|overhead/.test(value)) return "top";
+  return null;
+}
+
+/** Parse the single vision reply. Invalid parts are dropped, never fatal. */
+export function parseSheetReply(
+  raw: string,
+  layout: { width: number; height: number; panels: SheetBox[] },
+): ParsedSheetReply {
+  let parsed: Record<string, unknown>;
+  try {
+    parsed = JSON.parse(raw) as Record<string, unknown>;
+  } catch {
+    return { description: null, collage: false, views: [], main: 0 };
+  }
+  const text = typeof parsed.description === "string" ? parsed.description.replace(/\s+/g, " ").trim() : "";
+  const description = text.length >= 10 ? text.slice(0, 900) : null;
+  const views: SheetView[] = [];
+  const rawViews = Array.isArray(parsed.views) ? parsed.views : [];
+  const indexMap: number[] = [];
+  rawViews.forEach((entry, index) => {
+    if (!entry || typeof entry !== "object") return;
+    const item = entry as { panel?: unknown; box?: unknown; view?: unknown };
+    const view = normalizeSheetView(item.view);
+    if (!view) return;
+    let box: SheetBox | null = null;
+    if (typeof item.panel === "number" && Number.isInteger(item.panel)) {
+      box = layout.panels[item.panel - 1] ?? null;
+    } else if (Array.isArray(item.box) && item.box.length === 4 && item.box.every((n) => typeof n === "number")) {
+      const [x, y, w, h] = item.box as number[];
+      const fractions = [x!, y!, w!, h!].every((n) => n >= 0 && n <= 1.0001);
+      box = fractions
+        ? clampBox({ left: x! * layout.width, top: y! * layout.height, width: w! * layout.width, height: h! * layout.height }, layout.width, layout.height)
+        : clampBox({ left: x!, top: y!, width: w!, height: h! }, layout.width, layout.height);
+    }
+    if (!box) return;
+    indexMap[index] = views.length;
+    views.push({ box, view });
+  });
+  const mainRaw = typeof parsed.main === "number" && Number.isInteger(parsed.main) ? parsed.main : 0;
+  const collage = parsed.collage === true && views.length >= 2;
+  return { description, collage, views: collage ? views : [], main: collage ? indexMap[mainRaw] ?? 0 : 0 };
+}
+
+export interface SheetPlan {
+  main: SheetView;
+  angles: SheetView[];
+}
+
+/**
+ * One main single view plus up to `maxAngles` labelled angles, one per view.
+ * The main is the model's pick unless it is a part close-up; then the first
+ * front, then the largest panel.
+ */
+export function planSheetSplit(reply: ParsedSheetReply, maxAngles = 4): SheetPlan | null {
+  if (!reply.collage || reply.views.length < 2) return null;
+  const area = (view: SheetView) => view.box.width * view.box.height;
+  const picked = reply.views[reply.main];
+  const main = picked && picked.view !== "detail" && picked.view !== "label"
+    ? picked
+    : reply.views.find((view) => view.view === "front") ??
+      [...reply.views].sort((a, b) => area(b) - area(a))[0]!;
+  const angles: SheetView[] = [];
+  const seen = new Set<BrandProductAngleView>(["front"]);
+  // Larger panels first so the clearest example of each view wins.
+  const bySize = [...reply.views].sort((a, b) => area(b) - area(a));
+  for (const view of bySize) {
+    if (view === main || seen.has(view.view) || angles.length >= maxAngles) continue;
+    seen.add(view.view);
+    angles.push(view);
+  }
+  // A second front view (e.g. laid flat) still helps as a detail shot.
+  const extraFront = bySize.find((view) => view !== main && view.view === "front");
+  if (extraFront && !seen.has("detail") && angles.length < maxAngles) angles.push({ ...extraFront, view: "detail" });
+  return { main: { ...main, view: "front" }, angles };
+}
