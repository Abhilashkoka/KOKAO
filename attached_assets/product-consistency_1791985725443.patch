+        lines: [{ id: "l1", ownerRoleId: "maya", kind: "dialogue", text: "This necklace is everything to me.", startMs: 0, endMs: 5000 }],
+      }],
+    }, { durationSeconds: 6 });
+    expect(parsed.scenes[0]!.worn).toEqual(["p7"]);
+  });
+});
