+  carryWornForward,
+  guidedProductReferenceLabels,
+  guidedSceneProducts,
+  sanitizeGuidedScriptProducts,
+  validateAndRepairGuidedScript,
+} from "./guidedStory";
+import { chooseProductImage } from "./productHero";
+
+const maya = {
+  roleId: "maya",
+  source: "generated",
+  characterId: 1,
+  outfitId: 2,
+  character: { name: "Maya", referenceImagePath: "/objects/1/uploads/maya" },
+  outfit: { description: "a cream silk blouse", referenceImagePath: "/objects/1/uploads/blouse" },
+  voice: { provider: "stock", providerVoiceId: "v1" },
+} as any;
+
+const necklace = {
+  id: "p7", name: "Ardia Necklace", kind: "product" as const, description: "Gold layered necklace.",
+  aiDescription: "A gold layered necklace with a round engraved pendant on a fine chain.",
+  displayMode: "in_scene" as const,
+  imagePath: "/objects/1/uploads/front", imageSha256: "f".repeat(64),
+  sheetPath: "/objects/1/uploads/sheet", sheetSha256: "s".repeat(64),
+};
+
+const choices: GuidedStoryProductChoices = {
+  version: 1,
+  promotion: "hero",
+  heroShare: 0.7,
+  items: [{
+    id: "p7", assetId: 7, name: "Ardia Necklace", kind: "product", description: "Gold layered necklace.",
+    aiDescription: "Gold necklace", displayMode: "in_scene",
+    imagePath: "/objects/1/uploads/sheet", imageSha256: "s".repeat(64), mimeType: "image/png",
+    angles: [
+      { view: "detail", imagePath: "/objects/1/uploads/pendant", imageSha256: "d".repeat(64), mimeType: "image/png" },
+      { view: "side", imagePath: "/objects/1/uploads/side", imageSha256: "e".repeat(64), mimeType: "image/png" },
+    ],
+    referenceSheet: { imagePath: "/objects/1/uploads/sheet", imageSha256: "s".repeat(64), mimeType: "image/png" },
+  }],
+};
+
+const base = {
+  scriptScene: { visualDirection: "Maya turns to the mirror." },
+  sceneCast: [maya],
+  backdrop: null,
+  backdropLabel: "default" as const,
+  location: { mode: "none" as const, imagePath: null, description: null },
+  logoPath: null,
+  platform: { aspectRatio: "9:16", safeArea: "" },
+};
+
+describe("product references", () => {
+  it("labels each product's single view, then its sheet, and never shows the sheet", () => {
+    expect(guidedProductReferenceLabels([necklace], 3)).toEqual({ photo: ["@Image4"], sheet: ["@Image5"], count: 2 });
+    const text = productClause({ ...base, products: [necklace], productReferenceLabels: ["@Image4"], productSheetLabels: ["@Image5"] });
+    expect(text).toContain('exactly as in @Image4');
+    expect(text).toMatch(/@Image5 is a multi-view design sheet.*never show the sheet/);
+    const sheetOnly = { ...necklace, imagePath: necklace.sheetPath };
+    expect(guidedProductReferenceLabels([sheetOnly], 0)).toEqual({ photo: [undefined], sheet: ["@Image1"], count: 1 });
+    expect(productClause({ ...base, products: [sheetOnly], productReferenceLabels: [undefined], productSheetLabels: ["@Image1"] }))
+      .toMatch(/once, as a single real object, matching the design in @Image1/);
+  });
+
+  it("uses a single view, not the sheet, when no main photo was chosen", () => {
+    expect(chooseProductImage(choices.items[0]!, null).imagePath).toBe("/objects/1/uploads/side");
+    const [scene] = guidedSceneProducts({ ...choices, promotion: "featured" }, ["p7"], null, ["p7"]);
+    expect(scene).toMatchObject({
+      imagePath: "/objects/1/uploads/side", view: "side",
+      sheetPath: "/objects/1/uploads/sheet", sheetSha256: "s".repeat(64), worn: true,
+    });
+  });
+});
+
+describe("prompt clean-up", () => {
+  it("trims notes at a sentence boundary instead of an ellipsis", () => {
+    const note = productNote("A gold necklace with a pendant. It has a fine chain and a lobster clasp with a tag.", 60);
+    expect(note).toBe("A gold necklace with a pendant.");
+    expect(productNote("word ".repeat(40), 50)).not.toContain("…");
+  });
+
+  it("removes instructions to us and non-Latin synopsis from the backdrop", () => {
