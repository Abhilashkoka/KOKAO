@@ -0,0 +1,225 @@
+import { useRef, useState } from "react";
+import { useQueryClient } from "@tanstack/react-query";
+import {
+  getListBrandProductsQueryKey,
+  useGenerateBrandProductCleanFront,
+  useRelabelBrandProductAngle,
+  useRequestUploadUrl,
+  useSetBrandProductMain,
+  type BrandProduct,
+  type BrandProductAngleView,
+} from "@workspace/api-client-react";
+import { apiErrorMessage } from "@/lib/apiErrorMessage";
+import { Button } from "@/components/ui/button";
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from "@/components/ui/select";
+import { ImagePlus, LayoutGrid, Loader2, Sparkles, Star } from "lucide-react";
+
+const SHEET_VIEW_LABELS: Array<[Exclude<BrandProductAngleView, "front">, string]> = [
+  ["back", "Back"],
+  ["side", "Side / angled"],
+  ["top", "Top"],
+  ["label", "Label"],
+  ["detail", "Close-up"],
+  ["in_use", "Worn / in use"],
+  ["packaging", "Packaging"],
+];
+const IMAGE_TYPES = ["image/png", "image/jpeg", "image/webp"];
+const MAX_IMAGE_BYTES = 10 * 1024 * 1024;
+
+/**
+ * Shown when a product photo was a collage of several views. A split sheet
+ * lists the views the AI found so the owner can fix labels or pick another
+ * main photo; an unsplit sheet asks for a single-view main photo.
+ */
+export function ProductSheetPanel({ kitId, product }: { kitId: number; product: BrandProduct }) {
+  const queryClient = useQueryClient();
+  const refresh = () => queryClient.invalidateQueries({ queryKey: getListBrandProductsQueryKey(kitId) });
+  const relabel = useRelabelBrandProductAngle();
+  const setMain = useSetBrandProductMain();
+  const cleanFront = useGenerateBrandProductCleanFront();
+  const requestUploadUrl = useRequestUploadUrl();
+  const fileRef = useRef<HTMLInputElement | null>(null);
+  const [preview, setPreview] = useState<string | null>(null);
+  const [uploading, setUploading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const status = product.sheetStatus;
+  if (status !== "split" && status !== "needs_main") return null;
+  const angles = product.angles ?? [];
+  const busy = relabel.isPending || setMain.isPending || cleanFront.isPending || uploading;
+
+  const chooseMain = (data: { angleId?: string; imagePath?: string; previousView?: BrandProductAngleView }) => {
+    setError(null);
+    setMain.mutate(
+      { id: kitId, assetId: product.id, data },
+      {
+        onSuccess: () => {
+          setPreview(null);
+          void refresh();
+        },
+        onError: (err) => setError(apiErrorMessage(err, "Could not change the main photo.")),
+      },
+    );
+  };
+
+  const uploadMain = async (file: File | null) => {
+    if (!file) return;
+    setError(null);
+    if (!IMAGE_TYPES.includes(file.type) || file.size > MAX_IMAGE_BYTES) {
+      setError("Use a PNG, JPEG or WebP photo up to 10 MB.");
+      return;
+    }
+    setUploading(true);
+    try {
+      const { uploadURL, objectPath } = await requestUploadUrl.mutateAsync({
+        data: { name: file.name, size: file.size, contentType: file.type },
+      });
+      const put = await fetch(uploadURL, { method: "PUT", body: file, headers: { "Content-Type": file.type } });
+      if (!put.ok) throw new Error(`Upload failed (${put.status})`);
+      chooseMain({ imagePath: objectPath });
+    } catch (err) {
+      setError(apiErrorMessage(err, "Could not upload this photo."));
+    } finally {
+      setUploading(false);
+      if (fileRef.current) fileRef.current.value = "";
+    }
+  };
+
+  return (
+    <div
+      className={`space-y-2 rounded-md border p-2.5 text-xs ${
+        status === "needs_main" ? "border-amber-300/70 bg-amber-50/60 dark:bg-amber-950/20" : "border-violet-200/70 bg-violet-50/50 dark:bg-violet-950/20"
+      }`}
+      data-testid={`product-sheet-${product.id}`}
+    >
+      <div className="flex items-start gap-1.5">
+        <LayoutGrid className="mt-0.5 h-3.5 w-3.5 shrink-0 text-muted-foreground" />
+        {status === "split" ? (
+          <p data-testid={`text-sheet-split-${product.id}`}>
+            Your photo was a collage, so we split it into {angles.length + 1} views. Check the labels below. The collage is kept as a design reference and never appears in a video.
+          </p>
+        ) : (
+          <p data-testid={`text-sheet-needs-main-${product.id}`}>
+            This photo is a collage of several views. Videos need one clean photo of the product. Upload a single-view photo, or generate a clean front shot from the collage.
+          </p>
+        )}
+      </div>
+
+      {status === "split" && (
+        <div className="flex flex-wrap gap-2">
+          <div className="flex w-24 flex-col items-center gap-1 rounded border bg-background p-1">
+            <img src={`/api/storage${product.imagePath}`} alt="Main photo" className="h-16 w-16 rounded-sm bg-white object-contain" />
+            <span className="inline-flex items-center gap-1 font-medium"><Star className="h-3 w-3" />Main</span>
+          </div>
+          {angles.map((angle) => (
+            <div key={angle.id} className="flex w-24 flex-col items-center gap-1 rounded border bg-background p-1" data-testid={`sheet-view-${angle.id}`}>
+              <img src={`/api/storage${angle.imagePath}`} alt="" className="h-16 w-16 rounded-sm bg-white object-contain" />
+              <Select
+                value={angle.view}
+                onValueChange={(view) =>
+                  relabel.mutate(
+                    { id: kitId, assetId: product.id, angleId: angle.id, data: { view: view as BrandProductAngleView } },
+                    { onSuccess: () => void refresh(), onError: (err) => setError(apiErrorMessage(err, "Could not relabel this view.")) },
+                  )
+                }
+              >
+                <SelectTrigger className="h-6 w-full px-1.5 text-[11px]" aria-label="Which view this is" data-testid={`select-sheet-view-${angle.id}`}>
+                  <SelectValue />
+                </SelectTrigger>
+                <SelectContent>
+                  {SHEET_VIEW_LABELS.map(([id, label]) => <SelectItem key={id} value={id}>{label}</SelectItem>)}
+                </SelectContent>
+              </Select>
+              <button
+                type="button"
+                className="text-[11px] text-muted-foreground underline-offset-2 hover:underline disabled:opacity-50"
+                disabled={busy || angle.view === "detail" || angle.view === "label"}
+                onClick={() => chooseMain({ angleId: angle.id, previousView: angle.view })}
+                data-testid={`button-sheet-make-main-${angle.id}`}
+              >
+                Make main
+              </button>
+            </div>
+          ))}
+        </div>
+      )}
+
+      {status === "needs_main" && (
+        <div className="space-y-2">
+          <div className="flex flex-wrap gap-2">
+            <input
+              ref={fileRef}
+              type="file"
+              accept={IMAGE_TYPES.join(",")}
+              className="hidden"
+              onChange={(e) => void uploadMain(e.target.files?.[0] ?? null)}
+              data-testid={`input-sheet-main-${product.id}`}
+            />
+            <Button type="button" size="sm" variant="outline" className="h-7 text-xs" disabled={busy} onClick={() => fileRef.current?.click()}>
+              {uploading ? <Loader2 className="mr-1 h-3 w-3 animate-spin" /> : <ImagePlus className="mr-1 h-3 w-3" />}Upload single view
+            </Button>
+            <Button
+              type="button"
+              size="sm"
+              variant="outline"
+              className="h-7 text-xs"
+              disabled={busy}
+              onClick={() => {
+                setError(null);
+                cleanFront.mutate(
+                  { id: kitId, assetId: product.id },
+                  {
+                    onSuccess: (result) => setPreview(result.imagePath),
+                    onError: (err) => setError(apiErrorMessage(err, "Could not generate a clean front shot.")),
+                  },
+                );
+              }}
+              data-testid={`button-sheet-clean-front-${product.id}`}
+            >
+              {cleanFront.isPending ? <Loader2 className="mr-1 h-3 w-3 animate-spin" /> : <Sparkles className="mr-1 h-3 w-3" />}Generate clean front shot
+            </Button>
+          </div>
+          {angles.length > 0 && (
+            <div className="flex flex-wrap items-center gap-1.5">
+              <span className="text-muted-foreground">Or use:</span>
+              {angles.map((angle) => (
+                <button
+                  key={angle.id}
+                  type="button"
+                  className="rounded border bg-background p-0.5 disabled:opacity-50"
+                  disabled={busy}
+                  onClick={() => chooseMain({ angleId: angle.id })}
+                  aria-label={`Use the ${angle.view} photo as main`}
+                >
+                  <img src={`/api/storage${angle.imagePath}`} alt="" className="h-8 w-8 rounded-sm bg-white object-contain" />
+                </button>
+              ))}
+            </div>
+          )}
+          {preview && (
+            <div className="flex items-center gap-2 rounded border bg-background p-1.5" data-testid={`sheet-clean-front-preview-${product.id}`}>
+              <img src={`/api/storage${preview}`} alt="Generated front shot" className="h-20 w-20 rounded-sm bg-white object-contain" />
+              <div className="space-y-1">
+                <p className="text-muted-foreground">Check it matches your product exactly before using it.</p>
+                <div className="flex gap-1.5">
+                  <Button type="button" size="sm" className="h-7 text-xs" disabled={busy} onClick={() => chooseMain({ imagePath: preview })} data-testid={`button-sheet-use-clean-front-${product.id}`}>
+                    Use this
+                  </Button>
+                  <Button type="button" size="sm" variant="ghost" className="h-7 text-xs" disabled={busy} onClick={() => setPreview(null)}>
+                    Discard
+                  </Button>
+                </div>
+              </div>
+            </div>
+          )}
+        </div>
+      )}
+      {error && <p className="text-destructive">{error}</p>}
+    </div>
+  );
+}
