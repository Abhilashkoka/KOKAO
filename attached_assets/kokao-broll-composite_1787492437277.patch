+      ),
+    ).not.toThrow();
+  });
+
+  it("rejects every workspace-scoped key", () => {
+    for (const key of TENANT_SCOPED_OPTION_KEYS) {
+      expect(() => assertTemplateSafe(row({ jobDefaults: { [key]: 7 } }))).toThrow(
+        UnsafeTemplateError,
+      );
+    }
+  });
+
+  it("names the offending keys so the error is actionable", () => {
+    try {
+      assertTemplateSafe(row({ jobDefaults: { brandKitId: 3, sourceVideoPath: "/objects/9/a.mp4" } }));
+      throw new Error("should have thrown");
+    } catch (error) {
+      expect(error).toBeInstanceOf(UnsafeTemplateError);
+      expect((error as UnsafeTemplateError).keys).toEqual(["brandKitId", "sourceVideoPath"]);
+      expect((error as Error).message).toMatch(/declare slots/);
+    }
+  });
+
+  it("treats an explicit null as unset rather than an offence", () => {
+    expect(() =>
+      assertTemplateSafe(row({ jobDefaults: { brandKitId: null, musicPath: null } })),
+    ).not.toThrow();
+  });
+
+  it("leaves a tenant's own profile alone — its ids are its own", () => {
+    expect(() =>
+      assertTemplateSafe(row({ scope: "tenant", tenantId: 4, jobDefaults: { brandKitId: 3 } })),
+    ).not.toThrow();
