+        const hit = [...doc.layers].reverse().find((layer) => {
+          if (!layer.visible || layer.locked) return false;
+          const box = layerBounds(layer);
+          return (
+            point.x >= box.x &&
+            point.x <= box.x + box.width &&
+            point.y >= box.y &&
