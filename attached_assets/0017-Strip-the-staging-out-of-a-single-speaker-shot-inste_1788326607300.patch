+// The direction that actually shipped nine unusable shots and crashed the sync
+// model on scene1-s2.
+const MIRROR_SCENE =
+  "Vertical 9:16. Keep both faces and all text centered within the safe 1080x1420 area. " +
+  "Bathroom mirror selfie setup. Ava holds a medication box like a game-show prize; " +
+  "Ben appears beside her holding a tiny calendar and looking nervous-excited.";
+
+describe("settingOnly", () => {
+  it("removes the other character's staging by name", () => {
+    const text = settingOnly(MIRROR_SCENE, ["Ben"]);
+    expect(text).not.toMatch(/\bBen\b/);
+    expect(text).toContain("Ava holds a medication box");
+  });
+
+  it("removes the instruction to keep BOTH faces in frame", () => {
+    // This clause is why every shot came back with two people: it is a direct
+    // order to include them, sitting in front of a framing note that merely
+    // preferred one.
+    expect(settingOnly(MIRROR_SCENE, ["Ben"])).not.toMatch(/both faces/i);
+  });
+
+  it("removes mirrors, reflections and selfies", () => {
+    // A reflection is a second face even when it is the speaker's own — the
+    // sync model gets two Avas and cannot choose. This is the exact clause
+    // that made scene1-s2 crash.
+    const text = settingOnly(MIRROR_SCENE, ["Ben"]);
+    expect(text).not.toMatch(/mirror|selfie|reflect/i);
+  });
+
+  it("removes joint staging that names nobody", () => {
+    // "They lean in together" carries no name to filter on, so the cue list
+    // has to catch it.
+    const text = settingOnly(
+      "Same couch, softer light. They lean in together, smiling.",
+      ["Ben"],
+    );
+    expect(text).toContain("Same couch, softer light.");
+    expect(text).not.toMatch(/lean in together/i);
+  });
+
+  it("keeps the setting when there is nothing to strip", () => {
+    expect(settingOnly("A busy hospital corridor, afternoon light.", ["Ravi"]))
+      .toBe("A busy hospital corridor, afternoon light.");
+  });
+
+  it("survives a direction that is entirely staging", () => {
+    // Everything filtered out is fine: the frozen approved backdrop image is
+    // what actually holds the location, not this prose.
+    expect(settingOnly("They stand together beside each other.", [])).toBe("");
+  });
+});
