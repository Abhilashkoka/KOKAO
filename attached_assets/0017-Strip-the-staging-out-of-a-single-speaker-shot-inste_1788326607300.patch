 /**
- * The scene's own direction plus what this shot is. The location text is
- * carried through unchanged so every shot cut together is the same place —
- * without that, two shots of one conversation are two different rooms.
+ * Phrases that put a second person, or a second FACE, in frame.
+ *
+ * A reflection counts even when it is the speaker's own: "bathroom mirror
+ * selfie" hands the sync model two faces of the same actor and it has no way
+ * to choose. A selfie implies the phone, the arm and the mirror together, so
+ * it goes with them.
  */
-export function shotVisualDirection(sceneDirection: string, shot: CoverageShot): string {
-  const base = sceneDirection.trim().replace(/\s+$/, "");
-  const facing =
-    shot.eyeline === "center"
-      ? "facing the camera"
-      : `turned slightly to face screen-${shot.eyeline}, looking at the person they are speaking with just off-frame`;
-  if (shot.kind === "single") {
+const MULTI_SUBJECT_CUES = [
+  "both", "they", "them", "their", "together", "each other", "couple",
+  "beside", "next to", "two of", "pair of", "one another",
+  "mirror", "reflect", "selfie",
+];
+
+/**
+ * Reduce an authored scene direction to the part that survives being shot on
+ * one person.
+ *
+ * A scene is written as staging — "Ava holds a medication box; Ben appears
+ * beside her" — and that staging is exactly what must not reach a
+ * single-speaker shot. Appending "only the speaking character" to it does not
+ * work: the two instructions contradict, and the concrete, detailed staging
+ * wins. That is how nine shots of a two-hander came back with both faces in
+ * them, and why the sync model crashed on the mirror scene.
+ *
+ * So the staging is removed rather than argued with. Clauses naming anyone but
+ * the speaker are dropped, as are clauses carrying a multi-subject cue. What
+ * remains is setting.
+ *
+ * Stripping this hard is safe because prose is not what holds the location
+ * together: every guided scene renders against a frozen approved backdrop
+ * image, and the scene prompt already instructs the model to preserve it. The
+ * words only have to avoid contradicting the picture.
+ */
+export function settingOnly(sceneDirection: string, otherNames: readonly string[]): string {
+  const names = otherNames.map((n) => n.toLowerCase()).filter(Boolean);
+  return sceneDirection
+    .split(/(?<=[.;])\s+/)
+    .filter((clause) => {
+      const lower = clause.toLowerCase();
+      if (names.some((name) => new RegExp(`\\b${name}\\b`).test(lower))) return false;
+      return !MULTI_SUBJECT_CUES.some((cue) => new RegExp(`\\b${cue}`).test(lower));
+    })
+    .join(" ")
+    .replace(/\s+/g, " ")
+    .trim()
+    // Dropping the clause after a semicolon leaves the semicolon behind.
+    .replace(/[;,]$/, ".");
+}
+
+/**
+ * What this shot is, and only then where it is.
+ *
+ * The constraint leads and the inherited setting trails, because when a prompt
+ * contradicts itself the model follows whichever half is more concrete — and
+ * authored staging is always more concrete than a framing note appended after
+ * it. The negatives are explicit for the same reason: "only the speaker" is a
+ * preference, "no second face, no mirror, no reflection" is a rule.
+ *
+ * The turn is deliberately slight. A full profile is the one thing that breaks
+ * every lip-sync model, so the eyeline sells the conversation without ever
+ * turning the mouth away from camera.
+ */
+export function shotVisualDirection(
+  sceneDirection: string,
+  shot: CoverageShot,
+  names: { speaker?: string | null; others?: readonly string[] } = {},
+): string {
+  if (shot.kind === "group") {
     return (
-      `${base} This shot frames only the speaking character, ${facing}, from the chest up. ` +
+      `${sceneDirection.trim()} This shot shows the characters together in the location. ` +
       "Same location, same lighting and same time of day as the rest of the scene."
     );
   }
-  if (shot.kind === "reaction") {
-    return (
-      `${base} This shot frames only the listening character, ${facing}, from the chest up, ` +
-      "reacting without speaking. Same location, same lighting and same time of day as the rest of the scene."
-    );
-  }
+  const who = names.speaker ? `only ${names.speaker}` : "only the speaking character";
+  const facing =
+    shot.eyeline === "center"
+      ? "facing the camera"
+      : `mostly front-facing, turned just slightly toward screen-${shot.eyeline}, ` +
+        "eyes toward the person they are speaking with just off-frame";
+  const setting = settingOnly(sceneDirection, names.others ?? []);
   return (
-    `${base} This shot shows the characters together in the location. ` +
-    "Same location, same lighting and same time of day as the rest of the scene."
+    `Single-subject shot. Frame ${who}: one person, one face, from the chest up, ` +
+    `${facing}. The face and mouth are fully visible and unobstructed. ` +
+    "Do not include any other person, any second face, any mirror or any reflection. " +
+    (shot.kind === "reaction" ? "They are listening, not speaking. " : "") +
+    (setting ? `Setting: ${setting} ` : "") +
+    "Same location, lighting, wardrobe and time of day as the rest of the scene."
   );
 }
