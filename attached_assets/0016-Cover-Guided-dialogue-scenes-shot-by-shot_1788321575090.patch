+import type { GuidedStoryScript } from "@workspace/db";
+
+/**
+ * Coverage: turning a written scene into the shots that cover it.
+ *
+ * A Guided scene is authored the way a scene is written — "these three people
+ * are in the café, and here is what they say." That is the right way to write
+ * it and the wrong way to shoot it. Lip sync works on ONE visible speaking
+ * face; a frame holding three faces gives the sync model no way to know whose
+ * mouth to move, which is why multi-role scenes are skipped today and get no
+ * sync at all.
+ *
+ * The fix is the one every film production uses: the scene declares its cast,
+ * and COVERAGE decides what is in each shot. Nothing here caps how many
+ * characters a scene may have. A scene with six people keeps all six — they
+ * appear together in the establishing shot and in reactions, and when one of
+ * them speaks we cut to them. The cast drives the coverage; the coverage never
+ * constrains the cast.
+ *
+ * WHY THIS SPLITS THE SCRIPT RATHER THAN INVENTING A "SHOT" CONCEPT
+ *
+ * Guided Story is 1 script scene ⇄ 1 storyboard scene, and that identity is
+ * load-bearing in a dozen places: positional scenes[index] pairing in the
+ * runner, immutable input fingerprints, per-scene funding, cast approval
+ * checkpoints. Adding a shots[] array inside a scene would mean touching every
+ * one of those, in exactly the machinery the repo's own notes warn must fail
+ * closed and must never strand paid work.
+ *
+ * Splitting the SCRIPT instead keeps that 1:1 intact. Downstream, nothing
+ * changes: the storyboard builder still maps one scene to one scene, the
+ * fingerprint still hashes a scene, funding still counts scenes. A shot simply
+ * IS a scene, which is also what makes it individually reviewable and
+ * individually payable — the right unit for the user to approve.
+ *
+ * WHY THE AUDIO SURVIVES
+ *
+ * Lines are never moved, merged, retimed or rewritten. A scene spanning
+ * 0-6000ms with lines at 0-2500 and 2500-6000 becomes two scenes covering
+ * 0-2500 and 2500-6000, carrying those same lines with those same timings.
+ * Narration is synthesised by flattening every line onto one global timeline,
+ * so the resulting WAV is byte-for-byte what it would have been. Narration
+ * reuse is preserved whenever transcript text, timing, line ownership and role
+ * voice bindings are unchanged — and this changes none of them. Splitting
+ * costs new keyframes; it never re-buys the voices.
+ */
+
+/** Which way a character looks, so cut shots read as a conversation. */
+export type Eyeline = "left" | "right" | "center";
+
+export interface CoverageShot {
+  /** Roles visible in this shot. Never capped; a group shot keeps everyone. */
+  roleIds: string[];
+  /** The role speaking, when exactly one does. null for group and reaction shots. */
+  speakerRoleId: string | null;
+  kind: "single" | "group" | "reaction";
+  /** Which way the visible subject faces. */
+  eyeline: Eyeline;
+  startMs: number;
+  endMs: number;
+  lineIds: string[];
+}
+
+/**
+ * A shot shorter than this is a flash frame — the cut registers before the
+ * face does, and a rapid exchange of one-word lines turns into a strobe. Short
+ * turns stay with the shot before them instead of earning their own.
+ */
+export const MIN_SHOT_MS = 1200;
+
+/**
+ * The script validator accepts 1-40 scenes, and a shot IS a scene here, so
+ * coverage has to live inside that same ceiling — otherwise the first rebuild
+ * after expansion would reject a script the user had already approved.
+ */
+export const MAX_SCRIPT_SCENES = 40;
+
+/**
+ * Eyelines are assigned by the role's position in the scene's cast and then
+ * held for the whole scene — the 180-degree rule, which is the difference
+ * between a conversation and two people staring the same way. The first role
+ * looks screen-right (toward the next person), the second looks screen-left
+ * (back at them). A third and beyond face camera: with more than two people
+ * there is no single axis to hold, and a centred look reads as addressing the
+ * group rather than contradicting the geometry.
+ */
+export function eyelineForRole(roleId: string, sceneRoleIds: readonly string[]): Eyeline {
+  const index = sceneRoleIds.indexOf(roleId);
+  if (index === 0) return "right";
+  if (index === 1) return "left";
+  return "center";
+}
+
+type ScriptScene = GuidedStoryScript["scenes"][number];
+type ScriptLine = ScriptScene["lines"][number];
+
+/** Turns adjacent lines by the same owner into one speaking turn. */
+function turnsOf(lines: readonly ScriptLine[]): Array<{
+  ownerRoleId: string | null;
+  lines: ScriptLine[];
+  startMs: number;
+  endMs: number;
+}> {
+  const turns: Array<{ ownerRoleId: string | null; lines: ScriptLine[]; startMs: number; endMs: number }> = [];
+  for (const line of [...lines].sort((a, b) => a.startMs - b.startMs)) {
+    const owner = line.kind === "dialogue" ? line.ownerRoleId : null;
+    const last = turns[turns.length - 1];
+    if (last && last.ownerRoleId === owner) {
+      last.lines.push(line);
+      last.endMs = Math.max(last.endMs, line.endMs);
+    } else {
+      turns.push({ ownerRoleId: owner, lines: [line], startMs: line.startMs, endMs: line.endMs });
+    }
+  }
+  return turns;
+}
+
+/**
+ * The shots that cover one scene.
+ *
+ * A scene earns coverage only when it would actually benefit: more than one
+ * visible role AND more than one speaking turn. A monologue in a crowd stays
+ * one shot — cutting away from a single continuous speaker gains nothing and
+ * costs a keyframe. A scene nobody speaks in stays one shot too.
+ */
+export function planSceneCoverage(scene: ScriptScene): CoverageShot[] {
+  const whole = (kind: CoverageShot["kind"], speakerRoleId: string | null): CoverageShot => ({
+    roleIds: [...scene.roleIds],
+    speakerRoleId,
+    kind,
+    eyeline:
+      speakerRoleId && scene.roleIds.length > 1
+        ? eyelineForRole(speakerRoleId, scene.roleIds)
+        : "center",
+    startMs: scene.startMs,
+    endMs: scene.endMs,
+    lineIds: scene.lines.map((l) => l.id),
+  });
+
+  const turns = turnsOf(scene.lines);
+  const speaking = turns.filter((t) => t.ownerRoleId !== null);
+  const speakers = new Set(speaking.map((t) => t.ownerRoleId!));
+
+  // Already coverable as-is: one visible role, or nobody speaking, or a single
+  // unbroken turn. Leave it exactly alone.
+  if (scene.roleIds.length <= 1 || speaking.length === 0) {
+    return [whole(speaking.length === 1 ? "single" : "group", speaking.length === 1 ? speaking[0]!.ownerRoleId : null)];
+  }
+  if (speakers.size === 1 && speaking.length === turns.length) {
+    return [whole("single", [...speakers][0]!)];
+  }
+
+  const shots: CoverageShot[] = [];
+  for (const turn of turns) {
+    const prev = shots[shots.length - 1];
+    const tooShort = turn.endMs - turn.startMs < MIN_SHOT_MS;
+    // A short turn, or narration between two lines, holds on the shot already
+    // running rather than flashing past. Narration over a face is normal
+    // grammar; narration with nothing established yet opens on the group.
+    if (prev && (tooShort || turn.ownerRoleId === null)) {
+      prev.endMs = turn.endMs;
+      prev.lineIds.push(...turn.lines.map((l) => l.id));
+      continue;
+    }
+    if (turn.ownerRoleId === null) {
+      shots.push({
+        roleIds: [...scene.roleIds],
+        speakerRoleId: null,
+        kind: "group",
+        eyeline: "center",
+        startMs: turn.startMs,
+        endMs: turn.endMs,
+        lineIds: turn.lines.map((l) => l.id),
+      });
+      continue;
+    }
+    // A speaking shot frames its speaker alone: exactly what the sync model
+    // needs, and the only shape that makes multi-person dialogue syncable at all.
+    shots.push({
+      roleIds: [turn.ownerRoleId],
+      speakerRoleId: turn.ownerRoleId,
+      kind: "single",
+      eyeline: eyelineForRole(turn.ownerRoleId, scene.roleIds),
+      startMs: turn.startMs,
+      endMs: turn.endMs,
+      lineIds: turn.lines.map((l) => l.id),
+    });
+  }
+
+  // Merging can collapse a scene back to one shot; then it was never coverage.
+  if (shots.length <= 1) return [whole(speakers.size === 1 ? "single" : "group", null)];
+
+  // The scene's own bounds are the contract with the timeline: coverage
+  // redistributes time inside a scene, it never changes when the scene starts
+  // or ends.
+  shots[0]!.startMs = scene.startMs;
+  shots[shots.length - 1]!.endMs = scene.endMs;
+  for (let i = 1; i < shots.length; i++) shots[i]!.startMs = shots[i - 1]!.endMs;
+  return shots;
+}
+
+/**
+ * Expand a whole script into coverage.
+ *
+ * Scene ids stay stable for scenes that did not split, so an unchanged scene
+ * keeps its preview, its approval and its paid work. A split scene's shots are
+ * suffixed from its original id, which keeps them traceable to the beat the
+ * user actually wrote.
+ */
+export function expandScriptCoverage(
+  script: GuidedStoryScript,
+  maxScenes = MAX_SCRIPT_SCENES,
+): GuidedStoryScript {
+  const scenes: GuidedStoryScript["scenes"] = [];
+  // The script validator accepts 1-40 scenes, and coverage multiplies them. The
+  // budget is spent greedily in script order: a scene that cannot afford its
+  // coverage keeps its authored form rather than pushing the script into a
+  // state the validator would reject on the next rebuild.
+  let total = script.scenes.length;
+  for (const scene of script.scenes) {
+    const shots = planSceneCoverage(scene);
+    if (total + (shots.length - 1) > maxScenes) {
+      scenes.push(scene);
+      continue;
+    }
+    total += shots.length - 1;
+    if (shots.length === 1 && shots[0]!.roleIds.length === scene.roleIds.length) {
+      scenes.push(scene);
+      continue;
+    }
+    const byId = new Map(scene.lines.map((l) => [l.id, l]));
+    shots.forEach((shot, i) => {
+      scenes.push({
+        ...scene,
+        id: shots.length === 1 ? scene.id : `${scene.id}-s${i + 1}`,
+        startMs: shot.startMs,
+        endMs: shot.endMs,
+        roleIds: shot.roleIds,
+        visualDirection: shotVisualDirection(scene.visualDirection, shot),
+        lines: shot.lineIds.map((id) => byId.get(id)!).filter(Boolean),
+      });
+    });
+  }
+  return { ...script, scenes };
+}
+
+/**
+ * The scene's own direction plus what this shot is. The location text is
+ * carried through unchanged so every shot cut together is the same place —
+ * without that, two shots of one conversation are two different rooms.
+ */
+export function shotVisualDirection(sceneDirection: string, shot: CoverageShot): string {
+  const base = sceneDirection.trim().replace(/\s+$/, "");
+  const facing =
+    shot.eyeline === "center"
+      ? "facing the camera"
+      : `turned slightly to face screen-${shot.eyeline}, looking at the person they are speaking with just off-frame`;
+  if (shot.kind === "single") {
+    return (
+      `${base} This shot frames only the speaking character, ${facing}, from the chest up. ` +
+      "Same location, same lighting and same time of day as the rest of the scene."
+    );
+  }
+  if (shot.kind === "reaction") {
+    return (
+      `${base} This shot frames only the listening character, ${facing}, from the chest up, ` +
+      "reacting without speaking. Same location, same lighting and same time of day as the rest of the scene."
+    );
+  }
+  return (
+    `${base} This shot shows the characters together in the location. ` +
+    "Same location, same lighting and same time of day as the rest of the scene."
+  );
+}
