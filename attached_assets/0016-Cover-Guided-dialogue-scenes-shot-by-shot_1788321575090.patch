+import { describe, it, expect } from "vitest";
+import type { GuidedStoryScript } from "@workspace/db";
+import {
+  planSceneCoverage,
+  expandScriptCoverage,
+  eyelineForRole,
+  shotVisualDirection,
+  MIN_SHOT_MS,
+} from "./guidedCoverage";
+
+type Scene = GuidedStoryScript["scenes"][number];
+
+const line = (id: string, owner: string | null, startMs: number, endMs: number) => ({
+  id,
+  ownerRoleId: owner,
+  kind: (owner ? "dialogue" : "narration") as "dialogue" | "narration",
+  text: `${id} text`,
+  startMs,
+  endMs,
+});
+
+const scene = (over: Partial<Scene> = {}): Scene => ({
+  id: "sc1",
+  startMs: 0,
+  endMs: 8000,
+  visualDirection: "A busy hospital corridor, afternoon light.",
+  roleIds: ["asha", "ravi"],
+  lines: [
+    line("l1", "asha", 0, 2500),
+    line("l2", "ravi", 2500, 5200),
+    line("l3", "asha", 5200, 8000),
+  ],
+  ...over,
+});
+
+const script = (scenes: Scene[]): GuidedStoryScript => ({
+  version: 1,
+  title: "t",
+  logline: "l",
+  runtimeSeconds: 30,
+  roles: [
+    { id: "asha", name: "Asha", description: "" },
+    { id: "ravi", name: "Ravi", description: "" },
+    { id: "meera", name: "Meera", description: "" },
+  ],
+  scenes,
+  warnings: [],
+});
+
+describe("planSceneCoverage", () => {
+  it("gives every speaking turn a shot framed on exactly one speaker", () => {
+    // This is the whole point: lip sync works on ONE visible speaking face.
+    // A frame with two faces gives the model no way to know whose mouth to
+    // move, which is why these scenes get skipped entirely today.
+    const shots = planSceneCoverage(scene());
+
+    expect(shots).toHaveLength(3);
+    for (const shot of shots) {
+      expect(shot.roleIds).toHaveLength(1);
+      expect(shot.roleIds[0]).toBe(shot.speakerRoleId);
+    }
+    expect(shots.map((s) => s.speakerRoleId)).toEqual(["asha", "ravi", "asha"]);
+  });
+
+  it("never caps how many characters a scene may hold", () => {
+    // The cast drives the coverage; the coverage must never constrain the
+    // cast. Six people in the café stay six people in the café.
+    const cast = ["a", "b", "c", "d", "e", "f"];
+    const shots = planSceneCoverage(
+      scene({ roleIds: cast, lines: [line("l1", null, 0, 8000)] }),
+    );
+
+    expect(shots).toHaveLength(1);
+    expect(shots[0]!.roleIds).toEqual(cast);
+  });
+
+  it("keeps the whole cast in shots where nobody is singled out", () => {
+    const shots = planSceneCoverage(
+      scene({
+        roleIds: ["asha", "ravi", "meera"],
+        lines: [line("l1", null, 0, 3000), line("l2", "asha", 3000, 5500), line("l3", "ravi", 5500, 8000)],
+      }),
+    );
+    const group = shots.find((s) => s.kind === "group");
+    expect(group?.roleIds).toEqual(["asha", "ravi", "meera"]);
+    expect(shots.filter((s) => s.kind === "single").every((s) => s.roleIds.length === 1)).toBe(true);
+  });
+
+  it("leaves a scene alone when coverage would gain nothing", () => {
+    // One visible role, or nobody speaking, or one unbroken turn. Cutting away
+    // from a single continuous speaker buys nothing and costs a keyframe.
+    expect(planSceneCoverage(scene({ roleIds: ["asha"] }))).toHaveLength(1);
+    expect(planSceneCoverage(scene({ lines: [line("n", null, 0, 8000)] }))).toHaveLength(1);
+    expect(
+      planSceneCoverage(
+        scene({ lines: [line("l1", "asha", 0, 4000), line("l2", "asha", 4000, 8000)] }),
+      ),
+    ).toHaveLength(1);
+  });
+
+  it("holds on the running shot rather than flashing a one-word line", () => {
+    // A shot shorter than the minimum registers as a cut before it registers
+    // as a face. A rapid exchange of short lines would strobe.
+    const shots = planSceneCoverage(
+      scene({
+        lines: [
+          line("l1", "asha", 0, 3000),
+          line("l2", "ravi", 3000, 3400),
+          line("l3", "asha", 3400, 8000),
+        ],
+      }),
+    );
+
+    expect(shots.every((s) => s.endMs - s.startMs >= MIN_SHOT_MS)).toBe(true);
+    expect(shots.length).toBeLessThan(3);
+  });
+
+  it("merges adjacent lines by the same speaker into one turn", () => {
+    const shots = planSceneCoverage(
+      scene({
+        lines: [
+          line("l1", "asha", 0, 2000),
+          line("l2", "asha", 2000, 4000),
+          line("l3", "ravi", 4000, 8000),
+        ],
+      }),
+    );
+    expect(shots).toHaveLength(2);
+    expect(shots[0]!.lineIds).toEqual(["l1", "l2"]);
+  });
+
+  it("tiles the scene's own span exactly, leaving no gap or overlap", () => {
+    // Coverage redistributes time INSIDE a scene. It must never change when
+    // the scene starts or ends, or every downstream timeline shifts.
+    const s = scene();
+    const shots = planSceneCoverage(s);
+
+    expect(shots[0]!.startMs).toBe(s.startMs);
+    expect(shots[shots.length - 1]!.endMs).toBe(s.endMs);
+    for (let i = 1; i < shots.length; i++) {
+      expect(shots[i]!.startMs).toBe(shots[i - 1]!.endMs);
+    }
+  });
+});
+
+describe("eyelineForRole", () => {
+  it("puts two speakers on opposite eyelines so they read as talking to each other", () => {
+    // The 180-degree rule. Both looking the same way turns a conversation into
+    // two monologues, and no amount of sync quality rescues that.
+    expect(eyelineForRole("asha", ["asha", "ravi"])).toBe("right");
+    expect(eyelineForRole("ravi", ["asha", "ravi"])).toBe("left");
+  });
+
+  it("holds a role's eyeline across every shot in the scene", () => {
+    const shots = planSceneCoverage(scene());
+    const asha = shots.filter((s) => s.speakerRoleId === "asha");
+    expect(asha).toHaveLength(2);
+    expect(new Set(asha.map((s) => s.eyeline)).size).toBe(1);
+  });
+
+  it("faces camera beyond two, where there is no single axis to hold", () => {
+    expect(eyelineForRole("meera", ["asha", "ravi", "meera"])).toBe("center");
+  });
+});
+
+describe("expandScriptCoverage", () => {
+  it("preserves every line's identity, ownership and timing exactly", () => {
+    // Narration is reused whenever transcript text, timing, line ownership and
+    // voice bindings are unchanged. Splitting must change NONE of them, or the
+    // user re-buys audio they already paid for.
+    const before = script([scene()]);
+    const after = expandScriptCoverage(before);
+
+    const flat = (s: GuidedStoryScript) =>
+      s.scenes.flatMap((sc) => sc.lines).map((l) => [l.id, l.ownerRoleId, l.startMs, l.endMs, l.text]);
+    expect(flat(after)).toEqual(flat(before));
+  });
+
+  it("keeps the script's overall timeline continuous", () => {
+    const after = expandScriptCoverage(script([scene(), scene({ id: "sc2", startMs: 8000, endMs: 16000,
+      lines: [line("m1", "asha", 8000, 11000), line("m2", "ravi", 11000, 16000)] })]));
+
+    expect(after.scenes[0]!.startMs).toBe(0);
+    expect(after.scenes.at(-1)!.endMs).toBe(16000);
+    for (let i = 1; i < after.scenes.length; i++) {
+      expect(after.scenes[i]!.startMs).toBe(after.scenes[i - 1]!.endMs);
+    }
+  });
+
+  it("leaves an unsplit scene byte-identical so its paid work survives", () => {
+    // Scene ids are the reuse boundary for previews, approvals and funding. A
+    // scene that did not need coverage must come out the same object it went in.
+    const solo = scene({ id: "solo", roleIds: ["asha"] });
+    const after = expandScriptCoverage(script([solo]));
+    expect(after.scenes).toHaveLength(1);
+    expect(after.scenes[0]).toEqual(solo);
+  });
+
+  it("derives split ids from the beat the user wrote", () => {
+    const after = expandScriptCoverage(script([scene()]));
+    expect(after.scenes.map((s) => s.id)).toEqual(["sc1-s1", "sc1-s2", "sc1-s3"]);
+  });
+
+  it("makes every speaking shot eligible for lip sync", () => {
+    // The existing rule: exactly one visible role, and it owns every dialogue
+    // line in the scene. Before coverage this scene was skipped entirely.
+    const after = expandScriptCoverage(script([scene()]));
+
+    const eligible = after.scenes.filter((sc) => {
+      const owners = new Set(
+        sc.lines.filter((l) => l.kind === "dialogue" && l.ownerRoleId).map((l) => l.ownerRoleId!),
+      );
+      return owners.size === 1 && sc.roleIds.length === 1 && sc.roleIds[0] === [...owners][0];
+    });
+    expect(eligible).toHaveLength(3);
+  });
+
+  it("is idempotent, so a rebuild does not split a split", () => {
+    const once = expandScriptCoverage(script([scene()]));
+    expect(expandScriptCoverage(once)).toEqual(once);
+  });
+
+  it("stays inside the validator's scene ceiling", () => {
+    // A shot IS a scene here, and the validator accepts 1-40. Expanding past
+    // that would reject, on the next rebuild, a script the user had already
+    // approved — the worst possible time to fail.
+    const many = Array.from({ length: 20 }, (_, i) =>
+      scene({
+        id: `sc${i}`,
+        startMs: i * 8000,
+        endMs: (i + 1) * 8000,
+        lines: [
+          line(`a${i}`, "asha", i * 8000, i * 8000 + 2500),
+          line(`b${i}`, "ravi", i * 8000 + 2500, i * 8000 + 5200),
+          line(`c${i}`, "asha", i * 8000 + 5200, (i + 1) * 8000),
+        ],
+      }),
+    );
+    const after = expandScriptCoverage(script(many));
+
+    expect(after.scenes.length).toBeLessThanOrEqual(40);
+    expect(after.scenes.length).toBeGreaterThan(20);
+    // Whatever the budget allows, the timeline still tiles without a gap.
+    expect(after.scenes[0]!.startMs).toBe(0);
+    expect(after.scenes.at(-1)!.endMs).toBe(160000);
+    for (let i = 1; i < after.scenes.length; i++) {
+      expect(after.scenes[i]!.startMs).toBe(after.scenes[i - 1]!.endMs);
+    }
+  });
+
+  it("spends the budget rather than giving up when it cannot cover everything", () => {
+    // Partial coverage beats none: the scenes that fit are covered, and the
+    // rest keep exactly the form the writer gave them.
+    const after = expandScriptCoverage(script([scene(), scene({ id: "sc2", startMs: 8000, endMs: 16000,
+      lines: [line("m1", "asha", 8000, 11000), line("m2", "ravi", 11000, 16000)] })]), 4);
+
+    expect(after.scenes.length).toBeLessThanOrEqual(4);
+    expect(after.scenes.length).toBeGreaterThan(2);
+  });
+});
+
+describe("shotVisualDirection", () => {
+  it("carries the location into every shot so cuts stay in one room", () => {
+    // Two shots of one conversation generated independently become two
+    // different corridors. The scene's own direction has to travel with each.
+    const shots = planSceneCoverage(scene());
+    for (const shot of shots) {
+      const text = shotVisualDirection("A busy hospital corridor, afternoon light.", shot);
+      expect(text).toContain("A busy hospital corridor");
+      expect(text).toMatch(/same location, same lighting and same time of day/i);
+    }
+  });
+
+  it("states the eyeline in terms a camera department would use", () => {
+    const shots = planSceneCoverage(scene());
+    expect(shotVisualDirection("X.", shots[0]!)).toMatch(/screen-right/);
+    expect(shotVisualDirection("X.", shots[1]!)).toMatch(/screen-left/);
+  });
+
+  it("frames a speaking shot on one character", () => {
+    const shots = planSceneCoverage(scene());
+    expect(shotVisualDirection("X.", shots[0]!)).toMatch(/only the speaking character/i);
+  });
+});
