+    expect(blocked.body.code).toBe("compliance_blocked");
+    expect(reviewer.calls).toBe(0);
+
+    // 3. An edit that ADDS a new violation is refused.
+    const worse = await request(api)
+      .patch(`/api/ai/video-jobs/${job.id}/storyboard`)
+      .send({ scenes: [{ id: "s1", text: "We guarantee clear skin. Flat 20% off today!" }] });
+    expect(worse.status, JSON.stringify(worse.body)).toBe(400);
+    expect(worse.body.error, JSON.stringify(worse.body)).toMatch(/NMC/);
+    expect(worse.body.code).toBe("compliance_blocked");
+
+    // 4. Fixing it saves; what remains is review-level only.
+    const fixed = await request(api)
+      .patch(`/api/ai/video-jobs/${job.id}/storyboard`)
+      .send({ scenes: [{ id: "s1", text: "Over 500 patients asked us about acne. Results vary." }] });
+    expect(fixed.status, JSON.stringify(fixed.body)).toBe(200);
+
+    // 5. Approve without acknowledgement → AI review runs, then asks for the tick.
+    const needsAck = await request(api).post(`/api/ai/video-jobs/${job.id}/storyboard/approve`).send({});
+    expect(needsAck.status).toBe(400);
+    expect(needsAck.body.code).toBe("compliance_review_required");
+    expect(reviewer.calls).toBe(1);
