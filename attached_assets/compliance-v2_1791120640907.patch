+/**
+ * Live NMC / ICAI check for a post being edited (debounced, negative list
+ * only — publishing runs the full check, AI review included, server-side).
+ * Renders nothing for brands that aren't a regulated profession.
+ */
+export function PostComplianceCheck({
+  brandKitId,
+  text,
+}: {
+  brandKitId: number | null | undefined;
+  text: string;
+}) {
+  const check = useCheckComplianceText();
+  const [report, setReport] = useState<ComplianceReport | null>(null);
+  useEffect(() => {
+    if (!text.trim()) {
+      setReport(null);
+      return;
+    }
+    const handle = window.setTimeout(() => {
+      check.mutate(
+        { data: { text: text.slice(0, 20000), brandKitId: brandKitId ?? null, field: "caption" } },
+        { onSuccess: (r) => setReport(r ?? null), onError: () => setReport(null) },
+      );
+    }, 600);
+    return () => window.clearTimeout(handle);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [text, brandKitId]);
+  if (!report) return null;
+  return (
+    <div className="space-y-1.5" data-testid="post-compliance-check">
+      <p className="text-xs font-medium text-muted-foreground">
+        {report.profession === "medical" ? "NMC" : "ICAI"} check
+        {report.blocking > 0 ? " — this post can't be published until fixed" : ""}
+      </p>
+      <ComplianceFindingsList report={report} emptyLabel="No compliance issues found." />
+    </div>
+  );
+}
