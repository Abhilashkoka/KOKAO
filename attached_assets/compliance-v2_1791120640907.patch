+    // 1. Read: the review panel gets live findings.
+    const read = await request(api).get(`/api/ai/video-jobs/${job.id}`);
+    expect(read.status).toBe(200);
+    expect(read.body.compliance.report.blocking).toBeGreaterThan(0);
