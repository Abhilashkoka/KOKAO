+    items: items.slice(0, MAX_ITEMS).map((item) => ({
+      location: item.location,
+      kind: item.field,
+      text: item.text.slice(0, MAX_ITEM_CHARS),
+    })),
+  });
+  return { system, user };
+}
+
+/** Validate the model's answer against the pack and the supplied items. */
