+export interface CoverCopy {
+  /**
+     * Small lead-in set above the headline ("My", "The art of"). Optional.
+     * @maxLength 24
+     */
+  kicker?: string;
+  /**
+     * The hero words. One to three words reads best.
+     * @minLength 1
+     * @maxLength 28
+     */
+  headline: string;
+  /**
+     * Quiet payoff line under the headline. Optional.
+     * @maxLength 48
+     */
+  subline?: string;
+}
+
+/**
+ * Re-typeset an earlier cover: the `basePath` and `subjectPath` it returned. Skips cropping, grading and matting, so it is free.
+ * @nullable
+ */
+export type CoverReuse = {
+  basePath: string;
+  /** @nullable */
+  subjectPath?: string | null;
+} | null;
+
+/**
+ * behind: the headline passes behind the subject. over: all type on top.
+ */
+export type CoverRequestLayout = typeof CoverRequestLayout[keyof typeof CoverRequestLayout];
+
+
+export const CoverRequestLayout = {
+  behind: 'behind',
+  over: 'over',
+} as const;
+
+export type CoverRequestPosition = typeof CoverRequestPosition[keyof typeof CoverRequestPosition];
+
+
+export const CoverRequestPosition = {
+  top: 'top',
+  bottom: 'bottom',
+} as const;
+
+/**
