+/**
+ * Cover Studio: photo → editorial magazine-style cover.
+ *
+ * Funding follows the editor's Cutout: only a FRESH cover with the headline
+ * behind the subject reaches an image provider (the subject matte), so only
+ * that reserves one image unit — and it is released, not charged, when no
+ * matte could be produced and the cover fell back to text-over. Re-typesets
+ * (`reuse`) and text-over covers are local sharp work and cost nothing.
+ *
+ * All inputs are validated and tenant-owned paths loaded BEFORE funding is
+ * reserved, so a bad path is a 400, never a spent credit.
+ */
+router.post("/ai/cover", async (req: Request, res: Response) => {
+  const parsed = CreateCoverBody.safeParse(req.body);
+  if (!parsed.success) {
+    res.status(400).json({ error: "Invalid input" });
+    return;
+  }
+  const tenant = await loadTenant(req.tenantId);
+  if (!tenant) {
+    res.status(401).json({ error: "Unauthorized" });
+    return;
+  }
+
+  const copy = normalizeCoverCopy(parsed.data.copy);
+  if (!copy.headline) {
+    res.status(400).json({ error: "Add a headline for the cover." });
+    return;
+  }
+  const options = normalizeCoverOptions(parsed.data);
+  const reuseReq = parsed.data.reuse ?? null;
+
+  let source: Buffer | undefined;
+  let reuse: Parameters<typeof buildCover>[0]["reuse"];
+  try {
+    if (reuseReq) {
+      const base = await loadSourceImage(reuseReq.basePath, req.tenantId);
+      const subject = reuseReq.subjectPath
+        ? await loadSourceImage(reuseReq.subjectPath, req.tenantId)
+        : null;
+      reuse = {
+        base: base.buffer,
+        basePath: reuseReq.basePath,
+        subject: subject?.buffer ?? null,
+        subjectPath: reuseReq.subjectPath ?? null,
+      };
+    } else if (parsed.data.imagePath) {
+      source = (await loadSourceImage(parsed.data.imagePath, req.tenantId)).buffer;
+    } else {
+      res.status(400).json({ error: "Choose a photo for the cover." });
+      return;
+    }
+  } catch (error) {
+    if (error instanceof ReferenceImageError) {
+      res.status(400).json({ error: error.message.replace("Reference image", "Image") });
+      return;
+    }
+    req.log.error({ err: error }, "Failed to load image for a cover");
+    res.status(500).json({ error: "Failed to load the image" });
+    return;
+  }
+
+  const billable = !reuse && options.layout === "behind";
+  let funding: Awaited<ReturnType<typeof reserveFunding>> = null;
+  if (billable) {
+    const limits = await getPlanLimits(tenant.plan);
+    const usage = await getUsage(req.tenantId);
+    funding = await reserveFunding(req.tenantId, limits.images, usage.images, "image");
+    if (!funding) {
+      res.status(402).json({
+        error: await outOfFundsMessage(
+          req.tenantId,
+          "image",
+          "Monthly image quota reached and no image credits left. Upgrade your plan, buy a credit pack, or use the text-over layout (free).",
+        ),
+      });
+      return;
+    }
+  }
+
+  try {
+    const outcome = await buildCover({
+      tenantId: req.tenantId,
+      tenant,
+      copy,
+      options,
+      source,
+      reuse,
+    });
+
+    let spendPaise: number | null = null;
+    let units = 0;
+    if (funding && outcome.matteMeta) {
+      spendPaise = await settleFunding(req, funding, "image", {
+        ...outcome.matteMeta,
+        ...(await contentRef(req.tenantId, parsed.data.contentId)),
+      });
+      units = 1;
+    } else if (funding) {
+      await releaseFunding(req, funding, "image");
+    }
+
+    res.json({
+      imagePath: outcome.imagePath,
+      b64Json: outcome.b64Json,
+      basePath: outcome.basePath,
+      subjectPath: outcome.subjectPath,
+      layout: outcome.layout,
+      notice: outcome.notice,
+      layers: outcome.layerDoc,
+      units,
+      ...(spendPaise !== null ? { spendPaise } : {}),
+    });
+  } catch (error) {
+    if (funding) await releaseFunding(req, funding, "image");
+    if (error instanceof CoverInputError) {
+      res.status(400).json({ error: error.message });
+      return;
+    }
+    req.log.error({ err: error }, "Cover composition failed");
+    res.status(500).json({ error: "Failed to create the cover" });
+  }
+});
+
+/** Cover text for a topic. A cheap text call, never billed; always answers. */
+router.post("/ai/cover-copy", async (req: Request, res: Response) => {
+  const parsed = DraftCoverCopyBody.safeParse(req.body);
+  if (!parsed.success) {
+    res.status(400).json({ error: "Invalid input" });
+    return;
+  }
+  const tenant = await loadTenant(req.tenantId);
+  if (!tenant) {
+    res.status(401).json({ error: "Unauthorized" });
+    return;
+  }
+  const { copy, source } = await draftCoverCopy({
+    tenantId: req.tenantId,
+    tenant,
+    topic: parsed.data.topic,
+    brandKitId: parsed.data.brandKitId ?? null,
+  });
+  res.json({ ...copy, source });
+});
+
