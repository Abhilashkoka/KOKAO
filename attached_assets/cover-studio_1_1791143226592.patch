@@ -0,0 +1,87 @@
+import { describe, it, expect, beforeEach, vi } from "vitest";
+import sharp from "sharp";
+
+const fetchMock = vi.fn();
+vi.mock("../imageGen/types", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("../imageGen/types")>();
+  return { ...actual, imageGenFetch: (...args: unknown[]) => fetchMock(...args) };
+});
+
+const keyMock = vi.fn();
+vi.mock("../videoGen", () => ({
+  getVideoGenProviderDef: () => ({ id: "replicate", envKey: "REPLICATE_API_TOKEN" }),
+  resolveVideoGenApiKey: (...args: unknown[]) => keyMock(...args),
+}));
+
+const imagesEdit = vi.fn();
+vi.mock("@workspace/integrations-openai-ai-server", () => ({
+  openai: { images: { edit: (...a: unknown[]) => imagesEdit(...a) } },
+  toFile: async (buf: Buffer) => buf,
+}));
+
+import { extractSubjectMatte } from "./matte";
+
+const SOURCE = await sharp({ create: { width: 300, height: 400, channels: 3, background: "#555" } })
+  .png()
+  .toBuffer();
+
+/** A cutout at a DIFFERENT size than the source: the matte must be rescaled back. */
+const CUTOUT = await sharp(
+  Buffer.from(
+    `<svg xmlns="http://www.w3.org/2000/svg" width="150" height="200"><circle cx="75" cy="100" r="50" fill="#fff"/></svg>`,
+  ),
+)
+  .png()
+  .toBuffer();
+
+function json(body: unknown) {
+  return { ok: true, status: 200, json: async () => body } as unknown as Response;
+}
+
+beforeEach(() => {
+  fetchMock.mockReset();
+  keyMock.mockReset();
+  imagesEdit.mockReset();
+  delete process.env.REPLICATE_API_TOKEN;
+});
+
+describe("extractSubjectMatte", () => {
+  it("resolves the model's latest version, runs it, and returns a source-sized matte", async () => {
+    keyMock.mockResolvedValue("r8_test");
+    fetchMock
+      .mockResolvedValueOnce(json({ latest_version: { id: "v123" } }))
+      .mockResolvedValueOnce(json({ status: "succeeded", output: "https://replicate.delivery/out.png" }))
+      .mockResolvedValueOnce({ ok: true, status: 200, arrayBuffer: async () => CUTOUT } as unknown as Response);
+
+    const result = await extractSubjectMatte(SOURCE);
+
+    expect(result?.provider).toBe("replicate");
+    const create = fetchMock.mock.calls[1]!;
+    expect(create[0]).toBe("https://api.replicate.com/v1/predictions");
+    expect(JSON.parse((create[1] as RequestInit).body as string).version).toBe("v123");
+    const meta = await sharp(result!.matte).metadata();
+    expect([meta.width, meta.height, meta.channels]).toEqual([300, 400, 1]);
+    // Centre is subject, corner is background.
+    const raw = await sharp(result!.matte).extractChannel(0).raw().toBuffer();
+    expect(raw[200 * 300 + 150]).toBeGreaterThan(200);
+    expect(raw[5 * 300 + 5]).toBeLessThan(20);
+  });
