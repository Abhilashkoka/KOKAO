index 00000000..26c6a99a
--- /dev/null
+++ b/artifacts/api-server/src/lib/cover/grade.ts
@@ -0,0 +1,105 @@
+import sharp from "sharp";
+
+/**
+ * The "Editorial Muted" grade: what makes a grid of separately generated
+ * images read as one magazine.
+ *
+ * Generated images come back saturated, contrasty and plastic-smooth — the
+ * three tells of AI imagery. The grade answers each one deterministically,
+ * with no model call:
+ *
+ *  - saturation pulled to ~80%, so neutrals go grey-brown instead of candy;
+ *  - blacks lifted and whites pulled in (a faded film curve), so nothing
+ *    clips and skin keeps detail;
+ *  - a slight warm bias in the mid-tones, which flatters skin under the
+ *    desaturation;
+ *  - fine monochrome grain, which hides the waxy over-smooth skin texture.
+ *
+ * The same numbers drive the ffmpeg filter below, so a reel and a cover from
+ * the same brand sit in the same colour world.
+ */
+
+export const EDITORIAL_GRADE = {
+  saturation: 0.8,
+  /** out = in * contrast + lift (per channel, 0..255). */
+  contrast: 0.9,
+  lift: [13, 11, 9] as const,
+  /** Warm the reds a touch, cool nothing — blues just lose a little. */
+  recomb: [
+    [1.03, 0.0, -0.01],
+    [0.0, 1.0, 0.0],
+    [-0.01, 0.0, 0.97],
+  ] as [[number, number, number], [number, number, number], [number, number, number]],
+  /** Grain amplitude in 0..255 around mid-grey, applied with soft-light. */
+  grain: 26,
+} as const;
+
+/**
+ * ffmpeg equivalent for video clips, appended after scale/crop in
+ * normalizeVideo. eq() handles contrast/saturation, colorchannelmixer the
+ * warm bias, and temporal noise the grain (temporal so it shimmers like film
+ * rather than sitting on the frame like dirt on a lens).
+ */
+export const EDITORIAL_VIDEO_FILTER =
+  "eq=contrast=0.92:saturation=0.8:brightness=0.01," +
+  "colorchannelmixer=rr=1.03:rb=-0.01:bb=0.97:br=-0.01," +
+  "noise=alls=5:allf=t";
+
+/** Small deterministic PRNG (mulberry32) so the same image grades identically twice. */
+function mulberry32(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+/** A mid-grey noise plate. Rendered at half size and upscaled so grains are ~2px, like 400-speed film at feed size. */
+export async function grainPlate(width: number, height: number, amplitude: number, seed = 7): Promise<Buffer> {
+  const w = Math.max(1, Math.ceil(width / 2));
+  const h = Math.max(1, Math.ceil(height / 2));
+  const rand = mulberry32(seed);
+  const raw = Buffer.alloc(w * h);
+  for (let i = 0; i < raw.length; i += 1) {
+    // Sum of two uniforms ≈ triangular distribution: softer than uniform noise.
+    const n = (rand() + rand() - 1) * amplitude;
+    raw[i] = Math.max(0, Math.min(255, Math.round(128 + n)));
+  }
+  return sharp(raw, { raw: { width: w, height: h, channels: 1 } })
+    .resize(width, height, { kernel: "cubic" })
+    .toColourspace("srgb")
+    .png()
+    .toBuffer();
+}
+
+/**
+ * Apply the editorial grade to an opaque image. Returns a PNG the same size.
+ * Alpha, if any, is flattened — callers grade the full frame BEFORE cutting
+ * the subject out, so subject and backdrop share one grade by construction.
+ */
+export async function applyEditorialGrade(input: Buffer): Promise<Buffer> {
+  const g = EDITORIAL_GRADE;
+  const meta = await sharp(input).metadata();
+  const width = meta.width ?? 0;
+  const height = meta.height ?? 0;
+  if (!width || !height) throw new Error("Cannot grade an image with unknown dimensions");
+
+  const graded = await sharp(input)
+    .flatten({ background: "#808080" })
+    .removeAlpha()
+    .modulate({ saturation: g.saturation })
+    .linear([g.contrast, g.contrast, g.contrast], [...g.lift])
+    .recomb(g.recomb)
+    .png()
+    .toBuffer();
+
+  const grain = await grainPlate(width, height, g.grain);
+  return sharp(graded)
+    .composite([{ input: grain, blend: "soft-light" }])
+    .removeAlpha()
+    .png()
+    .toBuffer();
+}
diff --git a/artifacts/api-server/src/lib/cover/index.ts b/artifacts/api-server/src/lib/cover/index.ts
new file mode 100644
index 00000000..63683acb
--- /dev/null
+++ b/artifacts/api-server/src/lib/cover/index.ts
@@ -0,0 +1,139 @@
+import sharp from "sharp";
+import type { Tenant } from "@workspace/db";
+import { uploadBufferToStorage } from "../storageUpload";
+import { applyMadeWithWatermark } from "../watermark";
+import { getPlan } from "../plans";
+import { isFeatureEnabled } from "../featureFlags";
+import type { UsageMeta } from "../usage";
+import { prepareCoverCanvas, typesetCover, type PreparedCanvas } from "./compose";
+import { extractSubjectMatte } from "./matte";
+import {
+  COVER_HEIGHT,
+  COVER_WIDTH,
+  type CoverCopy,
+  type CoverDocLayer,
+  type CoverLayerDoc,
+  type CoverLayout,
+  type CoverOptions,
+} from "./types";
+
+export * from "./types";
+export { draftCoverCopy, splitTopicIntoCopy } from "./copy";
+export { EDITORIAL_VIDEO_FILTER } from "./grade";
+
+export class CoverInputError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "CoverInputError";
+  }
+}
+
+export interface CoverOutcome {
+  imagePath: string;
+  b64Json: string;
+  /** Clean graded canvas (no type, no scrim): send back as reuse.basePath to re-typeset for free. */
+  basePath: string;
+  /** Registered full-canvas cutout, or null when the cover is text-over. */
+  subjectPath: string | null;
+  layout: CoverLayout;
+  notice: string | null;
+  layerDoc: CoverLayerDoc;
+  /** Present only when a billable matte ran; the route settles on it. */
+  matteMeta: Omit<UsageMeta, "funding"> | null;
+}
+
+/** Re-typeset inputs must be exactly what an earlier cover stored. */
+async function assertReusable(base: Buffer, subject: Buffer | null): Promise<void> {
+  const b = await sharp(base).metadata();
+  if (b.width !== COVER_WIDTH || b.height !== COVER_HEIGHT) {
+    throw new CoverInputError("That base image is not a cover canvas. Start from the photo instead.");
+  }
+  if (subject) {
+    const s = await sharp(subject).metadata();
+    if (s.width !== COVER_WIDTH || s.height !== COVER_HEIGHT || !s.hasAlpha) {
+      throw new CoverInputError("That subject layer does not belong to this cover. Start from the photo instead.");
+    }
+  }
+}
+
+export async function buildCover(input: {
+  tenantId: number;
+  tenant: Tenant;
+  copy: CoverCopy;
+  options: CoverOptions;
+  /** Fresh cover from a photo… */
+  source?: Buffer;
+  /** …or a re-typeset of an earlier cover's stored canvas (no matte, no charge). */
+  reuse?: { base: Buffer; basePath: string; subject: Buffer | null; subjectPath: string | null };
+}): Promise<CoverOutcome> {
+  if (!input.copy.headline) throw new CoverInputError("Add a headline for the cover.");
+
+  let canvas: PreparedCanvas;
+  let basePath: string | null = null;
+  let subjectPath: string | null = null;
+  let matteMeta: CoverOutcome["matteMeta"] = null;
+
+  if (input.reuse) {
+    await assertReusable(input.reuse.base, input.reuse.subject);
+    canvas = { base: input.reuse.base, subject: input.reuse.subject };
+    basePath = input.reuse.basePath;
+    subjectPath = input.reuse.subject ? input.reuse.subjectPath : null;
+  } else if (input.source) {
+    // Only spend on a matte when the layout can use one.
+    const matte = input.options.layout === "behind" ? await extractSubjectMatte(input.source) : null;
+    matteMeta = matte?.meta ?? null;
+    canvas = await prepareCoverCanvas({ source: input.source, matte: matte?.matte ?? null, options: input.options });
+  } else {
+    throw new CoverInputError("Choose a photo for the cover.");
+  }
+
+  const set = await typesetCover({ canvas, copy: input.copy, options: input.options });
+
+  const wantWatermark =
+    (await getPlan(input.tenant.plan).catch(() => null))?.watermark === true &&
+    (await isFeatureEnabled("freeWatermark").catch(() => true));
+  const flat = wantWatermark ? await applyMadeWithWatermark(set.flat) : set.flat;
+
+  const editorBaseIsCanvas = set.base === canvas.base;
+  const typeBlocks = set.blocks.filter((b) => b.id !== "subject");
+  const [uploadedBase, uploadedEditorBase, uploadedSubject, flatPath, ...blockPaths] = await Promise.all([
+    basePath ? Promise.resolve(basePath) : uploadBufferToStorage(input.tenantId, canvas.base, "image/png"),
+    editorBaseIsCanvas ? Promise.resolve(null) : uploadBufferToStorage(input.tenantId, set.base, "image/png"),
+    canvas.subject && !subjectPath
+      ? uploadBufferToStorage(input.tenantId, canvas.subject, "image/png")
+      : Promise.resolve(subjectPath),
+    uploadBufferToStorage(input.tenantId, flat, "image/png"),
+    ...typeBlocks.map((b) => uploadBufferToStorage(input.tenantId, b.buffer, "image/png")),
+  ]);
+
+  const pathFor = new Map(typeBlocks.map((b, i) => [b, blockPaths[i]!]));
+  const layers: CoverDocLayer[] = [];
+  for (const b of set.blocks) {
+    const objectPath = b.id === "subject" ? uploadedSubject : pathFor.get(b);
+    if (!objectPath) continue;
+    layers.push({
+      id: `cover_${b.id}`,
+      type: "image",
+      objectPath,
+      x: b.x,
+      y: b.y,
+      width: b.width,
+      height: b.height,
+      rotation: 0,
+      scaleX: 1,
+      scaleY: 1,
+      name: b.name,
+    });
+  }
+
+  return {
+    imagePath: flatPath,
+    b64Json: flat.toString("base64"),
+    basePath: uploadedBase,
+    subjectPath: uploadedSubject ?? null,
+    layout: set.layout,
+    notice: set.notice,
+    layerDoc: { version: 1, basePath: uploadedEditorBase ?? uploadedBase, layers },
+    matteMeta,
+  };
+}
