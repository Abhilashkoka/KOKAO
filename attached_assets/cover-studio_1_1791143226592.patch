+  it("falls back to the built-in provider when Replicate fails", async () => {
+    keyMock.mockResolvedValue("r8_test");
+    fetchMock.mockResolvedValue({ ok: false, status: 500, text: async () => "boom", json: async () => ({}) });
+    imagesEdit.mockResolvedValue({ data: [{ b64_json: CUTOUT.toString("base64") }] });
+
+    const result = await extractSubjectMatte(SOURCE);
+
+    expect(result?.provider).toBe("openai");
+    const meta = await sharp(result!.matte).metadata();
+    expect([meta.width, meta.height]).toEqual([300, 400]);
