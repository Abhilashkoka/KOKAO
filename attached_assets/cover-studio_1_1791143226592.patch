+
+  it("returns null instead of throwing when nothing can produce a matte", async () => {
+    keyMock.mockResolvedValue(null);
+    imagesEdit.mockRejectedValue(new Error("moderation_blocked"));
+    await expect(extractSubjectMatte(SOURCE)).resolves.toBeNull();
+  });
+});
