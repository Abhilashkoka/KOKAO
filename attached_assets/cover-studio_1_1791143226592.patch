+import { describe, it, expect, beforeEach, vi } from "vitest";
+import { render, screen, cleanup, fireEvent } from "@testing-library/react";
+
+const toastSpy = vi.hoisted(() => vi.fn());
+vi.mock("@/hooks/use-toast", () => ({ useToast: () => ({ toast: toastSpy }) }));
+
+const createCoverMutate = vi.hoisted(() => vi.fn());
+const draftMutate = vi.hoisted(() => vi.fn());
+
+vi.mock("@workspace/api-client-react", async () => {
+  const { createApiClientMock, idleMutation } = await import("../test/apiClientMock");
+  return createApiClientMock({
+    useCreateCover: () => ({ ...idleMutation(), mutate: createCoverMutate }),
+    useDraftCoverCopy: () => ({ ...idleMutation(), mutate: draftMutate }),
+  });
+});
+
+import { CoverStudioDialog } from "./cover-studio-dialog";
+
+const RESULT = {
+  imagePath: "/objects/1/uploads/cover.png",
+  b64Json: "Y292ZXI=",
+  basePath: "/objects/1/uploads/base.png",
+  subjectPath: "/objects/1/uploads/subject.png",
+  layout: "behind",
+  notice: null,
+  layers: { version: 1, basePath: "/objects/1/uploads/base.png", layers: [] },
+  units: 1,
+};
+
+function renderDialog(onApply = vi.fn()) {
+  render(
+    <CoverStudioDialog
+      open
+      onOpenChange={() => {}}
+      imagePath="/objects/1/uploads/photo.png"
+      topic="my morning skin routine"
+      onApply={onApply}
+    />,
+  );
+  return onApply;
+}
+
+beforeEach(() => {
+  cleanup();
+  toastSpy.mockClear();
+  createCoverMutate.mockReset();
+  draftMutate.mockReset();
+  draftMutate.mockImplementation((_vars, opts) =>
+    opts?.onSuccess?.({ kicker: "My", headline: "Skin Routine", subline: "that works", source: "ai" }),
+  );
+});
+
+describe("CoverStudioDialog", () => {
+  it("drafts cover text from the brief when it opens", () => {
+    renderDialog();
+    expect(draftMutate).toHaveBeenCalledWith(
+      { data: { topic: "my morning skin routine", brandKitId: undefined } },
+      expect.anything(),
+    );
+    expect((screen.getByTestId("input-cover-headline") as HTMLInputElement).value).toBe("Skin Routine");
+  });
+
+  it("pays for the first behind cover, then re-typesets on the stored canvas for free", () => {
+    createCoverMutate.mockImplementation((_vars, opts) => opts?.onSuccess?.(RESULT));
+    renderDialog();
+
+    expect(screen.getByTestId("button-cover-create").textContent).toContain("1 credit");
+    fireEvent.click(screen.getByTestId("button-cover-create"));
+    const first = createCoverMutate.mock.calls[0]![0].data;
+    expect(first.imagePath).toBe("/objects/1/uploads/photo.png");
+    expect(first.reuse).toBeUndefined();
+    expect(first.layout).toBe("behind");
+
+    fireEvent.change(screen.getByTestId("input-cover-headline"), { target: { value: "New Words" } });
+    expect(screen.getByTestId("button-cover-create").textContent).not.toContain("credit");
+    fireEvent.click(screen.getByTestId("button-cover-create"));
+    const second = createCoverMutate.mock.calls[1]![0].data;
+    expect(second.reuse).toEqual({ basePath: RESULT.basePath, subjectPath: RESULT.subjectPath });
+    expect(second.copy.headline).toBe("New Words");
+  });
+
+  it("hands the cover and its layer document to the studio", () => {
+    createCoverMutate.mockImplementation((_vars, opts) => opts?.onSuccess?.(RESULT));
+    const onApply = renderDialog();
+    fireEvent.click(screen.getByTestId("button-cover-create"));
+    fireEvent.click(screen.getByTestId("button-cover-apply"));
+    expect(onApply).toHaveBeenCalledWith({
+      imagePath: RESULT.imagePath,
+      b64: RESULT.b64Json,
+      layers: RESULT.layers,
+    });
+  });
+
+  it("shows the server's notice when the cover had to change layout", () => {
+    createCoverMutate.mockImplementation((_vars, opts) =>
+      opts?.onSuccess?.({ ...RESULT, layout: "over", subjectPath: null, notice: "Couldn't separate the person" }),
+    );
+    renderDialog();
+    fireEvent.click(screen.getByTestId("button-cover-create"));
+    expect(toastSpy).toHaveBeenCalledWith(expect.objectContaining({ description: "Couldn't separate the person" }));
+  });
+});
