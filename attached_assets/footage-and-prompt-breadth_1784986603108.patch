+    return UNCONDITIONAL_LICENCES.some((ok) => code === ok || code.startsWith(`${ok}-`));
+  }
+  // No machine-readable code: accept only an unambiguous human-readable one.
+  const short = extmetadata?.LicenseShortName?.value?.toLowerCase() ?? "";
