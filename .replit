modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "codegen-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "spec-lint"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "codegen-drift"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "TMP=$(mktemp -d) && trap 'rm -rf \"$TMP\"' EXIT && mkdir -p \"$TMP/lib/api-client-react/src\" \"$TMP/lib/api-zod/src\" && cp lib/api-client-react/src/custom-fetch.ts \"$TMP/lib/api-client-react/src/\" && DRIFT_OUT_ROOT=\"$TMP\" pnpm --filter @workspace/api-spec exec orval --config ./orval.drift.config.ts && diff -r lib/api-client-react/src/generated \"$TMP/lib/api-client-react/src/generated\" && diff -r lib/api-zod/src/generated \"$TMP/lib/api-zod/src/generated\""

[[workflows.workflow]]
name = "spec-lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-spec run lint:spec"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SUPERADMIN_EMAILS = "abhilash.koka1@gmail.com"

[userenv.development]

[objectStorage]
defaultBucketID = "replit-objstore-5de15f91-0c92-4897-8b45-5045a61ac615"
